---
import '../styles/global.css';
import contenido from '../../data/contenido.json';
const hubs = contenido.filter(function (r) { return r.tipo === 'hub'; });
interface Props { titulo: string; descripcion: string; }
const { titulo, descripcion } = Astro.props;
const url = 'https://paracumpleanos.com' + Astro.url.pathname;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={url} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <header class="cabecera">
    <a href="/" class="logo">ParaCumpleanos 🎂</a>
    <nav class="nav-hubs">
      {hubs.map(function (h) { return <a href={'/' + h.slug + '/'}>{h.emoji} {h.destinatario}</a>; })}
    </nav>
  </header>
  <div class="contenedor">
    <aside class="sidebar">
      <h2>Categorías</h2>
      <ul>
        {hubs.map(function (h) { return <li><a href={'/' + h.slug + '/'}>{h.emoji} {h.destinatario}</a></li>; })}
      </ul>
    </aside>
    <main class="contenido">
      <slot />
    </main>
  </div>
  <footer class="pie">
    <p>ParaCumpleanos — felicitaciones originales de cumpleaños.</p>
    <nav>
      <a href="/sobre-nosotros/">Sobre nosotros</a>
      <a href="/privacidad/">Privacidad</a>
      <a href="/terminos-de-uso/">Términos de uso</a>
    </nav>
  </footer>
  <script is:inline>
    document.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.btn-copiar') : null;
      if (!btn) return;
      var texto = btn.getAttribute('data-text') || '';
      function ok() {
        var original = btn.textContent;
        btn.textContent = '¡Copiado! ✓';
        setTimeout(function () { btn.textContent = original; }, 2000);
      }
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = texto;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); ok(); } catch (err) {}
        document.body.removeChild(ta);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(texto).then(ok, fallback);
      } else { fallback(); }
    });
  </script>
</body>
</html>
