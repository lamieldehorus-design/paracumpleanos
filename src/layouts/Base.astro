---
import '../styles/global.css';
import { GRUPOS, hubs, hubsPorGrupo, nombreHub, todosMensajes } from '../lib/contenido.ts';
import { GUIAS_EDITORIALES } from '../data/guias.ts';
import { PAISES_HITOS } from '../data/hitos-historicos.ts';
import { TOP_FOOTER_GSC } from '../lib/gsc-estrategia.ts';
interface Props {
  titulo: string;
  descripcion: string;
  jsonld?: any[];
  grupoActual?: string;
  slugActual?: string;
  noindex?: boolean;
  esPortal?: boolean;
  relPrev?: string;
  relNext?: string;
}
const {
  titulo,
  descripcion,
  jsonld = [],
  grupoActual = 'destinatarios',
  slugActual = '',
  noindex = false,
  esPortal = false,
  relPrev,
  relNext
} = Astro.props;
const url = 'https://paracumpleanos.com' + Astro.url.pathname;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="yandex-verification" content="3c0fa054dfa66068" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={url} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#9f1239" />
  {relPrev ? <link rel="prev" href={'https://paracumpleanos.com' + relPrev} /> : null}
  {relNext ? <link rel="next" href={'https://paracumpleanos.com' + relNext} /> : null}
  <link rel="alternate" type="application/rss+xml" title="ParaCumpleanos RSS" href="https://paracumpleanos.com/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.statcounter.com" crossorigin />
  <link rel="preconnect" href="https://c.statcounter.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:image" content="https://paracumpleanos.com/logopc.png" />
  <meta property="og:image:alt" content="ParaCumpleanos — Dedicatorias, cartas y tarjetas personalizadas" />
  <meta property="og:site_name" content="ParaCumpleanos" />
  <meta property="og:locale" content="es_AR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content="https://paracumpleanos.com/logopc.png" />
  {jsonld.map(function (d) { return <script type="application/ld+json" set:html={JSON.stringify(d)} />; })}
  <!-- Google Consent Mode v2 (RGPD Europa / EEE / Reino Unido / Suiza) antes de GTM y AdSense -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      region: [
        'AT', 'BE', 'BG', 'HR', 'CY', 'CZ', 'DK', 'EE', 'FI', 'FR',
        'DE', 'GR', 'HU', 'IS', 'IE', 'IT', 'LV', 'LI', 'LT', 'LU',
        'MT', 'NL', 'NO', 'PL', 'PT', 'RO', 'SK', 'SI', 'ES', 'SE',
        'GB', 'CH'
      ],
      wait_for_update: 500
    });
    gtag('consent', 'default', {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
      functionality_storage: 'granted',
      security_storage: 'granted'
    });
    gtag('set', 'ads_data_redaction', true);
    try {
      var pcConsentRaw = localStorage.getItem('pc_consentimiento_v1');
      if (pcConsentRaw) {
        var pcConsentSaved = JSON.parse(pcConsentRaw);
        var pubEstado = pcConsentSaved && pcConsentSaved.publicidad ? 'granted' : 'denied';
        var anaEstado = pcConsentSaved && pcConsentSaved.analitica ? 'granted' : 'denied';
        gtag('consent', 'update', {
          ad_storage: pubEstado,
          ad_user_data: pubEstado,
          ad_personalization: pubEstado,
          analytics_storage: anaEstado,
          functionality_storage: 'granted',
          security_storage: 'granted'
        });
      }
    } catch (_) {}
  </script>
  <!-- Google Tag Manager (contenedores principal y analitica) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    gtag('js', new Date());
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-NKFBN6X5"></script>
  <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-WKC77GT5"></script>
  <!-- Google AdSense -->
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7933111729537978" crossorigin="anonymous"></script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NKFBN6X5" height="0" width="0" style="display:none;visibility:hidden"></iframe><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WKC77GT5" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- Statcounter temprano con respaldo keepalive sin duplicacion -->
  <script is:inline type="text/javascript">
  var sc_project=13334162;
  var sc_invisible=1;
  var sc_security="3e891d7b";
  var sc_download_type="7z|aac|avi|csv|doc|docx|exe|flv|gif|gz|ics|jpeg|jpg|mov|mp3|mp4|mpeg|mpg|pdf|png|ppt|pptx|rar|tar|torrent|txt|wma|wmv|xls|xlsx|xml|zip";
  (function () {
    if (window.__pcScInicializado) return;
    window.__pcScInicializado = true;
    window.__pcScFallbackEnviado = false;
    function scYaRegistro() {
      return !!(window._statcounter && window._statcounter._security_codes && window._statcounter._security_codes[13334162]);
    }
    window.__pcScEnviarFallback = function () {
      if (window.__pcScFallbackEnviado || scYaRegistro()) return;
      window.__pcScFallbackEnviado = true;
      var pixelUrl = 'https://c.statcounter.com/13334162/0/3e891d7b/1/';
      try {
        if (typeof fetch === 'function') {
          fetch(pixelUrl, {
            mode: 'no-cors',
            keepalive: true,
            credentials: 'omit',
            referrerPolicy: 'no-referrer-when-downgrade'
          }).catch(function () {});
          return;
        }
      } catch (_) {}
      try {
        var img = new Image();
        img.referrerPolicy = 'no-referrer-when-downgrade';
        img.src = pixelUrl;
      } catch (_) {}
    };
    window.addEventListener('pagehide', function () { window.__pcScEnviarFallback(); });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') window.__pcScEnviarFallback();
    });
  })();
  </script>
  <script is:inline type="text/javascript" src="https://www.statcounter.com/counter/counter.js" async onerror="window.__pcScEnviarFallback && window.__pcScEnviarFallback()"></script>
  <noscript><div class="statcounter"><a title="Web Analytics Made Easy - Statcounter" href="https://statcounter.com/" target="_blank" rel="noopener"><img class="statcounter" src="https://c.statcounter.com/13334162/0/3e891d7b/1/" alt="Web Analytics Made Easy - Statcounter" referrerpolicy="no-referrer-when-downgrade" /></a></div></noscript>
  <header class="cabecera">
    <div class="cabecera-inner">
      <a href="/" class="logo" aria-label="ParaCumpleanos — Inicio">
        <img
          src="/logopc.png"
          alt="ParaCumpleanos"
          class="logo-img"
          width="210"
          height="48"
          decoding="async"
          fetchpriority="high"
          onerror="this.style.display='none';var f=this.nextElementSibling;if(f)f.style.display='inline-flex';"
        />
        <span class="logo-fallback" style="display:none">ParaCumpleanos 🎂</span>
      </a>
      <nav class="nav-principal" aria-label="Navegación principal">
        <a href="/calendario/">Calendario</a>
        <a href="/hitos-historicos/">Hitos históricos</a>
        <a href="/condolencias/">Condolencias</a>
        <a href="/herramientas/">Herramientas</a>
        <a href="/horoscopo/">Horóscopo</a>
        <a href="/guias/">Guías</a>
      </nav>
      <a class="nav-cta" href="/categorias/">{hubs.length} categorías</a>
    </div>
  </header>

  {esPortal ? (
    <div class="contenedor-portal">
      <main class="contenido contenido-portal">
        <slot />
      </main>
    </div>
  ) : (
    <div class="contenedor">
      <aside class="sidebar" aria-label="Todas las categorías">
        <h2>Categorías ({hubs.length})</h2>
        {GRUPOS.map(function (g) {
          const lista = hubsPorGrupo.get(g.id) || [];
          if (!lista.length) return null;
          return (
            <details class="sidebar-grupo" open={g.id === grupoActual}>
              <summary>
                <span>{g.emoji} {g.nombre}</span>
                <span class="sidebar-count">{lista.length}</span>
              </summary>
              <ul>
                {lista.map(function (h) {
                  return (
                    <li>
                      <a href={'/' + h.slug + '/'} aria-current={h.slug === slugActual ? 'page' : undefined}>
                        {nombreHub(h)}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
        <details class="sidebar-grupo sidebar-grupo--hitos" open={grupoActual === 'hitos_calendario'}>
          <summary>
            <span>🌍 Hitos históricos y calendario</span>
            <span class="sidebar-count">{PAISES_HITOS.length}</span>
          </summary>
          <ul class="sidebar-hitos-accesos">
            <li><a href="/hitos-historicos/" aria-current={slugActual === 'hitos-historicos' ? 'page' : undefined}>Atlas completo ({PAISES_HITOS.length} países)</a></li>
            <li><a href="/calendario/" aria-current={slugActual === 'calendario' ? 'page' : undefined}>Calendario sin año (366 días)</a></li>
            <li><a href="/herramientas/#banderines-imprimir">Banderines A4 para imprimir</a></li>
          </ul>
          <div class="sidebar-paises-buscador">
            <label class="sr-only" for="sidebar-filtro-paises">Buscar entre los {PAISES_HITOS.length} países</label>
            <input
              type="search"
              id="sidebar-filtro-paises"
              class="sidebar-paises-filtro"
              placeholder={`Buscar entre ${PAISES_HITOS.length} países…`}
              autocomplete="off"
            />
          </div>
          <ul class="sidebar-paises-lista" id="sidebar-paises-lista" aria-label={`Los ${PAISES_HITOS.length} países del mundo`}>
            {PAISES_HITOS.map(function (pais) {
              return (
                <li data-pais={pais.nombre.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}>
                  <a
                    href={'/hitos-historicos/' + pais.slug + '/'}
                    aria-current={slugActual === 'hito:' + pais.slug ? 'page' : undefined}
                  >
                    {pais.bandera} {pais.nombre}
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      </aside>
      <main class="contenido">
        <slot />
      </main>
    </div>
  )}

  <footer class="pie">
    <div class="pie-marca">
      <a href="/" class="pie-logo" aria-label="ParaCumpleanos — Volver al inicio">
        <img
          src="/logopc.png"
          alt="ParaCumpleanos"
          class="pie-logo-img"
          width="180"
          height="44"
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none';var f=this.nextElementSibling;if(f)f.style.display='inline-flex';"
        />
        <span class="logo-fallback" style="display:none">ParaCumpleanos 🎂</span>
      </a>
    </div>
    <p>ParaCumpleanos — {hubs.length} colecciones, {PAISES_HITOS.length} hitos históricos mundiales, {GUIAS_EDITORIALES.length} guías prácticas y {todosMensajes.length.toLocaleString('es-AR')} textos originales en español.</p>
    <div class="pie-gsc-strip" aria-label="Colecciones más buscadas">
      <p class="pie-gsc-titulo">Colecciones más buscadas:</p>
      <div class="pie-gsc-links">
        {TOP_FOOTER_GSC.map(function (item) {
          return <a href={'/' + item.slug + '/'}>{item.label}</a>;
        })}
      </div>
    </div>
    <nav aria-label="Páginas institucionales">
      <a href="/">Inicio</a>
      <a href="/calendario/">Calendario sin año</a>
      <a href="/hitos-historicos/">Hitos históricos</a>
      <a href="/condolencias/">Condolencias</a>
      <a href="/herramientas/">Herramientas</a>
      <a href="/horoscopo/">Horóscopo</a>
      <a href="/categorias/#meses">Meses</a>
      <a href="/categorias/#fechas_especiales">Fechas especiales</a>
      <a href="/categorias/">Categorías</a>
      <a href="/motivaciones/">Motivaciones</a>
      <a href="/guias/">Guías</a>
      <a href="/sobre-nosotros/">Sobre nosotros</a>
      <a href="/contacto/">Contacto</a>
      <a href="/privacidad/">Privacidad</a>
      <a href="/terminos-de-uso/">Términos de uso</a>
      <button type="button" class="pie-link-btn" data-abrir-cmp>Preferencias de cookies</button>
    </nav>
  </footer>

  <button
    type="button"
    id="pc-favoritas-barra"
    class="pc-favoritas-barra"
    aria-label="Abrir dedicatorias guardadas"
    hidden
  >
    <span aria-hidden="true">♥</span>
    <span>Guardadas</span>
    <span id="pc-favoritas-count" class="pc-favoritas-count">0</span>
  </button>

  <dialog id="pc-favoritas-dialog" class="pc-favoritas-dialog" aria-labelledby="pc-fav-titulo">
    <div class="pc-fav-head">
      <div>
        <h2 id="pc-fav-titulo">Tus dedicatorias guardadas</h2>
        <p class="pc-fav-sub">Quedan guardadas en este navegador para comparar, copiar o bajar como tarjeta PNG.</p>
      </div>
      <button type="button" id="pc-fav-cerrar" class="pc-fav-cerrar" aria-label="Cerrar guardadas">×</button>
    </div>
    <div id="pc-fav-lista" class="pc-fav-lista"></div>
    <div class="pc-fav-pie">
      <button type="button" id="pc-fav-vaciar" class="btn-leer-mas">Vaciar lista</button>
      <button type="button" id="pc-fav-listo" class="btn btn-copiar">Seguir explorando</button>
    </div>
  </dialog>

  <aside
    id="pc-cmp-banner"
    class="pc-cmp-banner"
    role="region"
    aria-label="Aviso de privacidad y cookies RGPD"
    hidden
  >
    <div class="pc-cmp-banner-inner">
      <div class="pc-cmp-texto">
        <p class="pc-cmp-titulo">Tu privacidad en ParaCumpleanos (RGPD)</p>
        <p class="pc-cmp-desc">
          Usamos almacenamiento esencial para el funcionamiento del sitio y, solo si lo autorizás, cookies de analítica (Google Tag Manager) y publicidad (Google AdSense) para mantener gratis el catálogo.
          <a href="/privacidad/">Ver política de privacidad</a>.
        </p>
      </div>
      <div class="pc-cmp-acciones">
        <button type="button" id="pc-cmp-rechazar" class="pc-cmp-btn pc-cmp-btn--sec">Rechazar opcionales</button>
        <button type="button" id="pc-cmp-configurar" class="pc-cmp-btn pc-cmp-btn--sec">Configurar</button>
        <button type="button" id="pc-cmp-aceptar" class="pc-cmp-btn pc-cmp-btn--pri">Aceptar todo</button>
      </div>
    </div>
  </aside>

  <dialog id="pc-cmp-dialog" class="pc-cmp-dialog" aria-labelledby="pc-cmp-titulo">
    <div class="pc-fav-head">
      <div>
        <h2 id="pc-cmp-titulo">Preferencias de privacidad y cookies (RGPD)</h2>
        <p class="pc-fav-sub">Elegí qué categorías querés permitir en este navegador. Tu elección actualiza Google Consent Mode v2 al instante.</p>
      </div>
      <button type="button" id="pc-cmp-cerrar" class="pc-fav-cerrar" aria-label="Cerrar preferencias de privacidad">×</button>
    </div>
    <div class="pc-cmp-cuerpo">
      <label class="pc-cmp-opcion pc-cmp-opcion--fija">
        <span class="pc-cmp-opcion-info">
          <strong>Almacenamiento esencial (siempre activo)</strong>
          <span>Necesario para recordar tus dedicatorias guardadas, tu elección de privacidad y el correcto funcionamiento de las herramientas.</span>
        </span>
        <input type="checkbox" checked disabled aria-label="Almacenamiento esencial siempre activo" />
      </label>
      <label class="pc-cmp-opcion" for="pc-cmp-chk-analitica">
        <span class="pc-cmp-opcion-info">
          <strong>Analítica y medición (Google Tag Manager)</strong>
          <span>Nos ayuda a entender qué categorías son más útiles mediante métricas agregadas (<code>analytics_storage</code>).</span>
        </span>
        <input type="checkbox" id="pc-cmp-chk-analitica" />
      </label>
      <label class="pc-cmp-opcion" for="pc-cmp-chk-publicidad">
        <span class="pc-cmp-opcion-info">
          <strong>Publicidad personalizada (Google AdSense)</strong>
          <span>Permite mostrar anuncios relevantes para sostener el acceso gratuito al sitio (<code>ad_storage</code>, <code>ad_user_data</code>, <code>ad_personalization</code>).</span>
        </span>
        <input type="checkbox" id="pc-cmp-chk-publicidad" />
      </label>
      <p class="pc-cmp-legal-nota">
        Consultá el detalle completo de cookies, proveedores y contacto en nuestra <a href="/privacidad/">Política de privacidad</a>.
      </p>
    </div>
    <div class="pc-cmp-modal-pie">
      <button type="button" id="pc-cmp-modal-rechazar" class="pc-cmp-btn pc-cmp-btn--sec">Solo esenciales</button>
      <button type="button" id="pc-cmp-modal-guardar" class="pc-cmp-btn pc-cmp-btn--sec">Guardar preferencias</button>
      <button type="button" id="pc-cmp-modal-aceptar" class="pc-cmp-btn pc-cmp-btn--pri">Aceptar todo</button>
    </div>
  </dialog>

  <div id="pc-toast" class="pc-toast" role="status" aria-live="polite" hidden></div>

  <script is:inline>
    (function () {
      var toastTimer = null;
      window.pcMostrarToast = function (mensaje, enlaceHref, enlaceTexto) {
        var el = document.getElementById('pc-toast');
        if (!el) return;
        el.innerHTML = '';
        var p = document.createElement('span');
        p.textContent = mensaje;
        el.appendChild(p);
        if (enlaceHref && enlaceTexto) {
          var a = document.createElement('a');
          a.href = enlaceHref;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = enlaceTexto;
          el.appendChild(a);
        }
        var btnClose = document.createElement('button');
        btnClose.type = 'button';
        btnClose.className = 'pc-toast-cerrar';
        btnClose.setAttribute('aria-label', 'Cerrar aviso');
        btnClose.textContent = '×';
        btnClose.addEventListener('click', function () { el.hidden = true; });
        el.appendChild(btnClose);
        el.hidden = false;
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { el.hidden = true; }, 6500);
      };

      function copiarAlPortapapeles(texto) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(texto).then(function () { return true; }, function () { return false; });
        }
        try {
          var ta = document.createElement('textarea');
          ta.value = texto;
          document.body.appendChild(ta);
          ta.select();
          var res = document.execCommand('copy');
          document.body.removeChild(ta);
          return Promise.resolve(res);
        } catch (_) {
          return Promise.resolve(false);
        }
      }

      function generarCanvasTarjeta(opts) {
        var mostrarTitulo = Boolean(opts.mostrarTitulo);
        var tituloCard = mostrarTitulo ? String(opts.title || '').trim() : '';
        var textoCard = opts.body || '';
        var emojiCard = opts.emoji || '🎂';
        var subtitulo = opts.subtitulo || '';
        var visualRef = opts.visualEl || document.querySelector('.tarjeta-visual');
        var fuente = opts.fuente || (visualRef && visualRef.getAttribute('data-fuente')) || 'editorial';
        var formato = opts.formato || (visualRef && visualRef.getAttribute('data-formato')) || 'cuadrada';

        var cInicio = (visualRef && visualRef.getAttribute('data-tema-inicio')) || '#fdf2f8';
        var cMedio = (visualRef && visualRef.getAttribute('data-tema-medio')) || '#fff7ed';
        var cFin = (visualRef && visualRef.getAttribute('data-tema-fin')) || '#e0f2fe';
        var cBorde = (visualRef && visualRef.getAttribute('data-tema-borde')) || '#e91e8c';
        var cAcento = (visualRef && visualRef.getAttribute('data-tema-acento')) || '#be185d';

        if (!subtitulo && visualRef) {
          subtitulo = visualRef.getAttribute('data-subtitulo') || '';
        }

        var canvas = document.createElement('canvas');
        var W = 1080;
        var minH = formato === 'story' ? 1920 : 1080;
        var ctx = canvas.getContext('2d');
        if (!ctx) return null;

        function wrapLineas(text, maxW, fontSpec) {
          ctx.font = fontSpec;
          var words = String(text || '').split(/\s+/).filter(Boolean);
          var lines = [];
          var line = '';
          for (var i = 0; i < words.length; i++) {
            var test = line ? line + ' ' + words[i] : words[i];
            if (ctx.measureText(test).width > maxW && line) {
              lines.push(line);
              line = words[i];
            } else {
              line = test;
            }
          }
          if (line) lines.push(line);
          return lines;
        }

        function prepararBloques(text, maxW, fontSpec, firmaSpec) {
          var paras = String(text || '').split(/\n{2,}/).map(function (p) { return p.trim(); }).filter(Boolean);
          return paras.map(function (p) {
            var esFirma = /^—\s/.test(p);
            var sublineas = p.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
            var wrapped = [];
            for (var k = 0; k < sublineas.length; k++) {
              var wLines = wrapLineas(sublineas[k], maxW, esFirma ? firmaSpec : fontSpec);
              for (var j = 0; j < wLines.length; j++) wrapped.push(wLines[j]);
            }
            return { esFirma: esFirma, lineas: wrapped };
          });
        }

        var fotoImg = window.__pcTarjetaFotoImg && window.__pcTarjetaFotoImg.naturalWidth ? window.__pcTarjetaFotoImg : null;
        var famTit = fuente === 'moderna' ? 'system-ui, -apple-system, sans-serif' : 'Georgia, serif';
        var famCuerpo = fuente === 'calida' ? 'Georgia, serif' : 'system-ui, -apple-system, sans-serif';
        var titleFont = (fuente === 'calida' ? 'italic bold ' : 'bold ') + (formato === 'story' ? '48px ' : '44px ') + famTit;
        var tLines = tituloCard ? wrapLineas(tituloCard, 860, titleFont) : [];
        var titleLineH = formato === 'story' ? 62 : 56;
        var baseTopEmoji = formato === 'story' ? 210 : 145;
        var baseTopSub = subtitulo ? baseTopEmoji + 68 : baseTopEmoji;
        var fotoSize = formato === 'story' ? 250 : 210;
        var fotoTop = (subtitulo ? baseTopSub + 46 : baseTopEmoji + 46);
        var baseTopTitle = fotoImg
          ? fotoTop + fotoSize + 64
          : (subtitulo ? baseTopSub + 66 : baseTopEmoji + 85);
        var yStartBody = tLines.length
          ? baseTopTitle + tLines.length * titleLineH + 30
          : (fotoImg ? fotoTop + fotoSize + 68 : (subtitulo ? baseTopSub + 76 : baseTopEmoji + 92));
        var bottomReserved = formato === 'story' ? 180 : 150;

        var candidatos = formato === 'story' ? [36, 32, 28] : [32, 28, 25];
        var elegida = null;
        for (var c = 0; c < candidatos.length; c++) {
          var fs = candidatos[c];
          var lh = Math.round(fs * 1.46);
          var gap = Math.round(fs * 0.62);
          var bFont = fs + 'px ' + famCuerpo;
          var fFont = 'italic 600 ' + fs + 'px Georgia, serif';
          var blks = prepararBloques(textoCard, 860, bFont, fFont);
          var hCuerpo = 0;
          for (var bi = 0; bi < blks.length; bi++) {
            hCuerpo += blks[bi].lineas.length * lh;
            if (bi < blks.length - 1) hCuerpo += gap;
          }
          if (yStartBody + hCuerpo + bottomReserved <= minH || c === candidatos.length - 1) {
            elegida = { fs: fs, lh: lh, gap: gap, bFont: bFont, fFont: fFont, blks: blks, hCuerpo: hCuerpo };
            if (yStartBody + hCuerpo + bottomReserved <= minH) break;
          }
        }

        var H = Math.max(minH, Math.ceil(yStartBody + elegida.hCuerpo + bottomReserved));
        canvas.width = W;
        canvas.height = H;

        var grad = ctx.createLinearGradient(0, 0, W, H);
        grad.addColorStop(0, cInicio);
        grad.addColorStop(0.55, cMedio);
        grad.addColorStop(1, cFin);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);

        ctx.strokeStyle = cBorde;
        ctx.lineWidth = 10;
        ctx.strokeRect(48, 48, W - 96, H - 96);

        ctx.fillStyle = cAcento;
        ctx.textAlign = 'center';
        ctx.font = (formato === 'story' ? '82px ' : '68px ') + 'system-ui, sans-serif';
        ctx.fillText(emojiCard, W / 2, baseTopEmoji);

        if (subtitulo) {
          ctx.font = 'bold 26px system-ui, -apple-system, sans-serif';
          ctx.fillText(subtitulo.toUpperCase(), W / 2, baseTopSub);
        }

        if (fotoImg) {
          var fx = Math.round((W - fotoSize) / 2);
          var fy = Math.round(fotoTop);
          var rad = 24;
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(fx + rad, fy);
          ctx.lineTo(fx + fotoSize - rad, fy);
          ctx.quadraticCurveTo(fx + fotoSize, fy, fx + fotoSize, fy + rad);
          ctx.lineTo(fx + fotoSize, fy + fotoSize - rad);
          ctx.quadraticCurveTo(fx + fotoSize, fy + fotoSize, fx + fotoSize - rad, fy + fotoSize);
          ctx.lineTo(fx + rad, fy + fotoSize);
          ctx.quadraticCurveTo(fx, fy + fotoSize, fx, fy + fotoSize - rad);
          ctx.lineTo(fx, fy + rad);
          ctx.quadraticCurveTo(fx, fy, fx + rad, fy);
          ctx.closePath();
          ctx.clip();
          var iw = fotoImg.naturalWidth;
          var ih = fotoImg.naturalHeight;
          var escFoto = Math.max(fotoSize / iw, fotoSize / ih);
          var dw = iw * escFoto;
          var dh = ih * escFoto;
          ctx.drawImage(fotoImg, fx + (fotoSize - dw) / 2, fy + (fotoSize - dh) / 2, dw, dh);
          ctx.restore();

          ctx.save();
          ctx.strokeStyle = cBorde;
          ctx.lineWidth = 6;
          ctx.beginPath();
          ctx.moveTo(fx + rad, fy);
          ctx.lineTo(fx + fotoSize - rad, fy);
          ctx.quadraticCurveTo(fx + fotoSize, fy, fx + fotoSize, fy + rad);
          ctx.lineTo(fx + fotoSize, fy + fotoSize - rad);
          ctx.quadraticCurveTo(fx + fotoSize, fy + fotoSize, fx + fotoSize - rad, fy + fotoSize);
          ctx.lineTo(fx + rad, fy + fotoSize);
          ctx.quadraticCurveTo(fx, fy + fotoSize, fx, fy + fotoSize - rad);
          ctx.lineTo(fx, fy + rad);
          ctx.quadraticCurveTo(fx, fy, fx + rad, fy);
          ctx.closePath();
          ctx.stroke();
          ctx.restore();
        }

        var y = yStartBody;
        if (tLines.length) {
          ctx.font = titleFont;
          ctx.fillStyle = cAcento;
          var yt = baseTopTitle;
          for (var i = 0; i < tLines.length; i++) {
            ctx.fillText(tLines[i], W / 2, yt);
            yt += titleLineH;
          }
          y = yt + 30;
        }
        if (y + elegida.hCuerpo + bottomReserved < H) {
          var extra = (H - (y + elegida.hCuerpo + bottomReserved)) * 0.42;
          y += Math.round(Math.max(0, extra));
        }

        for (var bi = 0; bi < elegida.blks.length; bi++) {
          var blk = elegida.blks[bi];
          ctx.font = blk.esFirma ? elegida.fFont : elegida.bFont;
          ctx.fillStyle = blk.esFirma ? cAcento : '#1f2937';
          for (var li = 0; li < blk.lineas.length; li++) {
            ctx.fillText(blk.lineas[li], W / 2, y);
            y += elegida.lh;
          }
          if (bi < elegida.blks.length - 1) y += elegida.gap;
        }

        ctx.fillStyle = '#b45309';
        ctx.font = 'bold 28px system-ui, sans-serif';
        ctx.fillText('paracumpleanos.com', W / 2, H - 88);

        return { canvas: canvas, formato: formato };
      }

      window.pcRegistrarPopularidadPub = function (slug, peso) {
        if (!slug) return;
        try {
          var key = 'pc_popularidad_pubs_v1';
          var map = JSON.parse(localStorage.getItem(key) || '{}');
          map[slug] = (Number(map[slug]) || 0) + (Number(peso) || 1);
          localStorage.setItem(key, JSON.stringify(map));
        } catch (_) {}
        try {
          var acciones = { 1: 'leer_completo', 2: 'guardar_favorita', 3: 'copiar_o_compartir', 4: 'descargar_tarjeta' };
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'pc_interaccion_dedicatoria',
            pc_accion: acciones[Number(peso)] || 'interaccion',
            pc_slug: slug,
            pc_pagina: window.location.pathname
          });
        } catch (_) {}
      };

      function detectarSlugDesdeNodo(nodo) {
        if (!nodo || !nodo.closest) return '';
        var card = nodo.closest('[data-slug]');
        if (card) return card.getAttribute('data-slug') || '';
        var det = document.getElementById('mensaje-cuerpo');
        if (det) return det.getAttribute('data-slug') || '';
        return '';
      }

      document.addEventListener('click', function (e) {
        var leerMas = e.target.closest ? e.target.closest('.btn-leer-mas') : null;
        if (leerMas) {
          var cardExp = leerMas.closest ? leerMas.closest('.card') : null;
          if (cardExp) {
            var resEl = cardExp.querySelector('.card-resumen');
            var compEl = cardExp.querySelector('.card-texto-completo');
            var abierto = leerMas.getAttribute('aria-expanded') === 'true';
            if (compEl) compEl.hidden = abierto;
            if (resEl) resEl.hidden = !abierto;
            leerMas.setAttribute('aria-expanded', abierto ? 'false' : 'true');
            leerMas.textContent = abierto ? 'Leer completo ▾' : 'Ver resumen ▴';
            var slugExp = detectarSlugDesdeNodo(leerMas);
            if (!abierto && slugExp && window.pcRegistrarPopularidadPub) {
              window.pcRegistrarPopularidadPub(slugExp, 1);
            }
          }
          return;
        }

        var favBtn = e.target.closest ? e.target.closest('.btn-favorita') : null;
        if (favBtn) {
          var fSlug = favBtn.getAttribute('data-fav-slug') || detectarSlugDesdeNodo(favBtn);
          var fTitulo = favBtn.getAttribute('data-fav-titulo') || '';
          var fEmoji = favBtn.getAttribute('data-fav-emoji') || '🎂';
          var fCard = favBtn.closest ? favBtn.closest('article.card') : null;
          var fCopyBtn = fCard ? fCard.querySelector('.btn-copiar') : null;
          var fTexto = (fCopyBtn && fCopyBtn.getAttribute('data-text')) || (fCard && fCard.getAttribute('data-orig-texto')) || '';
          if (fSlug && window.__pcToggleFavorita) {
            window.__pcToggleFavorita({ slug: fSlug, titulo: fTitulo, emoji: fEmoji, texto: fTexto });
          }
          return;
        }

        var wa = e.target.closest ? e.target.closest('.btn-wa') : null;
        if (wa) {
          var slugWa = detectarSlugDesdeNodo(wa);
          if (slugWa && window.pcRegistrarPopularidadPub) window.pcRegistrarPopularidadPub(slugWa, 3);
        }

        var btn = e.target.closest ? e.target.closest('.btn-copiar') : null;
        if (btn) {
          var slugCop = detectarSlugDesdeNodo(btn);
          if (slugCop && window.pcRegistrarPopularidadPub) window.pcRegistrarPopularidadPub(slugCop, 3);
          var texto = btn.getAttribute('data-text') || '';
          var original = btn.textContent;
          var enTarjetaGrilla = Boolean(btn.closest && btn.closest('article.card'));
          copiarAlPortapapeles(texto).then(function (ok) {
            if (!ok) return;
            btn.textContent = '¡Copiado! ✓';
            setTimeout(function () { btn.textContent = original; }, 2000);
            if (enTarjetaGrilla && slugCop && window.pcMostrarToast) {
              window.pcMostrarToast('✓ Texto copiado. ¿Querés bajarlo en tarjeta PNG o Story?', '/' + slugCop + '/', 'Abrir tarjeta →');
            }
          });
          return;
        }

        var dl = e.target.closest ? e.target.closest('.btn-descargar') : null;
        if (dl) {
          var slugDl = detectarSlugDesdeNodo(dl);
          if (slugDl && window.pcRegistrarPopularidadPub) window.pcRegistrarPopularidadPub(slugDl, 4);
          var visualDl = (dl.closest && dl.closest('.herr-modulo') && dl.closest('.herr-modulo').querySelector('.tarjeta-visual')) || document.querySelector('.tarjeta-visual');
          var resDl = generarCanvasTarjeta({
            title: dl.getAttribute('data-title') || '',
            mostrarTitulo: dl.getAttribute('data-mostrar-titulo') === '1',
            body: dl.getAttribute('data-body') || '',
            emoji: dl.getAttribute('data-emoji') || '🎂',
            fuente: dl.getAttribute('data-fuente') || '',
            formato: dl.getAttribute('data-formato') || '',
            subtitulo: dl.getAttribute('data-subtitulo') || '',
            visualEl: visualDl
          });
          if (!resDl) return;
          var a = document.createElement('a');
          a.download = resDl.formato === 'story' ? 'tarjeta-story-ig.png' : 'tarjeta-cumpleanos.png';
          a.href = resDl.canvas.toDataURL('image/png');
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          window.pcMostrarToast('✓ Tarjeta PNG descargada lista para compartir.');
          return;
        }

        var ig = e.target.closest ? e.target.closest('.btn-ig') : null;
        if (ig) {
          var visualIg = (ig.closest && ig.closest('.herr-modulo') && ig.closest('.herr-modulo').querySelector('.tarjeta-visual')) || document.querySelector('.tarjeta-visual');
          var igTitulo = ig.getAttribute('data-ig-title') || 'Feliz cumpleaños';
          var igCuerpo = ig.getAttribute('data-ig-body') || '';
          var igEmoji = ig.getAttribute('data-ig-emoji') || '🎂';
          var igTexto = ig.getAttribute('data-ig-text') || igCuerpo;
          var igUrl = ig.getAttribute('data-ig-url') || window.location.href;
          var caption = igTexto + '\n\nVía paracumpleanos.com';

          var resIg = generarCanvasTarjeta({
            title: igTitulo,
            mostrarTitulo: ig.getAttribute('data-mostrar-titulo') === '1',
            body: igCuerpo,
            emoji: igEmoji,
            fuente: ig.getAttribute('data-fuente') || '',
            formato: ig.getAttribute('data-formato') || '',
            subtitulo: ig.getAttribute('data-subtitulo') || '',
            visualEl: visualIg
          });

          function fallbackDescargaIg() {
            if (resIg) {
              var linkDl = document.createElement('a');
              linkDl.download = resIg.formato === 'story' ? 'tarjeta-story-instagram.png' : 'tarjeta-instagram.png';
              linkDl.href = resIg.canvas.toDataURL('image/png');
              document.body.appendChild(linkDl);
              linkDl.click();
              document.body.removeChild(linkDl);
            }
            copiarAlPortapapeles(caption).then(function () {
              window.pcMostrarToast(
                '✓ Imagen PNG para Instagram descargada y texto copiado.',
                'https://www.instagram.com/',
                'Abrir Instagram →'
              );
            });
          }

          if (resIg && resIg.canvas.toBlob && navigator.share && navigator.canShare) {
            resIg.canvas.toBlob(function (blob) {
              if (!blob) { fallbackDescargaIg(); return; }
              try {
                var file = new File([blob], 'tarjeta-instagram.png', { type: 'image/png' });
                if (navigator.canShare({ files: [file] })) {
                  navigator.share({
                    files: [file],
                    title: igTitulo,
                    text: caption,
                    url: igUrl
                  }).catch(function () { fallbackDescargaIg(); });
                  return;
                }
              } catch (_) {}
              fallbackDescargaIg();
            }, 'image/png');
          } else {
            fallbackDescargaIg();
          }
          return;
        }

        var imp = e.target.closest ? e.target.closest('.btn-imprimir') : null;
        if (imp) {
          var printMode = imp.getAttribute('data-print-mode') || '';
          var mod = imp.closest ? imp.closest('.herr-modulo') : null;
          document.body.classList.remove('pc-print-con-solo', 'pc-print-postal', 'pc-print-banderines');
          document.querySelectorAll('.herr-modulo.pc-print-solo').forEach(function (el) {
            el.classList.remove('pc-print-solo');
          });
          if (printMode === 'banderines') {
            document.body.classList.add('pc-print-banderines');
            if (mod) {
              document.body.classList.add('pc-print-con-solo');
              mod.classList.add('pc-print-solo');
            }
          } else if (mod) {
            document.body.classList.add('pc-print-con-solo');
            mod.classList.add('pc-print-solo');
          } else {
            document.body.classList.add('pc-print-postal');
          }
          window.addEventListener('afterprint', function limpiarSoloPrint() {
            document.body.classList.remove('pc-print-con-solo', 'pc-print-postal', 'pc-print-banderines');
            if (mod) mod.classList.remove('pc-print-solo');
            window.removeEventListener('afterprint', limpiarSoloPrint);
          });
          if (typeof window.print === 'function') {
            window.print();
          }
        }
      });

      // Chequeo pasivo de notificacion diaria motivacional si el visitante activo alertas
      try {
        var raw = localStorage.getItem('pc_motivacion_diaria');
        if (raw && typeof Notification !== 'undefined' && Notification.permission === 'granted') {
          var conf = JSON.parse(raw);
          var hoyStr = new Date().toISOString().slice(0, 10);
          if (conf && conf.activo && conf.push && conf.ultimaFechaNotif !== hoyStr) {
            var partesH = String(conf.hora || '08:30').split(':');
            var minsObj = Number(partesH[0] || 8) * 60 + Number(partesH[1] || 30);
            var ahoraD = new Date();
            var minsAhora = ahoraD.getHours() * 60 + ahoraD.getMinutes();
            if (minsAhora >= minsObj) {
              var titEl = document.getElementById('motiv-frase-link');
              var cueEl = document.getElementById('motiv-frase-cuerpo');
              if (titEl && cueEl) {
                new Notification('✨ ' + titEl.textContent, { body: cueEl.textContent, icon: '/logopc.png' });
                conf.ultimaFechaNotif = hoyStr;
                localStorage.setItem('pc_motivacion_diaria', JSON.stringify(conf));
              }
            }
          }
        }
      } catch (_) {}
      // Filtro rapido para los 196 paises en el menu lateral
