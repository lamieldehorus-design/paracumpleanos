      // Favoritas guardadas en localStorage entre colecciones
      (function () {
        var FAV_KEY = 'pc_favoritas_v1';
        var barra = document.getElementById('pc-favoritas-barra');
        var countEl = document.getElementById('pc-favoritas-count');
        var dialog = document.getElementById('pc-favoritas-dialog');
        var listaEl = document.getElementById('pc-fav-lista');
        var btnCerrar = document.getElementById('pc-fav-cerrar');
        var btnListo = document.getElementById('pc-fav-listo');
        var btnVaciar = document.getElementById('pc-fav-vaciar');

        function leerFavs() {
          try {
            var arr = JSON.parse(localStorage.getItem(FAV_KEY) || '[]');
            return Array.isArray(arr) ? arr : [];
          } catch (_) {
            return [];
          }
        }

        function guardarFavs(arr) {
          try {
            localStorage.setItem(FAV_KEY, JSON.stringify(arr.slice(0, 40)));
          } catch (_) {}
        }

        function sincronizarBotones() {
          var favs = leerFavs();
          var setSlugs = {};
          for (var i = 0; i < favs.length; i++) setSlugs[favs[i].slug] = true;
          document.querySelectorAll('.btn-favorita').forEach(function (b) {
            var sl = b.getAttribute('data-fav-slug') || '';
            var activa = Boolean(sl && setSlugs[sl]);
            b.setAttribute('aria-pressed', activa ? 'true' : 'false');
            b.textContent = activa ? '♥ Guardada' : '♡ Guardar';
          });
          if (countEl) countEl.textContent = String(favs.length);
          if (barra) barra.hidden = favs.length === 0;
        }

        function renderDialog() {
          if (!listaEl) return;
          var favs = leerFavs();
          listaEl.innerHTML = '';
          if (!favs.length) {
            var pVacio = document.createElement('p');
            pVacio.className = 'pc-fav-vacio';
            pVacio.textContent = 'Todavía no guardaste dedicatorias. Tocá «♡ Guardar» en cualquier tarjeta para tenerla a mano.';
            listaEl.appendChild(pVacio);
            return;
          }
          favs.forEach(function (item) {
            var art = document.createElement('article');
            art.className = 'pc-fav-item';

            var head = document.createElement('div');
            head.className = 'pc-fav-item-head';
            var titLink = document.createElement('a');
            titLink.href = '/' + item.slug + '/';
            titLink.className = 'pc-fav-item-titulo';
            titLink.textContent = (item.emoji ? item.emoji + ' ' : '') + (item.titulo || item.slug);
            head.appendChild(titLink);

            var btnQuitar = document.createElement('button');
            btnQuitar.type = 'button';
            btnQuitar.className = 'pc-fav-quitar';
            btnQuitar.setAttribute('aria-label', 'Quitar "' + (item.titulo || item.slug) + '" de guardadas');
            btnQuitar.textContent = 'Quitar';
            btnQuitar.addEventListener('click', function () {
              var next = leerFavs().filter(function (f) { return f.slug !== item.slug; });
              guardarFavs(next);
              sincronizarBotones();
              renderDialog();
            });
            head.appendChild(btnQuitar);
            art.appendChild(head);

            if (item.texto) {
              var pTxt = document.createElement('p');
              pTxt.className = 'pc-fav-item-texto';
              pTxt.textContent = item.texto.length > 240 ? item.texto.slice(0, 237).trim() + '…' : item.texto;
              art.appendChild(pTxt);
            }

            var acc = document.createElement('div');
            acc.className = 'pc-fav-item-acciones';

            if (item.texto) {
              var bCop = document.createElement('button');
              bCop.type = 'button';
              bCop.className = 'btn btn-copiar btn-sm';
              bCop.setAttribute('data-text', item.texto);
              bCop.textContent = 'Copiar';
              acc.appendChild(bCop);

              var aWa = document.createElement('a');
              aWa.className = 'btn btn-wa btn-sm';
              aWa.target = '_blank';
              aWa.rel = 'noopener noreferrer';
              aWa.href = 'https://wa.me/?text=' + encodeURIComponent(item.texto);
              aWa.textContent = 'WhatsApp';
              acc.appendChild(aWa);
            }

            var aCard = document.createElement('a');
            aCard.className = 'card-cta-tarjeta';
            aCard.href = '/' + item.slug + '/';
            aCard.textContent = 'Tarjeta PNG / Story →';
            acc.appendChild(aCard);

            art.appendChild(acc);
            listaEl.appendChild(art);
          });
        }

        window.__pcSincronizarFavoritas = sincronizarBotones;
        window.__pcToggleFavorita = function (item) {
          var favs = leerFavs();
          var idx = favs.findIndex(function (f) { return f.slug === item.slug; });
          if (idx !== -1) {
            favs.splice(idx, 1);
            guardarFavs(favs);
            sincronizarBotones();
            if (window.pcMostrarToast) window.pcMostrarToast('Quitada de tus guardadas.');
          } else {
            favs.unshift({
              slug: item.slug,
              titulo: item.titulo,
              emoji: item.emoji,
              texto: item.texto
            });
            guardarFavs(favs);
            sincronizarBotones();
            if (item.slug && window.pcRegistrarPopularidadPub) window.pcRegistrarPopularidadPub(item.slug, 2);
            if (window.pcMostrarToast) window.pcMostrarToast('♥ Guardada en tu lista (' + favs.length + ').');
          }
          if (dialog && dialog.open) renderDialog();
        };

        if (barra && dialog) {
          barra.addEventListener('click', function () {
            renderDialog();
            if (typeof dialog.showModal === 'function') {
              dialog.showModal();
            } else {
              dialog.setAttribute('open', 'open');
            }
          });
        }
        function cerrarDialog() {
          if (!dialog) return;
          if (typeof dialog.close === 'function' && dialog.open) dialog.close();
          else dialog.removeAttribute('open');
        }
        if (btnCerrar) btnCerrar.addEventListener('click', cerrarDialog);
        if (btnListo) btnListo.addEventListener('click', cerrarDialog);
        if (btnVaciar) {
          btnVaciar.addEventListener('click', function () {
            guardarFavs([]);
            sincronizarBotones();
            renderDialog();
          });
        }
        if (dialog) {
          dialog.addEventListener('click', function (ev) {
            if (ev.target === dialog) cerrarDialog();
          });
        }

        sincronizarBotones();
      })();

      // Consentimiento RGPD Europa (CMP) integrado con Google Consent Mode v2
      (function () {
        var CMP_KEY = 'pc_consentimiento_v1';
        var EUROPA_PREFIJOS = [
          'Europe/',
          'Atlantic/Canary',
          'Atlantic/Faroe',
          'Atlantic/Madeira',
          'Atlantic/Azores',
          'Atlantic/Reykjavik'
        ];
        var banner = document.getElementById('pc-cmp-banner');
        var dialog = document.getElementById('pc-cmp-dialog');
        var chkAnalitica = document.getElementById('pc-cmp-chk-analitica');
        var chkPublicidad = document.getElementById('pc-cmp-chk-publicidad');
        var btnRechazar = document.getElementById('pc-cmp-rechazar');
        var btnConfigurar = document.getElementById('pc-cmp-configurar');
        var btnAceptar = document.getElementById('pc-cmp-aceptar');
        var btnCerrar = document.getElementById('pc-cmp-cerrar');
        var btnModalRechazar = document.getElementById('pc-cmp-modal-rechazar');
        var btnModalGuardar = document.getElementById('pc-cmp-modal-guardar');
        var btnModalAceptar = document.getElementById('pc-cmp-modal-aceptar');

        function detectarZonaEuropea() {
          try {
            var params = new URLSearchParams(window.location.search || '');
            if (params.get('cmp') === '1' || params.get('cmp') === 'reset') return true;
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            for (var i = 0; i < EUROPA_PREFIJOS.length; i++) {
              if (tz === EUROPA_PREFIJOS[i] || tz.indexOf(EUROPA_PREFIJOS[i]) === 0) return true;
            }
          } catch (_) {}
          return false;
        }

        function leerConsentimiento() {
          try {
            var raw = localStorage.getItem(CMP_KEY);
            if (!raw) return null;
            var obj = JSON.parse(raw);
            if (!obj || typeof obj !== 'object') return null;
            return {
              esenciales: true,
              analitica: Boolean(obj.analitica),
              publicidad: Boolean(obj.publicidad),
              actualizado: obj.actualizado || ''
            };
          } catch (_) {
            return null;
          }
        }

        function aplicarConsentimiento(analitica, publicidad, mostrarAviso) {
          var prefs = {
            esenciales: true,
            analitica: Boolean(analitica),
            publicidad: Boolean(publicidad),
            actualizado: new Date().toISOString().slice(0, 10)
          };
          try {
            localStorage.setItem(CMP_KEY, JSON.stringify(prefs));
          } catch (_) {}

          var pubEstado = prefs.publicidad ? 'granted' : 'denied';
          var anaEstado = prefs.analitica ? 'granted' : 'denied';
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              ad_storage: pubEstado,
              ad_user_data: pubEstado,
              ad_personalization: pubEstado,
              analytics_storage: anaEstado,
              functionality_storage: 'granted',
              security_storage: 'granted'
            });
          }
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'pc_consent_updated',
            pc_consent_analytics: anaEstado,
            pc_consent_ads: pubEstado
          });

          if (banner) banner.hidden = true;
          cerrarModalCmp();
          if (mostrarAviso && window.pcMostrarToast) {
            window.pcMostrarToast('✓ Preferencias de privacidad guardadas.');
          }
        }

        function abrirModalCmp() {
          if (!dialog) return;
          var actual = leerConsentimiento();
          var porDefecto = !detectarZonaEuropea();
          if (chkAnalitica) chkAnalitica.checked = actual ? actual.analitica : porDefecto;
          if (chkPublicidad) chkPublicidad.checked = actual ? actual.publicidad : porDefecto;
          if (typeof dialog.showModal === 'function') {
            if (!dialog.open) dialog.showModal();
          } else {
            dialog.setAttribute('open', 'open');
          }
        }

        function cerrarModalCmp() {
          if (!dialog) return;
          if (typeof dialog.close === 'function' && dialog.open) dialog.close();
          else dialog.removeAttribute('open');
        }

        window.__pcAbrirCmp = abrirModalCmp;

        document.addEventListener('click', function (ev) {
          var trigger = ev.target && ev.target.closest ? ev.target.closest('[data-abrir-cmp]') : null;
          if (trigger) {
            ev.preventDefault();
            abrirModalCmp();
          }
        });

        if (btnRechazar) btnRechazar.addEventListener('click', function () { aplicarConsentimiento(false, false, true); });
        if (btnAceptar) btnAceptar.addEventListener('click', function () { aplicarConsentimiento(true, true, true); });
        if (btnConfigurar) btnConfigurar.addEventListener('click', abrirModalCmp);
        if (btnCerrar) btnCerrar.addEventListener('click', cerrarModalCmp);
        if (btnModalRechazar) btnModalRechazar.addEventListener('click', function () { aplicarConsentimiento(false, false, true); });
        if (btnModalAceptar) btnModalAceptar.addEventListener('click', function () { aplicarConsentimiento(true, true, true); });
        if (btnModalGuardar) {
          btnModalGuardar.addEventListener('click', function () {
            aplicarConsentimiento(
              Boolean(chkAnalitica && chkAnalitica.checked),
              Boolean(chkPublicidad && chkPublicidad.checked),
              true
            );
          });
        }
        if (dialog) {
          dialog.addEventListener('click', function (ev) {
            if (ev.target === dialog) cerrarModalCmp();
          });
        }

        try {
          var paramsInit = new URLSearchParams(window.location.search || '');
          if (paramsInit.get('cmp') === 'reset') {
            localStorage.removeItem(CMP_KEY);
          }
        } catch (_) {}

        if (banner && !leerConsentimiento() && detectarZonaEuropea()) {
          banner.hidden = false;
        }
      })();
    })();
  </script>
</body>
</html>
