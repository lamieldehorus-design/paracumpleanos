        filtroPaises.addEventListener('input', function () {
          var q = String(filtroPaises.value || '')
            .trim()
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
          var items = listaPaises.children;
          for (var i = 0; i < items.length; i++) {
            var li = items[i];
