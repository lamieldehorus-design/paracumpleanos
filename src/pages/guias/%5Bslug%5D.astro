---
import Base from '../../layouts/Base.astro';
import { GUIAS_EDITORIALES } from '../../data/guias.ts';
import { MARCA, SITIO, migasLd } from '../../lib/contenido.ts';

export function getStaticPaths() {
  return GUIAS_EDITORIALES.map(function (guia, idx) {
    const catSet = new Set(guia.categoriasRelacionadas.map(function (c) { return c.slug; }));
    const candidatas = GUIAS_EDITORIALES.filter(function (_, i) { return i !== idx; });
    const ordenadas = candidatas
      .map(function (g, i) {
        const comunes = g.categoriasRelacionadas.filter(function (c) { return catSet.has(c.slug); }).length;
        return { g, comunes, orden: i };
      })
      .sort(function (a, b) {
        if (b.comunes !== a.comunes) return b.comunes - a.comunes;
        return b.g.fechaActualizacion.localeCompare(a.g.fechaActualizacion) || (b.orden - a.orden);
      });
    const otras = ordenadas.slice(0, 4).map(function (x) { return x.g; });
    return {
      params: { slug: guia.slug },
      props: { guia, otras }
    };
  });
}

const { guia, otras } = Astro.props;
const urlGuia = `${SITIO}/guias/${guia.slug}/`;
const jsonld: any[] = [
  migasLd([
    { name: 'Inicio', url: `${SITIO}/` },
    { name: 'Guías editoriales', url: `${SITIO}/guias/` },
    { name: guia.titulo, url: urlGuia }
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guia.h1,
    description: guia.descripcion,
    keywords: [guia.keywordPrincipal, ...guia.keywordsSecundarias].join(', '),
    datePublished: guia.fechaPublicacion,
    dateModified: guia.fechaActualizacion,
    inLanguage: 'es-AR',
    author: {
      '@type': 'Organization',
      name: guia.autor,
      description: guia.autorBio,
      url: `${SITIO}/sobre-nosotros/#criterio-editorial`
    },
    publisher: {
      '@type': 'Organization',
      name: MARCA,
      url: `${SITIO}/`
    },
    mainEntityOfPage: urlGuia
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guia.faqs.map(function (f) {
      return {
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta }
      };
    })
  }
];

if (guia.pasosHowTo && guia.pasosHowTo.length) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: guia.h1,
    description: guia.respuestaDirecta,
    step: guia.pasosHowTo.map(function (p, i) {
      return {
        '@type': 'HowToStep',
        position: i + 1,
        name: p.nombre,
        text: p.texto
      };
    })
  });
}

const etiquetasGuia =
  guia.etiquetas && guia.etiquetas.length
    ? guia.etiquetas.slice(0, 3)
    : [guia.keywordPrincipal, ...guia.keywordsSecundarias].slice(0, 3);

const pasosPersonalizacion =
  guia.comoHacerloTuyo && guia.comoHacerloTuyo.length
    ? guia.comoHacerloTuyo
    : [
        'Nombrá una cualidad concreta de esa persona en lugar de adjetivos genéricos.',
        'Sumá una mini-escena compartida (una sobremesa, un viaje, una costumbre diaria).',
        'Evitá comparaciones y elegí un deseo acorde a la etapa real que está viviendo.',
        'Cerrá con el apodo o la firma tal como se llaman en la vida cotidiana.'
      ];

const indiceItems = [
  ...guia.secciones.map(function (s, i) {
    return { id: `sec-${i + 1}`, texto: s.subtitulo };
  }),
  { id: 'guia-comparacion-titulo', texto: guia.comparacionPractica.titulo },
  { id: 'guia-tabla-titulo', texto: guia.tablaComparativa.titulo },
  { id: 'guia-ejemplos-titulo', texto: 'Plantillas rápidas listas para adaptar' },
  { id: 'guia-personalizar-titulo', texto: 'Cómo hacerlo tuyo en 1 minuto' },
  { id: 'guia-checklist-titulo', texto: 'Checklist rápida antes de enviar' },
  { id: 'guia-faq-titulo', texto: 'Preguntas frecuentes' }
];
---
<Base
  titulo={guia.seoTitle}
  descripcion={guia.descripcion}
  jsonld={jsonld}
>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <a href="/guias/">Guías editoriales</a> › <span>{guia.titulo}</span>
  </nav>

  <article class="articulo-guia">
    <header class="articulo-cabecera">
      <p class="guia-meta">
        <span aria-hidden="true">{guia.emoji}</span>
        <span>{guia.tiempoLectura}</span>
        <span>·</span>
        <span>Por <a href="#autor-guia">{guia.autor}</a></span>
        <span>·</span>
        <span>Actualizado el <time datetime={guia.fechaActualizacion}>{guia.fechaActualizacion}</time></span>
      </p>
      <h1>{guia.h1}</h1>
      <p class="lead">{guia.resumen}</p>
    </header>

    <section class="respuesta-directa" aria-label="Respuesta directa">
      <p class="respuesta-etiqueta">Respuesta rápida</p>
      <p>{guia.respuestaDirecta}</p>
    </section>

    <nav class="indice-guia" aria-label="Índice de la guía">
      <p class="indice-titulo">Índice de contenidos</p>
      <ol class="indice-lista">
        {indiceItems.map(function (it) {
          return (
            <li>
              <a href={`#${it.id}`}>{it.texto}</a>
            </li>
          );
        })}
      </ol>
    </nav>

    <blockquote class="cita-editorial">{guia.citaDestacada}</blockquote>

    <aside class="datos-propios-box" aria-label="Dato propio editorial">
      <p class="datos-propios-titulo">{guia.datosPropios.titulo}</p>
      <p class="datos-propios-dato">{guia.datosPropios.dato}</p>
      <p class="datos-propios-fuente">Fuente: {guia.datosPropios.fuente}</p>
    </aside>

    {guia.secciones.map(function (sec, idx) {
      return (
        <section class="articulo-seccion" aria-labelledby={`sec-${idx + 1}`}>
          <h2 id={`sec-${idx + 1}`}>{sec.subtitulo}</h2>
          {sec.parrafos.map(function (p) {
            return <p>{p}</p>;
          })}
          {sec.lista && sec.lista.length ? (
            <ul class="lista-editorial">
              {sec.lista.map(function (item) {
                return <li>{item}</li>;
              })}
            </ul>
          ) : null}
        </section>
      );
    })}

    <section class="articulo-seccion" aria-labelledby="guia-comparacion-titulo">
      <h2 id="guia-comparacion-titulo">{guia.comparacionPractica.titulo}</h2>
      <div class="comparacion-concreta">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá enviar genérico</span>
          <p>«{guia.comparacionPractica.evitar}»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Ejemplo real con criterio</span>
          <p>«{guia.comparacionPractica.mejor}»</p>
        </div>
      </div>
    </section>

    <section class="bloque-tabla-hub" aria-labelledby="guia-tabla-titulo">
      <h2 id="guia-tabla-titulo">{guia.tablaComparativa.titulo}</h2>
      <div class="tabla-responsive">
        <table class="tabla-comparativa">
          <thead>
            <tr>
              {guia.tablaComparativa.columnas.map(function (col) {
                return <th>{col}</th>;
              })}
            </tr>
          </thead>
          <tbody>
            {guia.tablaComparativa.filas.map(function (fila) {
              return (
                <tr>
                  <td><strong>{fila[0]}</strong></td>
                  <td>{fila[1]}</td>
                  <td>{fila[2]}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="articulo-seccion" aria-labelledby="guia-ejemplos-titulo">
      <h2 id="guia-ejemplos-titulo">Plantillas rápidas listas para adaptar ({guia.ejemplosAdaptables.length})</h2>
      <p>Completá los datos entre corchetes con tu vínculo real antes de copiar:</p>
      <div class="ejemplos-guia">
        {guia.ejemplosAdaptables.map(function (ej) {
          return (
            <div class="ejemplo-plantilla">
              <div class="ejemplo-cabecera">
                <p class="ejemplo-etiqueta">{ej.etiqueta}</p>
                <button class="btn btn-copiar btn-sm" type="button" data-text={ej.texto}>Copiar plantilla</button>
              </div>
              <p class="ejemplo-texto">{ej.texto}</p>
            </div>
          );
        })}
      </div>
    </section>

    <section class="articulo-seccion guia-personalizar-box" aria-labelledby="guia-personalizar-titulo">
      <h2 id="guia-personalizar-titulo">Cómo hacerlo tuyo en 1 minuto</h2>
      <p class="guia-personalizar-intro">Antes de copiar una plantilla o abrir una tarjeta, pasala por estos filtros simples para que suene a tu vínculo real:</p>
      <ul class="lista-editorial">
        {pasosPersonalizacion.map(function (paso) {
          return <li>{paso}</li>;
        })}
      </ul>
    </section>

    <section class="articulo-seccion guia-checklist-box" aria-labelledby="guia-checklist-titulo" data-guia-checklist={guia.slug}>
      <div class="checklist-cabecera">
        <h2 id="guia-checklist-titulo">Checklist rápida antes de enviar</h2>
        <span class="checklist-progreso" id="guia-checklist-progreso">0 de {guia.checklistPractica.length} listas</span>
      </div>
      <ul class="guia-checklist">
        {guia.checklistPractica.map(function (paso, idx) {
          return (
            <li>
              <label class="checklist-item">
                <input type="checkbox" data-checklist-idx={idx} />
                <span>{paso}</span>
              </label>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="faqs-hub" aria-labelledby="guia-faq-titulo">
      <h2 id="guia-faq-titulo">Preguntas frecuentes</h2>
      <div class="faq-lista">
        {guia.faqs.map(function (f, i) {
          return (
            <details class="faq-item" open={i === 0}>
              <summary>{f.pregunta}</summary>
              <p>{f.respuesta}</p>
            </details>
          );
        })}
      </div>
    </section>

    <section class="guia-categoria" aria-labelledby="cats-guia">
      <h2 id="cats-guia">Categorías recomendadas para poner esto en práctica</h2>
      <p>Abrí cualquiera de estas colecciones, elegí la dedicatoria que mejor encaje y personalizala con nombre, firma y foto dentro de esa publicación:</p>
      <div class="chips">
        {guia.categoriasRelacionadas.map(function (c) {
          return <a class="chip" href={`/${c.slug}/`}>{c.nombre}</a>;
        })}
      </div>
      <div class="guia-etiquetas-linea" aria-label="Temas tratados en esta guía">
        <span class="guia-etiquetas-label">Temas:</span>
        {etiquetasGuia.map(function (et) {
          return <span class="guia-etiqueta-item">{et}</span>;
        })}
      </div>
    </section>

    {guia.fuentesAutoridad && guia.fuentesAutoridad.length ? (
      <section class="fuentes-box" aria-labelledby="fuentes-titulo">
        <h2 id="fuentes-titulo">Referencias y fuentes consultadas</h2>
        <ul>
          {guia.fuentesAutoridad.map(function (f) {
            return (
              <li>
                <a href={f.url} target="_blank" rel="noopener noreferrer">{f.nombre}</a>
              </li>
            );
          })}
        </ul>
      </section>
    ) : null}

    <aside class="autor-bio-box" id="autor-guia" aria-label="Sobre el autor y criterio editorial">
      <div class="autor-bio-cabecera">
        <span class="autor-bio-nombre">{guia.autor}</span>
        <span class="autor-bio-rol">· {guia.autorRol}</span>
      </div>
      <p class="autor-bio-texto">{guia.autorBio}</p>
      <p class="fechas-meta">Publicado: <time datetime={guia.fechaPublicacion}>{guia.fechaPublicacion}</time> · Última revisión: <time datetime={guia.fechaActualizacion}>{guia.fechaActualizacion}</time> · <a href="/sobre-nosotros/#criterio-editorial">Criterio editorial</a> · <a href="/contacto/">Sugerir corrección</a></p>
    </aside>
  </article>

  <section class="hermanas" aria-labelledby="otras-guias-titulo">
    <h2 id="otras-guias-titulo">Seguí leyendo otras guías</h2>
    <div class="guias-grid">
      {otras.map(function (o) {
        return (
          <article class="card guia-card">
            <p class="guia-meta"><span>{o.emoji}</span> <span>{o.tiempoLectura}</span></p>
            <h3><a href={`/guias/${o.slug}/`}>{o.titulo}</a></h3>
            <p>{o.resumen}</p>
          </article>
        );
      })}
    </div>
    <p class="ver-tambien"><a href="/guias/">Ver las {GUIAS_EDITORIALES.length} guías completas →</a></p>
  </section>

  <script is:inline>
    (function () {
      var box = document.querySelector('[data-guia-checklist]');
      if (!box) return;
      var slug = box.getAttribute('data-guia-checklist') || 'guia';

      // Registrar visita para el ranking dinamico de "Guias mas visitadas" en portada
      try {
        var vKey = 'pc_visitas_guias_v1';
        var vMap = JSON.parse(localStorage.getItem(vKey) || '{}');
        vMap[slug] = (Number(vMap[slug]) || 0) + 1;
        localStorage.setItem(vKey, JSON.stringify(vMap));
      } catch (_) {}

      var key = 'pc_checklist_' + slug;
      var inputs = box.querySelectorAll('input[type="checkbox"][data-checklist-idx]');
      var prog = document.getElementById('guia-checklist-progreso');
      function cargar() {
        try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch (_) { return []; }
      }
      function guardar(arr) {
        try { localStorage.setItem(key, JSON.stringify(arr)); } catch (_) {}
      }
      function actualizarProgreso() {
        var checked = 0;
        var arr = [];
        inputs.forEach(function (inp) {
          if (inp.checked) {
            checked++;
            arr.push(Number(inp.getAttribute('data-checklist-idx')));
          }
        });
        if (prog) prog.textContent = checked + ' de ' + inputs.length + ' listas';
        return arr;
      }
      var guardados = cargar();
      inputs.forEach(function (inp) {
        var idx = Number(inp.getAttribute('data-checklist-idx'));
        if (guardados.indexOf(idx) !== -1) inp.checked = true;
        inp.addEventListener('change', function () {
          guardar(actualizarProgreso());
        });
      });
      actualizarProgreso();
    })();
  </script>
</Base>
