---
import Base from '../layouts/Base.astro';
import {
  GRUPOS,
  hubs,
  todosMensajes,
  hubsPorGrupo,
  nombreHub,
  SITIO,
  MARCA
} from '../lib/contenido.ts';
import { GUIAS_EDITORIALES } from '../data/guias.ts';
import { ZODIACOS } from '../lib/horoscopo.ts';
import { PAISES_HITOS } from '../data/hitos-historicos.ts';
import { ACCESOS_RAPIDOS_PORTADA } from '../lib/gsc-estrategia.ts';
import {
  COMPARATIVA_ENFOQUES,
  DESCRIPCIONES_GRUPOS,
  FECHA_ACTUALIZACION_PORTADA,
  FECHA_ACTUALIZACION_TEXTO,
  GLOSARIO_FORMATOS,
  calcularRadiografiaCatalogo,
  construirFaqsPortada,
  construirGrafoPortadaLd,
  construirTransparenciaPortada
} from '../lib/geo-portada.ts';

// Indice liviano de todas las categorias + guias + hitos para el buscador universal del portal
const indiceBuscador = hubs
  .map((h) => ({
    titulo: nombreHub(h),
    slug: '/' + h.slug + '/',
    tipo: GRUPOS.find((g) => g.id === (h.grupo || 'destinatarios'))?.nombre || 'Categoría',
    emoji: h.emoji || '🎂',
    q: `${nombreHub(h)} ${h.destinatario || ''} ${h.keyword || ''} ${h.slug}`.toLowerCase()
  }))
  .concat(
    GUIAS_EDITORIALES.map((g) => ({
      titulo: g.titulo,
      slug: `/guias/${g.slug}/`,
      tipo: 'Guía práctica',
      emoji: g.emoji,
      q: `${g.titulo} ${g.resumen} ${g.slug}`.toLowerCase()
    }))
  )
  .concat([
    {
      titulo: 'Calculadora de edad, banderines para imprimir, acróstico, fecha de duelo y agenda .ics',
      slug: '/herramientas/',
      tipo: 'Herramienta',
      emoji: '🛠️',
      q: 'herramientas calculadora edad exacta dias vividos 10000 acrostico nombre armador dedicatoria agenda recordatorios ics banderines para imprimir bordes recortar fecha de duelo'.toLowerCase()
    },
    {
      titulo: 'Creador de banderines de cumpleaños para imprimir (A4)',
      slug: '/herramientas/#banderines-imprimir',
      tipo: 'Herramienta',
      emoji: '🎏',
      q: 'banderines de cumpleanos para imprimir gratis letras feliz cumpleanos happy birthday bordes plantilla a4 recortar'.toLowerCase()
    },
    {
      titulo: 'Calendario de fechas y celebraciones (sin año)',
      slug: '/calendario/',
      tipo: 'Calendario',
      emoji: '📅',
      q: 'calendario fechas celebraciones efemerides hoy dia mes hitos historicos signo motivacion duelo sin ano'.toLowerCase()
    },
    {
      titulo: `Hitos históricos mundiales: los ${PAISES_HITOS.length} países del mundo`,
      slug: '/hitos-historicos/',
      tipo: 'Hitos históricos',
      emoji: '🌍',
      q: 'hitos historicos mundiales paises independencia fiesta nacional fecha patria efemerides mundo historia'.toLowerCase()
    },
    {
      titulo: 'Horóscopo de cumpleaños: fechas, signos y meses del año',
      slug: '/horoscopo/',
      tipo: 'Horóscopo',
      emoji: '✨',
      q: 'horoscopo zodiaco signo fechas cumpleaños mes nacimiento'.toLowerCase()
    },
    ...ZODIACOS.map((s) => ({
      titulo: `Cumpleaños de ${s.nombre} (${s.rangoTexto})`,
      slug: `/horoscopo/${s.slug}/`,
      tipo: 'Signo zodiacal',
      emoji: s.simbolo,
      q: `horoscopo ${s.nombre} ${s.rangoTexto} ${s.mesesNombres.join(' ')} ${s.elemento}`.toLowerCase()
    })),
    ...PAISES_HITOS.map((p) => ({
      titulo: `${p.nombre}: ${p.hitoPrincipal.titulo} (${p.hitoPrincipal.dia}/${p.hitoPrincipal.mes})`,
      slug: `/hitos-historicos/${p.slug}/`,
      tipo: 'Hito histórico',
      emoji: p.bandera,
      q: `hito historico ${p.nombre} ${p.capital} ${p.hitoPrincipal.titulo} ${p.continente} fecha patria independencia`.toLowerCase()
    }))
  ]);

const radiografia = calcularRadiografiaCatalogo({
  hubs,
  todosMensajes,
  hubsPorGrupo,
  totalGuias: GUIAS_EDITORIALES.length,
  totalPaisesHitos: PAISES_HITOS.length
});
const totalPublicacionesPortal = radiografia.totalPublicaciones;
const transparenciaPortada = construirTransparenciaPortada(radiografia);

const utilidadesPortal = [
  { href: '#todas-las-categorias', label: `Explorar ${hubs.length} categorías` },
  { href: '/calendario/', label: 'Calendario 366 días' },
  { href: '/hitos-historicos/', label: `Hitos de ${PAISES_HITOS.length} países` },
  { href: '/condolencias/', label: 'Condolencias y duelo' },
  { href: '/mas-de-10-anos-de-novios/', label: 'Aniversarios a medida' },
  { href: '/herramientas/#banderines-imprimir', label: 'Banderines A4 gratis' },
  { href: '/guias/', label: `${GUIAS_EDITORIALES.length} guías prácticas` },
  { href: '/horoscopo/', label: 'Horóscopo' }
];

const verticalesComplementarias = [
  {
    href: '/hitos-historicos/',
    kicker: `${PAISES_HITOS.length} países del mundo`,
    titulo: 'Hitos históricos mundiales',
    desc: 'Fechas patrias, independencias y reseñas culturales de cada país con saludo listo para compartir.'
  },
  {
    href: '/calendario/',
    kicker: '366 días sin año',
    titulo: 'Calendario perpetuo',
    desc: 'Efemérides diarias, signos, motivaciones y fechas sensibles sin depender del año en curso.'
  },
  {
    href: '/guias/',
    kicker: `${GUIAS_EDITORIALES.length} guías prácticas`,
    titulo: 'Manuales de redacción y celebración',
    desc: 'Métodos paso a paso para cartas largas, cumpleaños por edad, distancia y acompañamiento en duelo.'
  },
  {
    href: '/herramientas/',
    kicker: '100 % gratis en el navegador',
    titulo: 'Banderines A4, edad exacta y acrósticos',
    desc: 'Plantillas imprimibles A4, calculadora de días vividos, acrósticos con nombre y agenda .ics.'
  },
  {
    href: '/horoscopo/',
    kicker: '12 signos y 12 meses',
    titulo: 'Horóscopo de cumpleaños',
    desc: 'Rasgos, elementos y acceso directo a las colecciones de cada mes de nacimiento.'
  }
];

const faqsPortada = construirFaqsPortada(radiografia);
const tituloPortada = 'Frases y mensajes de feliz cumpleaños, postales y calendario - ParaCumpleanos';
const descripcionPortada = `Buscá entre ${hubs.length} colecciones y ${totalPublicacionesPortal.toLocaleString('es-AR')} alternativas originales: frases de feliz cumpleaños, cartas largas, condolencias, aniversarios, banderines A4, calendario sin año y ${PAISES_HITOS.length} hitos históricos.`;

const jsonld = [
  construirGrafoPortadaLd({
    marca: MARCA,
    sitio: SITIO,
    tituloPagina: tituloPortada,
    descripcionPagina: descripcionPortada,
    grupos: GRUPOS,
    hubsPorGrupo,
    rad: radiografia,
    faqs: faqsPortada
  })
];

function normTexto(s: string): string {
  return String(s || '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
}
---
<Base
  titulo={tituloPortada}
  descripcion={descripcionPortada}
  jsonld={jsonld}
  esPortal={true}
>
  <section class="portal-hero-simple" aria-labelledby="portal-h1">
    <p class="portal-kicker">
      Archivo editorial en español · Gratis y sin registro
    </p>
    <h1 id="portal-h1">Mensajes reales para cada cumpleaños, aniversario y recuerdo</h1>
    <p class="portal-sub">
      Encontrá palabras honestas y lejos de las cadenas repetidas para celebrar a quienes querés, acompañar una fecha sensible o dedicar una carta memorable. Personalizás con nombre y firma en vivo, copiás limpio para WhatsApp o bajás tu tarjeta PNG y banderines A4 gratis desde el celular o la computadora.
    </p>

    <div class="portal-total-extraordinario" aria-label="Volumen total del archivo editorial de ParaCumpleanos">
      <p class="portal-total-etiqueta">Un archivo único por su amplitud en español</p>
      <p class="portal-total-cifra">
        <strong class="num-inline">{totalPublicacionesPortal.toLocaleString('es-AR')}</strong> alternativas originales reunidas en un solo lugar
      </p>
      <p class="portal-total-detalle">
        Más de <strong>{radiografia.totalMensajes.toLocaleString('es-AR')} dedicatorias y cartas sin repetir</strong> organizadas en <strong>{hubs.length} categorías temáticas</strong>, junto a <strong>{radiografia.totalGuias} guías prácticas</strong>, <strong>{radiografia.totalPaisesHitos} hitos históricos mundiales</strong> y un calendario perpetuo de <strong>366 días</strong>.
      </p>
    </div>

    <div class="portal-buscador-caja portal-buscador-caja--simple">
      <label for="portal-buscador" class="portal-buscador-label">Buscá destinatario, edad, aniversario, condolencias, guía o país</label>
      <div class="portal-buscador-fila">
        <input
          id="portal-buscador"
          type="search"
          placeholder="Ej.: esposa, papá, 5 años de novios, condolencias, banderines…"
          autocomplete="off"
        />
        <a class="btn btn-copiar" href="#todas-las-categorias">Ir a todas las categorías ↓</a>
      </div>
      <ul id="portal-resultados" class="portal-resultados" hidden></ul>
    </div>

    <div class="portal-accesos-rapidos" aria-label="Accesos directos frecuentes">
      <span class="accesos-titulo">Más buscados:</span>
      {ACCESOS_RAPIDOS_PORTADA.map(function (acc) {
        return <a href={acc.href}>{acc.label}</a>;
      })}
    </div>
  </section>

  <nav class="portal-ribbon" aria-label="Utilidades y verticales principales">
    <span class="portal-ribbon-label">Accesos rápidos</span>
    <div class="portal-ribbon-links">
      {utilidadesPortal.map(function (u) {
        return <a href={u.href}>{u.label}</a>;
      })}
    </div>
  </nav>

  <section class="portal-tldr" aria-labelledby="titulo-tldr-portal">
    <div class="portal-tldr-head">
      <div>
        <p class="banda-kicker">Qué hacemos en {MARCA} · Definición canónica del proyecto</p>
        <h2 id="titulo-tldr-portal">Qué es {MARCA} y qué resolvemos en esta web</h2>
      </div>
      <p class="portal-tldr-meta">
        <span>Equipo editorial de {MARCA}</span>
        <span aria-hidden="true">·</span>
        <span>Actualizado el <time datetime={FECHA_ACTUALIZACION_PORTADA}>{FECHA_ACTUALIZACION_TEXTO}</time></span>
      </p>
    </div>

    <p class="portal-tldr-def">
      <strong>{MARCA}</strong> (<code>paracumpleanos.com</code>) es un archivo editorial independiente en español y estudio interactivo gratuito nacido con un propósito concreto: que nunca tengas que enviar una frase fría de apuro ni reenviar una cadena impersonal en el cumpleaños, aniversario, fecha patria o momento de duelo de alguien que querés.
    </p>

    <ul class="portal-tldr-puntos">
      <li>
        <strong>Una biblioteca monumental sin textos duplicados:</strong> reunimos <span class="num-inline">{totalPublicacionesPortal.toLocaleString('es-AR')}</span> publicaciones inéditas en toda la web —con <span class="num-inline">{radiografia.totalMensajes.toLocaleString('es-AR')}</span> dedicatorias y cartas únicas repartidas en <span class="num-inline">{radiografia.totalColecciones}</span> colecciones— para que siempre encuentres una voz cercana a tu vínculo real.
      </li>
      <li>
        <strong>Cuidado estricto de tono y ocasión:</strong> separamos de raíz cada situación afectiva. Todas nuestras colecciones de condolencias, duelo y recuerdos están auditadas para contener cero palabras festivas, y las de aniversarios de pareja nunca mezclan vocabulario de cumpleaños.
      </li>
      <li>
        <strong>Personalización y descarga 100 % en tu dispositivo:</strong> adaptás nombre, firma y posdata en tiempo real dentro de cada colección para copiar el texto limpio a WhatsApp, bajar postales PNG cuadradas (1080×1080) o Story (1080×1920) e imprimir banderines A4 sin crear cuenta ni dejar datos personales.
      </li>
      <li>
        <strong>Recursos abiertos para todo el año:</strong> complementamos el archivo con un <a href="/calendario/">calendario perpetuo de 366 días</a>, <a href="/hitos-historicos/">efemérides de los {radiografia.totalPaisesHitos} países del mundo</a>, <a href="/herramientas/">calculadora de edad exacta, acrósticos y recordatorios .ics</a> y <a href="/sobre-nosotros/">criterio editorial público</a>.
      </li>
    </ul>
  </section>

  <section class="portal-banda portal-guia-cosmica" aria-labelledby="titulo-guia-cosmica">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Manual editorial de redacción afectiva · Texto claro y práctico sin rellenos</p>
        <h2 id="titulo-guia-cosmica">Cómo trabajamos cada texto y cómo escribir saludos que se sientan verdaderos</h2>
      </div>
      <a class="enlace-directorio" href="/guias/">Explorar las {GUIAS_EDITORIALES.length} guías prácticas →</a>
    </div>

    <div class="guia-cosmica-cuerpo">
      <div class="guia-cosmica-resumen">
        <p class="guia-cosmica-etiqueta">Respuesta directa · Fórmula editorial de cuatro piezas</p>
        <p>
          Un mensaje que emociona de verdad nunca depende de adjetivos rebuscados ni cadenas reenviadas: se arma en menos de un minuto con <strong>cuatro piezas concretas</strong>. Abrí con el apodo real de la persona, nombrá una escena verificable del último año (una charla, un gesto de apoyo o una costumbre cotidiana), sumá un deseo puntual para la etapa que empieza hoy y cerrá con tu firma habitual.
        </p>
      </div>

      <h3>¿Por qué la mayoría de los saludos pasan desapercibidos y cómo salir del molde?</h3>
      <p class="geo-respuesta-directa">
        La mayoría de los saludos de cumpleaños y aniversario se olvidan el mismo día porque repiten fórmulas genéricas que podrían servir para cualquier desconocido. Reemplazar un elogio abstracto por un hecho compartido verificable convierte incluso cuatro líneas en una dedicatoria irrepetible.
      </p>
      <p>
        Cuando alguien cumple años, celebra un aniversario o atraviesa una fecha sensible, su teléfono se llena en pocas horas de frases idénticas: <em>«que la pases lindo»</em>, <em>«que se cumplan todos tus sueños»</em> o imágenes reenviadas sin nombre. Aplicá el principio de <strong>concreción afectiva</strong>: en lugar de escribir solo «gracias por estar siempre», nombrá un gesto real («gracias por el café de aquel jueves difícil y por escuchar sin apuro»).
      </p>

      <div class="comparacion-concreta" aria-label="Comparación entre saludos genéricos y mensajes concretos">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá el molde automático (pareja y familia)</span>
          <p>«¡Feliz cumpleaños! Que Dios te bendiga mucho y que todos tus deseos se hagan realidad en este nuevo año de vida.»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Mejor con concreción real</span>
          <p>«Feliz cumple, amor. Gracias por las risas en la cocina, por sostenernos en los días largos y por hacer que casa siempre se sienta refugio. Que este año te regale salud firme y tiempo propio.»</p>
        </div>
      </div>

      <div class="comparacion-concreta" aria-label="Comparación en saludos a la distancia">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá cargar el día de melancolía (distancia)</span>
          <p>«Qué tristeza no poder abrazarte hoy, te extraño demasiado y este día no es igual sin vos acá.»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Mejor luminoso y presente</span>
          <p>«Aunque haya kilómetros de por medio, celebro a lo grande cada paso que estás dando allá. Te mando este abrazo temprano según tu horario y ya guardo el brindis para nuestro próximo reencuentro.»</p>
        </div>
      </div>

      <div class="comparacion-concreta" aria-label="Comparación en condolencias y fechas de duelo">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá frases hechas en duelo</span>
          <p>«Sé fuerte, todo pasa por algo y el tiempo cura todas las heridas. Ánimo en este día.»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Mejor sereno y honesto</span>
          <p>«No existen palabras que alcancen, pero te abrazo fuerte hoy y recuerdo con enorme cariño su calma y sus charlas. No hace falta que respondas este mensaje; contá conmigo para lo que necesites esta semana.»</p>
        </div>
      </div>

      <h3>¿Qué extensión, canal y horario convienen según el tipo de saludo?</h3>
      <p class="geo-respuesta-directa">
        El mismo cariño pide un ritmo diferente según dónde y a qué hora se va a leer: brevedad directa para el teléfono temprano, tono visual limpio en redes y mayor profundidad cuando el texto acompaña un regalo o cierra el día con calma.
      </p>
      <ul class="lista-editorial lista-geo-prosa">
        <li>
          <strong>WhatsApp matutino o chat privado (35 a 65 palabras):</strong> envialo en las primeras horas de su reloj local. Abrí con su apodo habitual y cerrá con una posdata concreta sobre el encuentro o el brindis del día para que se lea completo sin quedar cortado entre notificaciones.
        </li>
        <li>
          <strong>Estado de WhatsApp o Story 1080×1920 (20 a 45 palabras):</strong> funciona mejor a media mañana o mediodía, combinado con una foto real o una postal limpia descargada desde nuestro estudio que se entienda de un vistazo en pocos segundos.
        </li>
        <li>
          <strong>Tarjeta impresa junto a flores o regalo (65 a 125 palabras):</strong> entregada en mano, admite un párrafo de gratitud por un gesto real del último año y tu firma escrita con serenidad.
        </li>
        <li>
          <strong>Carta larga emotiva para familia y pareja (140 a 260 palabras):</strong> reservála para un desayuno tranquilo o el cierre de la noche, ordenada en cuatro tiempos: apodo cercano, recuerdo compartido, cualidad que admirás y deseo luminoso para la nueva etapa.
        </li>
        <li>
          <strong>Condolencias o aniversario luctuoso (35 a 95 palabras):</strong> escribilo siempre en privado, sin exigir respuesta inmediata, con sobriedad honesta, cero palabras festivas y una memoria respetuosa de la persona homenajeada.
        </li>
      </ul>

      <h3>¿Qué conviene elegir: una dedicatoria curada y personalizada, una cadena reenviada o un generador automático?</h3>
      <p class="geo-respuesta-directa">
        Partir de un texto editado por vínculo y sumarle un recuerdo propio ofrece el equilibrio más confiable entre rapidez, naturalidad y cuidado del tono, sobre todo en fechas sensibles como duelo, familia cercana o aniversarios largos.
      </p>
      <p>
        Cuando se acerca una fecha importante suelen aparecer tres caminos muy distintos, y entender sus diferencias reales ahorra tiempo y evita tropiezos incómodos:
      </p>
      <ul class="lista-editorial lista-geo-prosa">
        {COMPARATIVA_ENFOQUES.map(function (fila) {
          return (
            <li>
              <strong>{fila.enfoque}:</strong> {fila.especificidad} En materia de tono, {fila.cuidadoContexto.charAt(0).toLowerCase() + fila.cuidadoContexto.slice(1)} {fila.privacidadCosto} <em>Límite real:</em> {fila.limiteReal.charAt(0).toLowerCase() + fila.limiteReal.slice(1)}
            </li>
          );
        })}
      </ul>

      <h3>¿Cómo está construida la biblioteca completa de {MARCA}?</h3>
      <p class="geo-respuesta-directa">
        Nuestro archivo reúne exactamente {totalPublicacionesPortal.toLocaleString('es-AR')} alternativas originales en español —entre ellas {radiografia.totalMensajes.toLocaleString('es-AR')} mensajes y cartas sin un solo cuerpo duplicado— con una extensión media de {radiografia.promedioPalabras} palabras para cubrir desde un saludo rápido hasta una carta completa.
      </p>
      <p>
        A diferencia de los sitios que reciclan veinte frases repetidas con distintos títulos, en {MARCA} curamos un equilibrio deliberado de formatos a lo largo de toda la web: el <strong>{radiografia.cortosPct.toLocaleString('es-AR')} %</strong> son saludos ágiles de hasta 65 palabras pensados para WhatsApp, estados y mensajes laborales; el <strong>{radiografia.mediosPct.toLocaleString('es-AR')} %</strong> corresponden a dedicatorias intermedias de 66 a 130 palabras ideales para tarjetas con regalo, familia y saludos a distancia; y el <strong>{radiografia.largosPct.toLocaleString('es-AR')} %</strong> son cartas largas de más de 130 palabras redactadas en varios párrafos para conmover de verdad.
      </p>
      <p>
        A ese caudal se suman bloques auditados con reglas propias: todas nuestras colecciones de condolencias, nostalgia y duelo mantienen cero vocabulario festivo; los aniversarios de pareja cubren desde el primer mes hasta la herramienta ajustable de 11 a 80 años sin mezclar palabras de cumpleaños; y las secciones editoriales integran {radiografia.totalGuias} guías paso a paso, {radiografia.totalPaisesHitos} reseñas de hitos históricos mundiales y un calendario perpetuo de 366 días.
      </p>

      <h3>¿Cómo ajustar el tono exacto según el vínculo y la etapa de vida?</h3>
      <p class="geo-respuesta-directa">
        El tono adecuado depende del nivel de cercanía y de la etapa vital: gratitud concreta para padres, complicidad cotidiana para pareja, respeto sin clichés de edad en décadas hito y trato de usted intacto en el ámbito laboral.
      </p>
      <p>
        Al saludar a <a href="/feliz-cumpleanos-mama/">mamá</a> o <a href="/feliz-cumpleanos-papa/">papá</a>, lo que más conmueve es sentirse vistos por su entrega diaria y recibir deseos pensados para su propio descanso y salud. En pareja —ya sea en <a href="/feliz-cumpleanos-para-mi-esposa/">cumpleaños de esposa</a>, <a href="/feliz-cumpleanos-para-mi-esposo/">esposo</a> o en <a href="/categorias/#aniversarios">aniversarios de novios de 1 mes hasta más de 10 años</a>— la autenticidad nace de celebrar el equipo diario y los planes compartidos sin promesas grandilocuentes.
      </p>
      <p>
