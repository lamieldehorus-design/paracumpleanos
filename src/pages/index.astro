---
import Base from '../layouts/Base.astro';
import TarjetaMensaje from '../components/TarjetaMensaje.astro';
import AlertaMotivacionDiaria from '../components/AlertaMotivacionDiaria.astro';
import {
  catalogo,
  GRUPOS,
  hubs,
  todosMensajes,
  hubsPorGrupo,
  mensajesDe,
  nombreHub,
  SITIO,
  MARCA
} from '../lib/contenido.ts';
import { GUIAS_EDITORIALES } from '../data/guias.ts';
import { TEMAS_TARJETA } from '../lib/personalizador.ts';
import { ZODIACOS } from '../lib/horoscopo.ts';
import { PAISES_HITOS, HITOS_MUNDIALES } from '../data/hitos-historicos.ts';
import { rankearGuiasPorPopularidad, seleccionarPoolPopularMixto } from '../lib/popularidad.ts';
import { ETIQUETAS_SEGMENTOS, type SegmentoTono } from '../lib/editorial.ts';

// Pool mixto de las publicaciones mas populares de TODAS las categorias del sitio
const poolPopular = seleccionarPoolPopularMixto(catalogo, 32);
const segmentosHomeDisponibles: SegmentoTono[] = [
  'corto',
  'emotivo',
  'recuerdo',
  'gratitud',
  'reflexivo',
  'carta',
  'divertido',
  'fe',
  'formal',
  'duelo'
];
const filtrosHome = [
  { id: 'todos', label: 'Más populares', count: poolPopular.length },
  ...segmentosHomeDisponibles
    .map((seg) => ({
      id: seg,
      label: ETIQUETAS_SEGMENTOS[seg],
      count: poolPopular.filter((it) => it.segmentos.includes(seg)).length
    }))
    .filter((f) => f.count > 0)
];

// Guias ordenadas por popularidad (con re-ranking dinamico segun visitas acumuladas)
const guiasRankeadas = rankearGuiasPorPopularidad(GUIAS_EDITORIALES);
const guiasLead = guiasRankeadas[0];
const guiasSecundarias = guiasRankeadas.slice(1, 5);
const guiasIndiceJson = guiasRankeadas.map((g) => ({
  slug: g.slug,
  titulo: g.titulo,
  h1: g.h1,
  descripcion: g.descripcion,
  resumen: g.resumen,
  emoji: g.emoji,
  tiempoLectura: g.tiempoLectura,
  fechaPublicacion: g.fechaPublicacion,
  citaDestacada: g.citaDestacada,
  scoreBase: g.scorePopularidad
}));

// Indice liviano de todas las categorias + guias + hitos para el buscador universal del portal
const indiceBuscador = hubs
  .map((h) => ({
    titulo: nombreHub(h),
    slug: '/' + h.slug + '/',
    tipo: GRUPOS.find((g) => g.id === (h.grupo || 'destinatarios'))?.nombre || 'Categoría',
    emoji: h.emoji || '🎂',
    q: `${nombreHub(h)} ${h.destinatario || ''} ${h.keyword || ''} ${h.slug}`.toLowerCase()
  }))
  .concat(
    GUIAS_EDITORIALES.map((g) => ({
      titulo: g.titulo,
      slug: `/guias/${g.slug}/`,
      tipo: 'Guía práctica',
      emoji: g.emoji,
      q: `${g.titulo} ${g.resumen} ${g.slug}`.toLowerCase()
    }))
  )
  .concat([
    {
      titulo: 'Calculadora de edad, banderines para imprimir, acróstico, fecha de duelo y agenda .ics',
      slug: '/herramientas/',
      tipo: 'Herramienta',
      emoji: '🛠️',
      q: 'herramientas calculadora edad exacta dias vividos 10000 acrostico nombre armador dedicatoria agenda recordatorios ics banderines para imprimir bordes recortar fecha de duelo'.toLowerCase()
    },
    {
      titulo: 'Creador de banderines de cumpleaños para imprimir (A4)',
      slug: '/herramientas/#banderines-imprimir',
      tipo: 'Herramienta',
      emoji: '🎏',
      q: 'banderines de cumpleanos para imprimir gratis letras feliz cumpleanos happy birthday bordes plantilla a4 recortar'.toLowerCase()
    },
    {
      titulo: 'Calendario de fechas y celebraciones (sin año)',
      slug: '/calendario/',
      tipo: 'Calendario',
      emoji: '📅',
      q: 'calendario fechas celebraciones efemerides hoy dia mes hitos historicos signo motivacion duelo sin ano'.toLowerCase()
    },
    {
      titulo: `Hitos históricos mundiales: los ${PAISES_HITOS.length} países del mundo`,
      slug: '/hitos-historicos/',
      tipo: 'Hitos históricos',
      emoji: '🌍',
      q: 'hitos historicos mundiales paises independencia fiesta nacional fecha patria efemerides mundo historia'.toLowerCase()
    },
    {
      titulo: 'Horóscopo de cumpleaños: fechas, signos y meses del año',
      slug: '/horoscopo/',
      tipo: 'Horóscopo',
      emoji: '✨',
      q: 'horoscopo zodiaco signo fechas cumpleaños mes nacimiento'.toLowerCase()
    },
    ...ZODIACOS.map((s) => ({
      titulo: `Cumpleaños de ${s.nombre} (${s.rangoTexto})`,
      slug: `/horoscopo/${s.slug}/`,
      tipo: 'Signo zodiacal',
      emoji: s.simbolo,
      q: `horoscopo ${s.nombre} ${s.rangoTexto} ${s.mesesNombres.join(' ')} ${s.elemento}`.toLowerCase()
    })),
    ...PAISES_HITOS.map((p) => ({
      titulo: `${p.nombre}: ${p.hitoPrincipal.titulo} (${p.hitoPrincipal.dia}/${p.hitoPrincipal.mes})`,
      slug: `/hitos-historicos/${p.slug}/`,
      tipo: 'Hito histórico',
      emoji: p.bandera,
      q: `hito historico ${p.nombre} ${p.capital} ${p.hitoPrincipal.titulo} ${p.continente} fecha patria independencia`.toLowerCase()
    }))
  ]);

const temas = Object.values(TEMAS_TARJETA);
const totalPublicacionesPortal = todosMensajes.length + PAISES_HITOS.length + GUIAS_EDITORIALES.length;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: MARCA,
    url: SITIO + '/',
    inLanguage: 'es-AR',
    potentialAction: {
      '@type': 'SearchAction',
      target: SITIO + '/categorias/?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  }
];
---
<Base
  titulo="Mensajes de cumpleaños, cartas y calendario · ParaCumpleanos"
  descripcion={`Elegí entre ${hubs.length} colecciones y ${todosMensajes.length.toLocaleString('es-AR')} dedicatorias reales por vínculo, edad, aniversario o duelo. Personalizá con nombre y firma gratis antes de copiar.`}
  jsonld={jsonld}
  esPortal={true}
>
  <section class="portal-hero" aria-labelledby="portal-h1">
    <div class="portal-hero-texto">
      <p class="portal-kicker">
        Archivo editorial en español · {hubs.length} colecciones · {totalPublicacionesPortal.toLocaleString('es-AR')} textos originales · {PAISES_HITOS.length} países
      </p>
      <h1 id="portal-h1">Dedicatorias para cada vínculo, edad y fecha</h1>
      <p class="portal-sub">
        Encontrá cartas largas, saludos breves, aniversarios de pareja o palabras serenas de acompañamiento listas para adaptar con nombre propio y firma antes de copiarlas o imprimir.
      </p>

      <div class="portal-buscador-caja">
        <label for="portal-buscador" class="portal-buscador-label">Buscá por destinatario, país, aniversario, duelo o imprimible</label>
        <div class="portal-buscador-fila">
          <input
            id="portal-buscador"
            type="search"
            placeholder="Ej.: amiga, 5 años de novios, nostalgia, banderines, condolencias, Argentina…"
            autocomplete="off"
          />
          <a class="btn btn-copiar" href="#secciones-portal">Ver secciones</a>
        </div>
        <ul id="portal-resultados" class="portal-resultados" hidden></ul>
      </div>

      <div class="portal-necesidades" aria-label="Rutas rápidas según lo que necesitás hoy">
        <a class="portal-nec-card" href="/categorias/#destinatarios">
          <span class="portal-nec-titulo">Saludar a alguien querido</span>
          <span class="portal-nec-meta">Familia, pareja, amistades y trabajo</span>
        </a>
        <a class="portal-nec-card" href="/mas-de-10-anos-de-novios/">
          <span class="portal-nec-titulo">Celebrar meses o años juntos</span>
          <span class="portal-nec-meta">Aniversarios de 1 mes a +10 años</span>
        </a>
        <a class="portal-nec-card" href="/condolencias/">
          <span class="portal-nec-titulo">Acompañar duelos o nostalgia</span>
          <span class="portal-nec-meta">Pésame respetuoso y fecha de duelo</span>
        </a>
        <a class="portal-nec-card" href="/herramientas/#banderines-imprimir">
          <span class="portal-nec-titulo">Imprimir banderines o postales</span>
          <span class="portal-nec-meta">Plantillas A4 gratis y formato Story</span>
        </a>
      </div>

      <div class="portal-accesos-rapidos" aria-label="Accesos directos frecuentes">
        <span class="accesos-titulo">Accesos directos:</span>
        <a href="/feliz-cumpleanos-amiga/">Amiga</a>
        <span aria-hidden="true">·</span>
        <a href="/feliz-cumpleanos-mama/">Mamá</a>
        <span aria-hidden="true">·</span>
        <a href="/mas-de-10-anos-de-novios/">+10 años novios</a>
        <span aria-hidden="true">·</span>
        <a href="/banderines-de-cumpleanos-para-imprimir/">Banderines A4</a>
        <span aria-hidden="true">·</span>
        <a href="/frases-tristes-para-recordar-momentos/">Recuerdos</a>
        <span aria-hidden="true">·</span>
        <a href="/condolencias/">Condolencias</a>
        <span aria-hidden="true">·</span>
        <a href="/calendario/">Calendario</a>
        <span aria-hidden="true">·</span>
        <a href="/hitos-historicos/">Hitos históricos</a>
      </div>
    </div>

    <div class="portal-hero-studio" aria-label="Vista previa del personalizador de tarjetas">
      <p class="studio-etiqueta">Prueba en vivo · Escribí un nombre y mirá el cambio</p>
      <div class="tarjeta-visual studio-card" id="portal-preview-card">
        <div class="tarjeta-visual-emoji" aria-hidden="true">🎂</div>
        <p class="tarjeta-visual-titulo" id="studio-titulo">Para alguien que hace la diferencia</p>
        <p class="tarjeta-visual-extracto" id="studio-cuerpo">
          Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos.
        </p>
        <p class="tarjeta-visual-marca" id="studio-firma">paracumpleanos.com</p>
      </div>
      <div class="studio-controles">
        <div class="studio-inputs">
          <input id="studio-nombre" type="text" maxlength="32" placeholder="Nombre (ej.: Laura)" aria-label="Nombre de quien cumple años" />
          <input id="studio-mi-firma" type="text" maxlength="32" placeholder="Tu firma (ej.: Sofi)" aria-label="Tu firma" />
        </div>
        <div class="studio-temas" role="group" aria-label="Estilo de tarjeta">
          {temas.map(function (t, i) {
            return (
              <button
                type="button"
                class={'pers-tema-btn' + (i === 0 ? ' activo' : '')}
                data-studio-tema={t.id}
                data-fondo={t.fondoCss}
                data-borde={t.borde}
                data-acento={t.acento}
              >
                <span class="pers-swatch" style={`background:${t.fondoCss};border-color:${t.borde}`}></span>
                <span>{t.nombre}</span>
              </button>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="portal-herramientas-tira" aria-label="Calendario, hitos históricos, condolencias y herramientas">
    <a class="portal-util-card" href="/calendario/">
      <span class="portal-util-kicker">Sin año · 366 días</span>
      <span class="portal-util-titulo">Calendario de fechas</span>
      <span class="portal-util-desc">Efemérides, hitos mundiales, signo y fecha de duelo por día y mes.</span>
    </a>
    <a class="portal-util-card" href="/hitos-historicos/">
      <span class="portal-util-kicker">{PAISES_HITOS.length} países del mundo</span>
      <span class="portal-util-titulo">Hitos históricos mundiales</span>
      <span class="portal-util-desc">Fiestas nacionales, contexto cívico y tradiciones de cada país.</span>
    </a>
    <a class="portal-util-card" href="/condolencias/">
      <span class="portal-util-kicker">Acompañamiento sereno</span>
      <span class="portal-util-titulo">Condolencias y duelo</span>
      <span class="portal-util-desc">50 mensajes sobrios de pésame y recordatorio anual .ics.</span>
    </a>
    <a class="portal-util-card" href="/mas-de-10-anos-de-novios/">
      <span class="portal-util-kicker">11 a 80 años a medida</span>
      <span class="portal-util-titulo">Aniversario +10 años</span>
      <span class="portal-util-desc">Elegí los años juntos y adaptá 50 dedicatorias en el acto.</span>
    </a>
    <a class="portal-util-card" href="/herramientas/#banderines-imprimir">
      <span class="portal-util-kicker">Imprimible gratis A4</span>
      <span class="portal-util-titulo">Banderines para imprimir</span>
      <span class="portal-util-desc">Armá guirnaldas por nombre con bordes listos para recortar.</span>
    </a>
    <a class="portal-util-card" href="/herramientas/">
      <span class="portal-util-kicker">Herramientas gratuitas</span>
      <span class="portal-util-titulo">Edad exacta, acróstico e .ics</span>
      <span class="portal-util-desc">Días vividos, hito de 10.000 días, acrósticos y agenda local.</span>
    </a>
  </section>

  <section class="portal-metodo-linea" aria-labelledby="titulo-metodo-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Método editorial · 30 segundos</p>
        <h2 id="titulo-metodo-portal">Cómo personalizar un saludo sin sonar genérico</h2>
      </div>
      <a class="enlace-directorio" href="/guias/como-escribir-una-carta-de-cumpleanos-que-emocione/">Ver guía completa →</a>
    </div>
    <div class="metodo-linea-grid">
      <div class="metodo-linea-contraste">
        <p class="metodo-linea-evitar"><strong>Evitá el molde vacío:</strong> “Feliz cumpleaños, que pases un hermoso día junto a los tuyos.”</p>
        <p class="metodo-linea-funciona"><strong>Sumá una escena real:</strong> “Laura, gracias por bancarme con mates aquel martes de cierre. Que este año te regale mañanas tranquilas y ese viaje al sur. — Sofi”</p>
      </div>
      <ol class="metodo-linea-pasos">
        <li><strong>1. Detalle concreto:</strong> mencioná una charla reciente o algo que admirás hoy.</li>
        <li><strong>2. Deseo situado:</strong> salud, descanso firme o un proyecto claro para su etapa.</li>
        <li><strong>3. Tono acorde:</strong> cercanía cotidiana para amigos y respeto sobrio en <a href="/condolencias/">duelo o condolencias</a>.</li>
      </ol>
    </div>
  </section>

  <section id="secciones-portal" class="portal-banda" aria-labelledby="titulo-secciones-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Mapa completo del archivo</p>
        <h2 id="titulo-secciones-portal">Categorías por vínculo, edad, fecha e hitos del mundo</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Ver directorio ({hubs.length} categorías) →</a>
    </div>

    <div class="portal-secciones-grid">
      {GRUPOS.map(function (g) {
        const lista = hubsPorGrupo.get(g.id) || [];
        if (!lista.length) return null;
        const destacadas = lista.slice(0, 6);
        const totalMsgsGrupo = lista.reduce((acc, h) => acc + mensajesDe(h.slug).length, 0);
        return (
          <article class="portal-seccion-card">
            <div class="portal-seccion-top">
              <h3><a href={`/categorias/#${g.id}`}>{g.emoji} {g.nombre}</a></h3>
              <p class="card-meta">
                <span>{lista.length} colecciones</span>
                <span aria-hidden="true">·</span>
                <span>{totalMsgsGrupo.toLocaleString('es-AR')} textos</span>
              </p>
            </div>
            <ul class="portal-seccion-links">
              {destacadas.map(function (h) {
                return (
                  <li>
                    <a href={'/' + h.slug + '/'}>{nombreHub(h)}</a>
                  </li>
                );
              })}
            </ul>
            <p class="portal-seccion-pie">
              <a href={`/categorias/#${g.id}`}>Explorar todas en {g.nombre} ({lista.length}) →</a>
            </p>
          </article>
        );
      })}

      <article class="portal-seccion-card">
        <div class="portal-seccion-top">
          <h3><a href="/hitos-historicos/">🌍 Hitos históricos mundiales y Calendario</a></h3>
          <p class="card-meta">
            <span>{PAISES_HITOS.length} países + {HITOS_MUNDIALES.length} globales</span>
            <span aria-hidden="true">·</span>
            <span>366 días sin año</span>
          </p>
        </div>
        <ul class="portal-seccion-links">
          <li><a href="/calendario/">Calendario perpetuo (sin año)</a></li>
          <li><a href="/hitos-historicos/">Todos los {PAISES_HITOS.length} países del mundo</a></li>
          <li><a href="/hitos-historicos/argentina/">Argentina · 9 de julio</a></li>
          <li><a href="/hitos-historicos/mexico/">México · 16 de septiembre</a></li>
          <li><a href="/hitos-historicos/espana/">España · 12 de octubre</a></li>
          <li><a href="/horoscopo/">Horóscopo de cumpleaños (12 signos)</a></li>
        </ul>
        <p class="portal-seccion-pie">
          <a href="/hitos-historicos/">Explorar los {PAISES_HITOS.length} hitos históricos →</a>
        </p>
      </article>
    </div>
  </section>

  <section class="portal-banda portal-banda-guias" aria-labelledby="titulo-guias-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Más visitadas y revisadas</p>
        <h2 id="titulo-guias-portal">Guías prácticas para escribir y celebrar mejor</h2>
      </div>
      <a class="enlace-directorio" href="/guias/">Leer las {GUIAS_EDITORIALES.length} guías →</a>
    </div>

    <div class="portal-guias-salience" id="portal-guias-populares">
      <article class="guia-destacada" id="guia-popular-lead">
        <p class="card-meta">
          <span id="guia-lead-etiqueta">{guiasLead.emoji} Guía más visitada</span>
          <span aria-hidden="true">·</span>
          <span id="guia-lead-tiempo">{guiasLead.tiempoLectura}</span>
          <span aria-hidden="true">·</span>
          <time id="guia-lead-fecha" datetime={guiasLead.fechaPublicacion}>{guiasLead.fechaPublicacion}</time>
        </p>
        <h3><a id="guia-lead-link" href={`/guias/${guiasLead.slug}/`}>{guiasLead.h1}</a></h3>
        <p id="guia-lead-desc">{guiasLead.descripcion}</p>
        <blockquote class="cita-editorial" id="guia-lead-cita">
          {guiasLead.citaDestacada}
        </blockquote>
        <p class="guia-leer"><a id="guia-lead-cta" href={`/guias/${guiasLead.slug}/`}>Abrir guía completa paso a paso →</a></p>
      </article>

      <div class="guias-secundarias-lista" id="guias-populares-lista">
        {guiasSecundarias.map(function (g) {
          return (
            <article class="guia-fila">
              <p class="card-meta">
                <span>{g.emoji} {g.tiempoLectura}</span>
                <span aria-hidden="true">·</span>
                <time datetime={g.fechaPublicacion}>{g.fechaPublicacion}</time>
              </p>
              <h3><a href={`/guias/${g.slug}/`}>{g.titulo}</a></h3>
              <p>{g.resumen}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <AlertaMotivacionDiaria />

  <section class="portal-banda" aria-labelledby="titulo-muestra-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Selección transversal · Mezcla de todo el portal</p>
        <h2 id="titulo-muestra-portal">Dedicatorias populares según el momento que atravesás</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Explorar las {todosMensajes.length.toLocaleString('es-AR')} publicaciones →</a>
    </div>

    <div class="filtros-tono" role="toolbar" aria-label="Filtrar textos populares de todas las categorías por estilo">
      {filtrosHome.map(function (f, idx) {
        return (
          <button
            type="button"
            class={'filtro-btn' + (idx === 0 ? ' activo' : '')}
            data-home-filtro={f.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {f.label} ({f.count})
          </button>
        );
      })}
    </div>

    <div class="grilla" id="home-muestra-grilla">
      {poolPopular.map(function (it, idx) {
        return (
          <div class="home-pub-slot" data-home-idx={idx} data-home-slug={it.mensaje.slug} data-home-score={it.scoreBase} data-home-segmentos={it.segmentos.join(',')} style={idx >= 6 ? 'display:none' : undefined}>
            <TarjetaMensaje m={it.mensaje} hub={it.hub} mostrarCategoria={true} scoreBase={it.scoreBase} />
          </div>
        );
      })}
    </div>

    <div class="home-mas-wrap">
      <button type="button" class="btn btn-copiar home-mas-btn" id="home-ver-mas-populares">
        Mostrar más publicaciones populares ({poolPopular.length - 6} más)
      </button>
    </div>
  </section>

  <section class="portal-estandares" aria-labelledby="titulo-criterio-portal">
    <h2 id="titulo-criterio-portal">Criterio editorial y contacto directo</h2>
    <div class="estandares-grid">
      <div class="estandar-item">
        <h3>01. {totalPublicacionesPortal.toLocaleString('es-AR')} textos originales sin copias</h3>
        <p>Cada dedicatoria, guía y reseña histórica pasa control de similitud antes de entrar al archivo. Podés sugerir mejoras o escribirnos a <a href="mailto:lamieldehorus@gmail.com">lamieldehorus@gmail.com</a> desde <a href="/contacto/">Contacto</a>.</p>
      </div>
      <div class="estandar-item">
        <h3>02. Separación estricta de tonos</h3>
        <p>Mantenemos aparte cumpleaños, aniversarios de pareja, entornos laborales, duelo y efemérides patrias para evitar cruces incómodos.</p>
      </div>
      <div class="estandar-item">
        <h3>03. Transparencia editorial y privacidad</h3>
        <p>Personalizás tarjetas en {temas.length} paletas, banderines A4 o recordatorios .ics desde el navegador sin registro previo. Leé más en <a href="/sobre-nosotros/">Sobre nosotros</a> y <a href="/privacidad/">Privacidad</a>.</p>
      </div>
    </div>
  </section>

  <script id="portal-indice-json" type="application/json" set:html={JSON.stringify(indiceBuscador)} />
  <script id="portal-guias-json" type="application/json" set:html={JSON.stringify(guiasIndiceJson)} />
  <script is:inline>
    (function () {
      var inputBusq = document.getElementById('portal-buscador');
      var listaRes = document.getElementById('portal-resultados');
      var dataEl = document.getElementById('portal-indice-json');
      var indice = [];
      try {
        indice = JSON.parse((dataEl && dataEl.textContent) || '[]');
      } catch (e) {}

      function norm(s) {
        return String(s || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
      }

      var indiceNorm = indice.map(function (item) {
        return {
          titulo: item.titulo,
          slug: item.slug,
          tipo: item.tipo,
          emoji: item.emoji,
          q: norm(item.q)
        };
      });

      if (inputBusq && listaRes) {
        inputBusq.addEventListener('input', function () {
          var q = norm(inputBusq.value.trim());
          listaRes.innerHTML = '';
          if (q.length < 2) {
            listaRes.hidden = true;
            return;
          }
          var hits = [];
          for (var i = 0; i < indiceNorm.length && hits.length < 8; i++) {
            if (indiceNorm[i].q.indexOf(q) !== -1) hits.push(indiceNorm[i]);
          }
          listaRes.hidden = false;
          if (!hits.length) {
            var liVacio = document.createElement('li');
            liVacio.className = 'portal-res-vacio';
            liVacio.innerHTML = 'No encontramos coincidencias directas. <a href="/categorias/">Explorá todas las categorías →</a>';
            listaRes.appendChild(liVacio);
            return;
          }
          hits.forEach(function (h) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = h.slug;
            a.innerHTML = '<span>' + h.emoji + ' ' + h.titulo + '</span><span class="portal-res-tipo">' + h.tipo + '</span>';
            li.appendChild(a);
            listaRes.appendChild(li);
          });
        });
      }

      // Estudio rapido en el Hero
      var studioNom = document.getElementById('studio-nombre');
      var studioFir = document.getElementById('studio-mi-firma');
      var studioTit = document.getElementById('studio-titulo');
      var studioCue = document.getElementById('studio-cuerpo');
      var studioMar = document.getElementById('studio-firma');
      var previewCard = document.getElementById('portal-preview-card');
      var baseCuerpo = 'Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos.';

      function actualizarStudio() {
        var nom = (studioNom && studioNom.value || '').trim();
        var fir = (studioFir && studioFir.value || '').trim();
        if (studioTit) studioTit.textContent = nom ? '¡Feliz cumpleaños, ' + nom + '!' : 'Para alguien que hace la diferencia';
        if (studioCue) studioCue.textContent = nom ? nom + ', ' + baseCuerpo.charAt(0).toLowerCase() + baseCuerpo.slice(1) : baseCuerpo;
        if (studioMar) studioMar.textContent = fir ? '— ' + fir + ' · paracumpleanos.com' : 'paracumpleanos.com';
      }
      if (studioNom) studioNom.addEventListener('input', actualizarStudio);
      if (studioFir) studioFir.addEventListener('input', actualizarStudio);

      document.querySelectorAll('[data-studio-tema]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('[data-studio-tema]').forEach(function (b) { b.classList.remove('activo'); });
          btn.classList.add('activo');
          if (previewCard) {
            previewCard.style.background = btn.getAttribute('data-fondo');
            previewCard.style.borderColor = btn.getAttribute('data-borde');
          }
          if (studioTit) studioTit.style.color = btn.getAttribute('data-acento');
        });
      });

      // Re-ranking dinamico de "Guias practicas..." segun visitas acumuladas
      try {
        var visitasGuias = JSON.parse(localStorage.getItem('pc_visitas_guias_v1') || '{}');
        var guiasDataEl = document.getElementById('portal-guias-json');
        if (visitasGuias && Object.keys(visitasGuias).length > 0 && guiasDataEl) {
          var todasGuias = JSON.parse(guiasDataEl.textContent || '[]');
          todasGuias.sort(function (a, b) {
            var sa = Number(a.scoreBase || 0) + Number(visitasGuias[a.slug] || 0) * 25;
            var sb = Number(b.scoreBase || 0) + Number(visitasGuias[b.slug] || 0) * 25;
            return sb - sa;
          });
          var topLead = todasGuias[0];
          var topSec = todasGuias.slice(1, 5);
          if (topLead) {
            var elEt = document.getElementById('guia-lead-etiqueta');
            var elTi = document.getElementById('guia-lead-tiempo');
            var elFe = document.getElementById('guia-lead-fecha');
            var elLk = document.getElementById('guia-lead-link');
            var elDe = document.getElementById('guia-lead-desc');
            var elCi = document.getElementById('guia-lead-cita');
            var elCt = document.getElementById('guia-lead-cta');
            if (elEt) elEt.textContent = topLead.emoji + ' Guía más visitada';
            if (elTi) elTi.textContent = topLead.tiempoLectura;
            if (elFe) { elFe.textContent = topLead.fechaPublicacion; elFe.setAttribute('datetime', topLead.fechaPublicacion); }
            if (elLk) { elLk.href = '/guias/' + topLead.slug + '/'; elLk.textContent = topLead.h1; }
            if (elDe) elDe.textContent = topLead.descripcion;
            if (elCi) elCi.textContent = topLead.citaDestacada;
            if (elCt) elCt.href = '/guias/' + topLead.slug + '/';
          }
          var secCont = document.getElementById('guias-populares-lista');
          if (secCont && topSec.length) {
            secCont.innerHTML = '';
            topSec.forEach(function (g) {
              var art = document.createElement('article');
              art.className = 'guia-fila';
              var meta = document.createElement('p');
              meta.className = 'card-meta';
              meta.innerHTML = '<span>' + g.emoji + ' ' + g.tiempoLectura + '</span><span aria-hidden="true">·</span><time datetime="' + g.fechaPublicacion + '">' + g.fechaPublicacion + '</time>';
              var h3 = document.createElement('h3');
              var a = document.createElement('a');
              a.href = '/guias/' + g.slug + '/';
              a.textContent = g.titulo;
              h3.appendChild(a);
              var p = document.createElement('p');
              p.textContent = g.resumen;
              art.appendChild(meta);
              art.appendChild(h3);
              art.appendChild(p);
              secCont.appendChild(art);
            });
          }
        }
      } catch (_) {}

      // Ranking dinamico + filtros multi-segmento + "Ver mas" en Textos populares mixtos
      var homeBtns = document.querySelectorAll('[data-home-filtro]');
      var homeGrilla = document.getElementById('home-muestra-grilla');
      var btnVerMas = document.getElementById('home-ver-mas-populares');
      var filtroActivo = 'todos';
      var expandido = false;

      if (homeGrilla) {
        try {
          var popMap = JSON.parse(localStorage.getItem('pc_popularidad_pubs_v1') || '{}');
          if (popMap && Object.keys(popMap).length > 0) {
            var slots = Array.prototype.slice.call(homeGrilla.querySelectorAll('.home-pub-slot'));
            slots.sort(function (a, b) {
              var sa = Number(a.getAttribute('data-home-score') || 0) + Number(popMap[a.getAttribute('data-home-slug') || ''] || 0) * 12;
              var sb = Number(b.getAttribute('data-home-score') || 0) + Number(popMap[b.getAttribute('data-home-slug') || ''] || 0) * 12;
              return sb - sa;
            });
            slots.forEach(function (s) { homeGrilla.appendChild(s); });
          }
        } catch (_) {}

        function refrescarPopularesHome() {
          var slots = homeGrilla.querySelectorAll('.home-pub-slot');
          var visibles = 0;
          var totalCoinc = 0;
          slots.forEach(function (slot) {
            var segs = (slot.getAttribute('data-home-segmentos') || '').split(',');
            var match = filtroActivo === 'todos' || segs.indexOf(filtroActivo) !== -1;
            if (!match) {
              slot.style.display = 'none';
              return;
            }
            totalCoinc++;
            var limite = filtroActivo === 'todos' && !expandido ? 6 : 99;
            if (visibles < limite) {
              slot.style.display = '';
              visibles++;
            } else {
              slot.style.display = 'none';
            }
          });
          if (btnVerMas) {
            if (filtroActivo === 'todos' && !expandido && totalCoinc > 6) {
              btnVerMas.hidden = false;
              btnVerMas.textContent = 'Mostrar más publicaciones populares (' + (totalCoinc - 6) + ' más)';
            } else if (filtroActivo === 'todos' && expandido && totalCoinc > 6) {
              btnVerMas.hidden = false;
              btnVerMas.textContent = 'Mostrar solo las 6 principales';
            } else {
              btnVerMas.hidden = true;
            }
          }
        }

        homeBtns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            filtroActivo = btn.getAttribute('data-home-filtro') || 'todos';
            homeBtns.forEach(function (b) {
              var ac = b === btn;
              b.classList.toggle('activo', ac);
              b.setAttribute('aria-pressed', ac ? 'true' : 'false');
            });
            refrescarPopularesHome();
          });
        });

        if (btnVerMas) {
          btnVerMas.addEventListener('click', function () {
            expandido = !expandido;
            refrescarPopularesHome();
          });
        }

        refrescarPopularesHome();
      }
    })();
  </script>
</Base>
