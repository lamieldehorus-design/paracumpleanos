---
import Base from '../layouts/Base.astro';
import TarjetaMensaje from '../components/TarjetaMensaje.astro';
import AlertaMotivacionDiaria from '../components/AlertaMotivacionDiaria.astro';
import {
  catalogo,
  GRUPOS,
  hubs,
  todosMensajes,
  hubsPorGrupo,
  mensajesDe,
  nombreHub,
  SITIO,
  MARCA
} from '../lib/contenido.ts';
import { GUIAS_EDITORIALES } from '../data/guias.ts';
import { TEMAS_TARJETA } from '../lib/personalizador.ts';
import { ZODIACOS } from '../lib/horoscopo.ts';
import { PAISES_HITOS, HITOS_MUNDIALES } from '../data/hitos-historicos.ts';
import { rankearGuiasPorPopularidad, seleccionarPoolPopularMixto } from '../lib/popularidad.ts';
import { ETIQUETAS_SEGMENTOS, type SegmentoTono } from '../lib/editorial.ts';
import {
  ACCESOS_RAPIDOS_PORTADA,
  BLOQUES_PORTADA_GSC,
  ordenarHubsPorDemandaGsc,
  etiquetaCortaGsc
} from '../lib/gsc-estrategia.ts';

// Pool mixto de las publicaciones mas populares de TODAS las categorias del sitio
const poolPopular = seleccionarPoolPopularMixto(catalogo, 32);
const segmentosHomeDisponibles: SegmentoTono[] = [
  'corto',
  'emotivo',
  'recuerdo',
  'gratitud',
  'reflexivo',
  'carta',
  'divertido',
  'fe',
  'formal',
  'duelo'
];
const filtrosHome = [
  { id: 'todos', label: 'Más populares', count: poolPopular.length },
  ...segmentosHomeDisponibles
    .map((seg) => ({
      id: seg,
      label: ETIQUETAS_SEGMENTOS[seg],
      count: poolPopular.filter((it) => it.segmentos.includes(seg)).length
    }))
    .filter((f) => f.count > 0)
];

// Guias ordenadas por popularidad (con re-ranking dinamico segun visitas acumuladas)
const guiasRankeadas = rankearGuiasPorPopularidad(GUIAS_EDITORIALES);
const guiasLead = guiasRankeadas[0];
const guiasSecundarias = guiasRankeadas.slice(1, 5);
const guiasIndiceJson = guiasRankeadas.map((g) => ({
  slug: g.slug,
  titulo: g.titulo,
  h1: g.h1,
  descripcion: g.descripcion,
  resumen: g.resumen,
  emoji: g.emoji,
  tiempoLectura: g.tiempoLectura,
  fechaPublicacion: g.fechaPublicacion,
  citaDestacada: g.citaDestacada,
  scoreBase: g.scorePopularidad
}));

// Indice liviano de todas las categorías + guías + hitos para el buscador universal del portal
const indiceBuscador = hubs
  .map((h) => ({
    titulo: nombreHub(h),
    slug: '/' + h.slug + '/',
    tipo: GRUPOS.find((g) => g.id === (h.grupo || 'destinatarios'))?.nombre || 'Categoría',
    emoji: h.emoji || '🎂',
    q: `${nombreHub(h)} ${h.destinatario || ''} ${h.keyword || ''} ${h.slug}`.toLowerCase()
  }))
  .concat(
    GUIAS_EDITORIALES.map((g) => ({
      titulo: g.titulo,
      slug: `/guias/${g.slug}/`,
      tipo: 'Guía práctica',
      emoji: g.emoji,
      q: `${g.titulo} ${g.resumen} ${g.slug}`.toLowerCase()
    }))
  )
  .concat([
    {
      titulo: 'Calculadora de edad, banderines para imprimir, acróstico, fecha de duelo y agenda .ics',
      slug: '/herramientas/',
      tipo: 'Herramienta',
      emoji: '🛠️',
      q: 'herramientas calculadora edad exacta dias vividos 10000 acrostico nombre armador dedicatoria agenda recordatorios ics banderines para imprimir bordes recortar fecha de duelo'.toLowerCase()
    },
    {
      titulo: 'Creador de banderines de cumpleaños para imprimir (A4)',
      slug: '/herramientas/#banderines-imprimir',
      tipo: 'Herramienta',
      emoji: '🎏',
      q: 'banderines de cumpleanos para imprimir gratis letras feliz cumpleanos happy birthday bordes plantilla a4 recortar'.toLowerCase()
    },
    {
      titulo: 'Calendario de fechas y celebraciones (sin año)',
      slug: '/calendario/',
      tipo: 'Calendario',
      emoji: '📅',
      q: 'calendario fechas celebraciones efemerides hoy dia mes hitos historicos signo motivacion duelo sin ano'.toLowerCase()
    },
    {
      titulo: `Hitos históricos mundiales: los ${PAISES_HITOS.length} países del mundo`,
      slug: '/hitos-historicos/',
      tipo: 'Hitos históricos',
      emoji: '🌍',
      q: 'hitos historicos mundiales paises independencia fiesta nacional fecha patria efemerides mundo historia'.toLowerCase()
    },
    {
      titulo: 'Horóscopo de cumpleaños: fechas, signos y meses del año',
      slug: '/horoscopo/',
      tipo: 'Horóscopo',
      emoji: '✨',
      q: 'horoscopo zodiaco signo fechas cumpleaños mes nacimiento'.toLowerCase()
    },
    ...ZODIACOS.map((s) => ({
      titulo: `Cumpleaños de ${s.nombre} (${s.rangoTexto})`,
      slug: `/horoscopo/${s.slug}/`,
      tipo: 'Signo zodiacal',
      emoji: s.simbolo,
      q: `horoscopo ${s.nombre} ${s.rangoTexto} ${s.mesesNombres.join(' ')} ${s.elemento}`.toLowerCase()
    })),
    ...PAISES_HITOS.map((p) => ({
      titulo: `${p.nombre}: ${p.hitoPrincipal.titulo} (${p.hitoPrincipal.dia}/${p.hitoPrincipal.mes})`,
      slug: `/hitos-historicos/${p.slug}/`,
      tipo: 'Hito histórico',
      emoji: p.bandera,
      q: `hito historico ${p.nombre} ${p.capital} ${p.hitoPrincipal.titulo} ${p.continente} fecha patria independencia`.toLowerCase()
    }))
  ]);

const temas = Object.values(TEMAS_TARJETA);
const totalPublicacionesPortal = todosMensajes.length + PAISES_HITOS.length + GUIAS_EDITORIALES.length;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: MARCA,
    url: SITIO + '/',
    inLanguage: 'es-AR',
    potentialAction: {
      '@type': 'SearchAction',
      target: SITIO + '/categorias/?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  }
];
---
<Base
  titulo="Frases y mensajes de feliz cumpleaños, postales y calendario - ParaCumpleanos"
  descripcion={`Buscá entre ${hubs.length} colecciones, ${todosMensajes.length.toLocaleString('es-AR')} frases de feliz cumpleaños, condolencias, nostalgia, aniversarios, banderines A4, calendario sin año y ${PAISES_HITOS.length} hitos históricos mundiales.`}
  jsonld={jsonld}
  esPortal={true}
>
  <section class="portal-hero" aria-labelledby="portal-h1">
    <div class="portal-hero-texto">
      <p class="portal-kicker">
        Portal editorial en español · {hubs.length} colecciones · {totalPublicacionesPortal.toLocaleString('es-AR')} publicaciones únicas · {PAISES_HITOS.length} países
      </p>
      <h1 id="portal-h1">Frases y mensajes reales para cada cumpleaños, fecha y recuerdo</h1>
      <p class="portal-sub">
        Elegí entre {hubs.length} colecciones de feliz cumpleaños, aniversarios de 1 mes a +10 años personalizables, condolencias, nostalgia y banderines A4 para imprimir, o explorá el calendario anual con los hitos históricos de los {PAISES_HITOS.length} países.
      </p>

      <div class="portal-buscador-caja">
        <label for="portal-buscador" class="portal-buscador-label">Buscá destinatario, país, banderines, condolencias, aniversario o fecha en toda la web</label>
        <div class="portal-buscador-fila">
          <input
            id="portal-buscador"
            type="search"
            placeholder="Ej.: amiga, 5 años de novios, nostalgia, banderines, condolencias, Argentina…"
            autocomplete="off"
          />
          <a class="btn btn-copiar" href="#secciones-portal">Explorar secciones</a>
        </div>
        <ul id="portal-resultados" class="portal-resultados" hidden></ul>
      </div>

      <div class="portal-accesos-rapidos" aria-label="Accesos directos frecuentes">
        <span class="accesos-titulo">Más buscados hoy:</span>
        {ACCESOS_RAPIDOS_PORTADA.map(function (acc, idx) {
          return (
            <>
              {idx > 0 ? <span aria-hidden="true">·</span> : null}
              <a href={acc.href}>{acc.label}</a>
            </>
          );
        })}
      </div>
    </div>

    <div class="portal-hero-studio" aria-label="Vista previa del personalizador de tarjetas">
      <p class="studio-etiqueta">Estudio rápido · Probá personalizar acá mismo</p>
      <div
        class="tarjeta-visual studio-card"
        id="portal-preview-card"
        data-tema-inicio={temas[0].gradInicio}
        data-tema-medio={temas[0].gradMedio}
        data-tema-fin={temas[0].gradFin}
        data-tema-borde={temas[0].borde}
        data-tema-acento={temas[0].acento}
      >
        <div class="tarjeta-visual-emoji" aria-hidden="true">🎂</div>
        <p class="tarjeta-visual-titulo" id="studio-titulo">Para alguien que hace la diferencia</p>
        <p class="tarjeta-visual-extracto" id="studio-cuerpo">
          Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos.
        </p>
        <p class="tarjeta-visual-marca" id="studio-firma">paracumpleanos.com</p>
      </div>
      <div class="studio-controles">
        <div class="studio-inputs">
          <input id="studio-nombre" type="text" maxlength="32" placeholder="Nombre (ej.: Laura)" aria-label="Nombre de quien cumple años" />
          <input id="studio-mi-firma" type="text" maxlength="32" placeholder="Tu firma (ej.: Sofi)" aria-label="Tu firma" />
        </div>
        <div class="studio-temas" role="group" aria-label="Estilo de tarjeta">
          {temas.map(function (t, i) {
            return (
              <button
                type="button"
                class={'pers-tema-btn' + (i === 0 ? ' activo' : '')}
                data-studio-tema={t.id}
                data-fondo={t.fondoCss}
                data-inicio={t.gradInicio}
                data-medio={t.gradMedio}
                data-fin={t.gradFin}
                data-borde={t.borde}
                data-acento={t.acento}
              >
                <span class="pers-swatch" style={`background:${t.fondoCss};border-color:${t.borde}`}></span>
                <span>{t.nombre}</span>
              </button>
            );
          })}
        </div>
        <div class="studio-acciones">
          <button
            type="button"
            id="studio-btn-copiar"
            class="btn btn-copiar btn-sm"
            data-text="Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos."
          >
            Copiar texto
          </button>
          <button
            type="button"
            id="studio-btn-png"
            class="btn btn-descargar btn-sm"
            data-title="Para alguien que hace la diferencia"
            data-mostrar-titulo="1"
            data-body="Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos."
            data-emoji="🎂"
          >
            Descargar PNG
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="portal-herramientas-tira" aria-label="Calendario, hitos históricos, condolencias y herramientas">
    <a class="portal-util-card" href="/calendario/">
      <span class="portal-util-kicker">Sin año · 366 días</span>
      <span class="portal-util-titulo">📅 Calendario universal de fechas</span>
      <span class="portal-util-desc">Elegí cualquier día y mes para ver celebraciones, hitos históricos, signo zodiacal, motivación y fecha de duelo.</span>
    </a>
    <a class="portal-util-card" href="/hitos-historicos/">
      <span class="portal-util-kicker">{PAISES_HITOS.length} países del mundo</span>
      <span class="portal-util-titulo">🌍 Hitos históricos mundiales</span>
      <span class="portal-util-desc">Descubrí qué celebra cada país en su fiesta nacional o independencia, su historia, tradiciones y saludos.</span>
    </a>
    <a class="portal-util-card" href="/condolencias/">
      <span class="portal-util-kicker">Acompañamiento respetuoso</span>
      <span class="portal-util-titulo">🕊️ Condolencias y fecha de duelo</span>
      <span class="portal-util-desc">50 mensajes sobrios de pésame, nostalgia y selector interactivo para honrar una fecha de duelo con alerta anual .ics.</span>
    </a>
    <a class="portal-util-card" href="/mas-de-10-anos-de-novios/">
      <span class="portal-util-kicker">11 a 80 años a medida</span>
      <span class="portal-util-titulo">💞 Aniversario +10 años personalizable</span>
      <span class="portal-util-desc">Elegí el número exacto de años juntos y adaptá al instante 50 frases y cartas, además de los 1–11 meses y 1–10 años.</span>
    </a>
    <a class="portal-util-card" href="/herramientas/#banderines-imprimir">
      <span class="portal-util-kicker">Imprimible gratis A4</span>
      <span class="portal-util-titulo">🎏 Banderines para imprimir</span>
      <span class="portal-util-desc">Armá banderines de feliz cumpleaños con el nombre que quieras, bordes para recortar y descarga lista para A4.</span>
    </a>
    <a class="portal-util-card" href="/herramientas/">
      <span class="portal-util-kicker">Herramientas gratuitas</span>
      <span class="portal-util-titulo">🎂 Edad exacta, acróstico y agenda .ics</span>
      <span class="portal-util-desc">Calculá días vividos e hito de 10.000 días, creá acrósticos por nombre y descargá alertas anuales.</span>
    </a>
  </section>

  <section class="portal-banda portal-top-gsc" aria-labelledby="titulo-top-gsc">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Selección directa según lo que más buscan los lectores</p>
        <h2 id="titulo-top-gsc">Lo más buscado ahora en cumpleaños</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Ver todas las {hubs.length} colecciones →</a>
    </div>
    <div class="portal-top-gsc-grid">
      {BLOQUES_PORTADA_GSC.map(function (bloque) {
        return (
          <article class="portal-gsc-col">
            <h3><span aria-hidden="true">{bloque.emoji}</span> {bloque.titulo}</h3>
            <p class="portal-gsc-sub">{bloque.subtitulo}</p>
            <ul class="portal-gsc-links">
              {bloque.slugs.map(function (sl) {
                const h = catalogo.hubsPorSlug.get(sl);
                if (!h) return null;
                const cant = mensajesDe(sl).length;
                return (
                  <li>
                    <a href={'/' + sl + '/'}>
                      <span>{etiquetaCortaGsc(sl, h)}</span>
                      <span class="portal-gsc-count">{cant}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </article>
        );
      })}
    </div>
  </section>

  <AlertaMotivacionDiaria />

  <section id="secciones-portal" class="portal-banda" aria-labelledby="titulo-secciones-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Mapa completo del portal</p>
        <h2 id="titulo-secciones-portal">Navegá las {GRUPOS.length} secciones temáticas ({hubs.length} colecciones) + Hitos del Mundo</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Ver directorio completo ({hubs.length} categorías) →</a>
    </div>

    <div class="portal-secciones-grid">
      {GRUPOS.map(function (g) {
        const lista = hubsPorGrupo.get(g.id) || [];
        if (!lista.length) return null;
        const destacadas = ordenarHubsPorDemandaGsc(lista).slice(0, 6);
        const totalMsgsGrupo = lista.reduce((acc, h) => acc + mensajesDe(h.slug).length, 0);
        return (
          <article class="portal-seccion-card">
            <div class="portal-seccion-top">
              <h3><a href={`/categorias/#${g.id}`}>{g.emoji} {g.nombre}</a></h3>
              <p class="card-meta">
                <span>{lista.length} colecciones</span>
                <span aria-hidden="true">·</span>
                <span>{totalMsgsGrupo.toLocaleString('es-AR')} textos</span>
              </p>
            </div>
            <ul class="portal-seccion-links">
              {destacadas.map(function (h) {
                return (
                  <li>
                    <a href={'/' + h.slug + '/'}>{nombreHub(h)}</a>
                  </li>
                );
              })}
            </ul>
            <p class="portal-seccion-pie">
              <a href={`/categorias/#${g.id}`}>Explorar todas en {g.nombre} ({lista.length}) →</a>
            </p>
          </article>
        );
      })}

      <article class="portal-seccion-card">
        <div class="portal-seccion-top">
          <h3><a href="/hitos-historicos/">🌍 Hitos históricos mundiales y Calendario</a></h3>
          <p class="card-meta">
            <span>{PAISES_HITOS.length} países + {HITOS_MUNDIALES.length} globales</span>
            <span aria-hidden="true">·</span>
            <span>366 días sin año</span>
          </p>
        </div>
        <ul class="portal-seccion-links">
          <li><a href="/calendario/">Calendario perpetuo (sin año)</a></li>
          <li><a href="/hitos-historicos/">Todos los {PAISES_HITOS.length} países del mundo</a></li>
          <li><a href="/hitos-historicos/argentina/">Argentina · 9 de julio</a></li>
          <li><a href="/hitos-historicos/mexico/">México · 16 de septiembre</a></li>
          <li><a href="/hitos-historicos/espana/">España · 12 de octubre</a></li>
          <li><a href="/horoscopo/">Horóscopo de cumpleaños (12 signos)</a></li>
        </ul>
        <p class="portal-seccion-pie">
          <a href="/hitos-historicos/">Explorar los {PAISES_HITOS.length} hitos históricos →</a>
        </p>
      </article>
    </div>
  </section>

  <section class="portal-banda portal-banda-guias" aria-labelledby="titulo-guias-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Más visitadas y actualizadas</p>
        <h2 id="titulo-guias-portal">Guías prácticas para escribir mejor y regalar con criterio</h2>
      </div>
      <a class="enlace-directorio" href="/guias/">Leer las {GUIAS_EDITORIALES.length} guías →</a>
    </div>

    <div class="portal-guias-salience" id="portal-guias-populares">
      <article class="card guia-destacada" id="guia-popular-lead">
        <p class="card-meta">
          <span id="guia-lead-etiqueta">{guiasLead.emoji} Guía más visitada</span>
          <span aria-hidden="true">·</span>
          <span id="guia-lead-tiempo">{guiasLead.tiempoLectura}</span>
          <span aria-hidden="true">·</span>
          <time id="guia-lead-fecha" datetime={guiasLead.fechaPublicacion}>{guiasLead.fechaPublicacion}</time>
        </p>
        <h3><a id="guia-lead-link" href={`/guias/${guiasLead.slug}/`}>{guiasLead.h1}</a></h3>
        <p id="guia-lead-desc">{guiasLead.descripcion}</p>
        <blockquote class="cita-editorial" id="guia-lead-cita">
          {guiasLead.citaDestacada}
        </blockquote>
        <p class="guia-leer"><a id="guia-lead-cta" href={`/guias/${guiasLead.slug}/`}>Abrir guía completa paso a paso →</a></p>
      </article>

      <div class="guias-secundarias-lista" id="guias-populares-lista">
        {guiasSecundarias.map(function (g) {
          return (
            <article class="guia-fila">
              <p class="card-meta">
                <span>{g.emoji} {g.tiempoLectura}</span>
                <span aria-hidden="true">·</span>
                <time datetime={g.fechaPublicacion}>{g.fechaPublicacion}</time>
              </p>
              <h3><a href={`/guias/${g.slug}/`}>{g.titulo}</a></h3>
              <p>{g.resumen}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="portal-banda" aria-labelledby="titulo-muestra-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Más populares de todas las categorías · Mezcla de todo el portal</p>
        <h2 id="titulo-muestra-portal">Textos listos para copiar según el momento</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Explorar las {todosMensajes.length.toLocaleString('es-AR')} publicaciones →</a>
    </div>

    <div class="filtros-tono" role="toolbar" aria-label="Filtrar textos populares de todas las categorías por estilo">
      {filtrosHome.map(function (f, idx) {
        return (
          <button
            type="button"
            class={'filtro-btn' + (idx === 0 ? ' activo' : '')}
            data-home-filtro={f.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {f.label} ({f.count})
          </button>
        );
      })}
    </div>

    <div class="grilla" id="home-muestra-grilla">
      {poolPopular.map(function (it, idx) {
        return (
          <div class="home-pub-slot" data-home-idx={idx} data-home-slug={it.mensaje.slug} data-home-score={it.scoreBase} data-home-segmentos={it.segmentos.join(',')} style={idx >= 12 ? 'display:none' : undefined}>
            <TarjetaMensaje m={it.mensaje} hub={it.hub} mostrarCategoria={true} scoreBase={it.scoreBase} />
          </div>
        );
      })}
    </div>

    <div class="home-mas-wrap">
      <button type="button" class="btn btn-copiar home-mas-btn" id="home-ver-mas-populares">
        Mostrar más publicaciones populares ({poolPopular.length - 12} más)
      </button>
    </div>
  </section>

  <section class="portal-banda portal-compartidos" id="lo-mas-compartido" aria-labelledby="titulo-mas-compartido">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Estadísticas en tiempo real separadas por canal</p>
        <h2 id="titulo-mas-compartido">Lo más compartido por red</h2>
      </div>
      <div class="comp-cabecera-acciones">
        <span class="comp-total-badge" id="pc-home-comp-total">0 compartidos registrados</span>
        <button type="button" class="btn-leer-mas" id="pc-home-comp-reset" hidden>Reiniciar contador</button>
      </div>
    </div>

    <div class="comp-redes-grid" role="list" aria-label="Totales compartidos por red social y copia">
      <div class="comp-red-card comp-red-card--wa" role="listitem">
        <span class="comp-red-etiqueta">WhatsApp</span>
        <strong class="comp-red-num" id="pc-stat-whatsapp">0</strong>
        <span class="comp-red-pct" id="pc-pct-whatsapp">0%</span>
        <div class="comp-red-barra"><span id="pc-bar-whatsapp" style="width:0%"></span></div>
      </div>
      <div class="comp-red-card comp-red-card--ig" role="listitem">
        <span class="comp-red-etiqueta">Instagram</span>
        <strong class="comp-red-num" id="pc-stat-instagram">0</strong>
        <span class="comp-red-pct" id="pc-pct-instagram">0%</span>
        <div class="comp-red-barra"><span id="pc-bar-instagram" style="width:0%"></span></div>
      </div>
      <div class="comp-red-card comp-red-card--fb" role="listitem">
        <span class="comp-red-etiqueta">Facebook</span>
        <strong class="comp-red-num" id="pc-stat-facebook">0</strong>
        <span class="comp-red-pct" id="pc-pct-facebook">0%</span>
        <div class="comp-red-barra"><span id="pc-bar-facebook" style="width:0%"></span></div>
      </div>
      <div class="comp-red-card comp-red-card--copiar" role="listitem">
        <span class="comp-red-etiqueta">Copiar texto</span>
        <strong class="comp-red-num" id="pc-stat-copiar">0</strong>
        <span class="comp-red-pct" id="pc-pct-copiar">0%</span>
        <div class="comp-red-barra"><span id="pc-bar-copiar" style="width:0%"></span></div>
