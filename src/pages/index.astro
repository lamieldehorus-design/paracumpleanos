---
import Base from '../layouts/Base.astro';
import TarjetaMensaje from '../components/TarjetaMensaje.astro';
import { contenido, hubs, SITIO, MARCA } from '../lib/contenido.ts';
const destacados = contenido.filter(function (r) { return r.tipo === 'mensaje'; }).slice(0, 12);
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: MARCA,
  url: SITIO + '/',
  inLanguage: 'es-AR'
}];
---
<Base titulo="ParaCumpleanos - Felicitaciones de cumpleaños originales" descripcion="Felicitaciones de cumpleaños originales para mamá, papá, hermanas, pareja y más. Mensajes listos para copiar y enviar por WhatsApp." jsonld={jsonld}>
  <h1>Felicitaciones de cumpleaños para:</h1>
  <div class="chips">
    {hubs.map(function (h) { return <a class="chip" href={'/' + h.slug + '/'}>{h.emoji} {h.destinatario}</a>; })}
  </div>
  <h2>Felicitaciones destacadas</h2>
  <div class="grilla">
    {destacados.map(function (m) { return <TarjetaMensaje m={m} />; })}
  </div>
  <p><a href="/categorias/">Ver todas las categorías</a></p>
</Base>
