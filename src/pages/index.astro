  <script id="portal-indice-json" type="application/json" set:html={JSON.stringify(indiceBuscador)} />
  <script is:inline>
    (function () {
      function norm(s) {
        return String(s || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
      }

      // 1. Buscador universal del Hero
      var inputBusq = document.getElementById('portal-buscador');
      var listaRes = document.getElementById('portal-resultados');
      var dataEl = document.getElementById('portal-indice-json');
      var indice = [];
      try {
        indice = JSON.parse((dataEl && dataEl.textContent) || '[]');
      } catch (e) {}

      var indiceNorm = indice.map(function (item) {
        return {
          titulo: item.titulo,
          slug: item.slug,
          tipo: item.tipo,
          emoji: item.emoji,
          q: norm(item.q)
        };
      });

      if (inputBusq && listaRes) {
        inputBusq.addEventListener('input', function () {
          var q = norm(inputBusq.value.trim());
          listaRes.innerHTML = '';
          if (q.length < 2) {
            listaRes.hidden = true;
            return;
          }
          var hits = [];
          for (var i = 0; i < indiceNorm.length && hits.length < 8; i++) {
            if (indiceNorm[i].q.indexOf(q) !== -1) hits.push(indiceNorm[i]);
          }
          listaRes.hidden = false;
          if (!hits.length) {
            var liVacio = document.createElement('li');
            liVacio.className = 'portal-res-vacio';
            liVacio.innerHTML = 'No encontramos coincidencias directas. <a href="#todas-las-categorias">Explorá las categorías abajo ↓</a>';
            listaRes.appendChild(liVacio);
            return;
          }
          hits.forEach(function (h) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = h.slug;
            a.innerHTML = '<span>' + h.emoji + ' ' + h.titulo + '</span><span class="portal-res-tipo">' + h.tipo + '</span>';
            li.appendChild(a);
            listaRes.appendChild(li);
          });
        });
      }

      // 2. Filtro en vivo sobre las 441 categorias desplegadas a lo ancho de la portada
      var inputCat = document.getElementById('home-filtro-cats');
      var contadorCat = document.getElementById('home-filtro-contador');
      var vacioCat = document.getElementById('home-filtro-vacio');
      var seccionesCat = document.querySelectorAll('[data-cat-seccion]');
      var totalCats = document.querySelectorAll('[data-cat-item]').length;

      if (inputCat && seccionesCat.length) {
        inputCat.addEventListener('input', function () {
          var q = norm(inputCat.value.trim());
          var visiblesTotal = 0;
          seccionesCat.forEach(function (sec) {
            var items = sec.querySelectorAll('[data-cat-item]');
            var visiblesSec = 0;
            items.forEach(function (li) {
              var txt = li.getAttribute('data-cat-item') || '';
              var ok = !q || txt.indexOf(q) !== -1;
              li.hidden = !ok;
              if (ok) visiblesSec++;
            });
            sec.hidden = visiblesSec === 0;
            visiblesTotal += visiblesSec;
          });
          if (contadorCat) {
            contadorCat.textContent = q
              ? visiblesTotal + ' de ' + totalCats + ' categorías'
              : totalCats + ' categorías disponibles';
          }
          if (vacioCat) {
            vacioCat.hidden = visiblesTotal > 0;
          }
        });
      }
    })();
  </script>
