---
import Base from '../layouts/Base.astro';
import TarjetaMensaje from '../components/TarjetaMensaje.astro';
import {
  catalogo,
  GRUPOS,
  hubs,
  todosMensajes,
  hubsPorGrupo,
  mensajesDe,
  nombreHub,
  SITIO,
  MARCA
} from '../lib/contenido.ts';
import { GUIAS_EDITORIALES } from '../data/guias.ts';
import { TEMAS_TARJETA } from '../lib/personalizador.ts';
import { ZODIACOS } from '../lib/horoscopo.ts';
import { PAISES_HITOS } from '../data/hitos-historicos.ts';
import { rankearGuiasPorPopularidad, seleccionarPoolPopularMixto } from '../lib/popularidad.ts';
import { ETIQUETAS_SEGMENTOS, type SegmentoTono } from '../lib/editorial.ts';
import {
  ACCESOS_RAPIDOS_PORTADA,
  BLOQUES_PORTADA_GSC,
  etiquetaCortaGsc
} from '../lib/gsc-estrategia.ts';
import {
  COMPARATIVA_ENFOQUES,
  FECHA_ACTUALIZACION_PORTADA,
  FECHA_ACTUALIZACION_TEXTO,
  GLOSARIO_FORMATOS,
  calcularRadiografiaCatalogo,
  construirFaqsPortada,
  construirGrafoPortadaLd,
  construirTransparenciaPortada
} from '../lib/geo-portada.ts';

// Pool mixto de las publicaciones mas populares de TODAS las categorias del sitio (32 totales, 6 iniciales para lectura agil)
const poolPopular = seleccionarPoolPopularMixto(catalogo, 32);
const LIMITE_INICIAL_HOME = 6;
const segmentosHomeDisponibles: SegmentoTono[] = [
  'corto',
  'emotivo',
  'recuerdo',
  'gratitud',
  'carta',
  'divertido',
  'fe',
  'duelo'
];
const filtrosHome = [
  { id: 'todos', label: 'Más populares', count: poolPopular.length },
  ...segmentosHomeDisponibles
    .map((seg) => ({
      id: seg,
      label: ETIQUETAS_SEGMENTOS[seg],
      count: poolPopular.filter((it) => it.segmentos.includes(seg)).length
    }))
    .filter((f) => f.count > 0)
];

// Guias ordenadas por popularidad (salience editorial: 1 guia principal + 3 secundarias)
const guiasRankeadas = rankearGuiasPorPopularidad(GUIAS_EDITORIALES);
const guiasLead = guiasRankeadas[0];
const guiasSecundarias = guiasRankeadas.slice(1, 4);
const guiasIndiceJson = guiasRankeadas.map((g) => ({
  slug: g.slug,
  titulo: g.titulo,
  h1: g.h1,
  descripcion: g.descripcion,
  resumen: g.resumen,
  emoji: g.emoji,
  tiempoLectura: g.tiempoLectura,
  fechaPublicacion: g.fechaPublicacion,
  citaDestacada: g.citaDestacada,
  scoreBase: g.scorePopularidad
}));

// Indice liviano de todas las categorias + guias + hitos para el buscador universal del portal
const indiceBuscador = hubs
  .map((h) => ({
    titulo: nombreHub(h),
    slug: '/' + h.slug + '/',
    tipo: GRUPOS.find((g) => g.id === (h.grupo || 'destinatarios'))?.nombre || 'Categoría',
    emoji: h.emoji || '🎂',
    q: `${nombreHub(h)} ${h.destinatario || ''} ${h.keyword || ''} ${h.slug}`.toLowerCase()
  }))
  .concat(
    GUIAS_EDITORIALES.map((g) => ({
      titulo: g.titulo,
      slug: `/guias/${g.slug}/`,
      tipo: 'Guía práctica',
      emoji: g.emoji,
      q: `${g.titulo} ${g.resumen} ${g.slug}`.toLowerCase()
    }))
  )
  .concat([
    {
      titulo: 'Calculadora de edad, banderines para imprimir, acróstico, fecha de duelo y agenda .ics',
      slug: '/herramientas/',
      tipo: 'Herramienta',
      emoji: '🛠️',
      q: 'herramientas calculadora edad exacta dias vividos 10000 acrostico nombre armador dedicatoria agenda recordatorios ics banderines para imprimir bordes recortar fecha de duelo'.toLowerCase()
    },
    {
      titulo: 'Creador de banderines de cumpleaños para imprimir (A4)',
      slug: '/herramientas/#banderines-imprimir',
      tipo: 'Herramienta',
      emoji: '🎏',
      q: 'banderines de cumpleanos para imprimir gratis letras feliz cumpleanos happy birthday bordes plantilla a4 recortar'.toLowerCase()
    },
    {
      titulo: 'Calendario de fechas y celebraciones (sin año)',
      slug: '/calendario/',
      tipo: 'Calendario',
      emoji: '📅',
      q: 'calendario fechas celebraciones efemerides hoy dia mes hitos historicos signo motivacion duelo sin ano'.toLowerCase()
    },
    {
      titulo: `Hitos históricos mundiales: los ${PAISES_HITOS.length} países del mundo`,
      slug: '/hitos-historicos/',
      tipo: 'Hitos históricos',
      emoji: '🌍',
      q: 'hitos historicos mundiales paises independencia fiesta nacional fecha patria efemerides mundo historia'.toLowerCase()
    },
    {
      titulo: 'Horóscopo de cumpleaños: fechas, signos y meses del año',
      slug: '/horoscopo/',
      tipo: 'Horóscopo',
      emoji: '✨',
      q: 'horoscopo zodiaco signo fechas cumpleaños mes nacimiento'.toLowerCase()
    },
    ...ZODIACOS.map((s) => ({
      titulo: `Cumpleaños de ${s.nombre} (${s.rangoTexto})`,
      slug: `/horoscopo/${s.slug}/`,
      tipo: 'Signo zodiacal',
      emoji: s.simbolo,
      q: `horoscopo ${s.nombre} ${s.rangoTexto} ${s.mesesNombres.join(' ')} ${s.elemento}`.toLowerCase()
    })),
    ...PAISES_HITOS.map((p) => ({
      titulo: `${p.nombre}: ${p.hitoPrincipal.titulo} (${p.hitoPrincipal.dia}/${p.hitoPrincipal.mes})`,
      slug: `/hitos-historicos/${p.slug}/`,
      tipo: 'Hito histórico',
      emoji: p.bandera,
      q: `hito historico ${p.nombre} ${p.capital} ${p.hitoPrincipal.titulo} ${p.continente} fecha patria independencia`.toLowerCase()
    }))
  ]);

const temas = Object.values(TEMAS_TARJETA);
const radiografia = calcularRadiografiaCatalogo({
  hubs,
  todosMensajes,
  hubsPorGrupo,
  totalGuias: GUIAS_EDITORIALES.length,
  totalPaisesHitos: PAISES_HITOS.length
});
const totalPublicacionesPortal = radiografia.totalPublicaciones;
const transparenciaPortada = construirTransparenciaPortada(radiografia);

const utilidadesPortal = [
  { href: '/calendario/', label: 'Calendario 366 días' },
  { href: '/hitos-historicos/', label: `Hitos de ${PAISES_HITOS.length} países` },
  { href: '/condolencias/', label: 'Condolencias y duelo' },
  { href: '/mas-de-10-anos-de-novios/', label: 'Aniversarios a medida' },
  { href: '/herramientas/#banderines-imprimir', label: 'Banderines A4 gratis' },
  { href: '/motivaciones/', label: 'Motivación diaria' },
  { href: '/herramientas/', label: 'Calculadora y acrósticos' }
];

const faqsPortada = construirFaqsPortada(radiografia);
const tituloPortada = 'Frases y mensajes de feliz cumpleaños, postales y calendario - ParaCumpleanos';
const descripcionPortada = `Buscá entre ${hubs.length} colecciones, ${todosMensajes.length.toLocaleString('es-AR')} frases de feliz cumpleaños, condolencias, nostalgia, aniversarios, banderines A4, calendario sin año y ${PAISES_HITOS.length} hitos históricos mundiales.`;

const jsonld = [
  construirGrafoPortadaLd({
    marca: MARCA,
    sitio: SITIO,
    tituloPagina: tituloPortada,
    descripcionPagina: descripcionPortada,
    grupos: GRUPOS,
    hubsPorGrupo,
    rad: radiografia,
    faqs: faqsPortada
  })
];
---
<Base
  titulo={tituloPortada}
  descripcion={descripcionPortada}
  jsonld={jsonld}
  esPortal={true}
>
  <section class="portal-hero" aria-labelledby="portal-h1">
    <div class="portal-hero-texto">
      <p class="portal-kicker">
        {hubs.length} colecciones · {totalPublicacionesPortal.toLocaleString('es-AR')} textos inéditos · Sin registro
      </p>
      <h1 id="portal-h1">Mensajes reales para cada cumpleaños, aniversario y recuerdo</h1>
      <p class="portal-sub">
        Encontrá palabras honestas y lejos de los clichés repetidos entre {hubs.length} colecciones temáticas: cumpleaños por vínculo y edad, cartas largas emotivas, aniversarios de pareja, bendiciones cristianas, saludos a la distancia y condolencias serenas. Personalizá con nombre y firma en vivo, copiá limpio para WhatsApp o bajá tu tarjeta PNG gratis.
      </p>

      <div class="portal-buscador-caja">
        <label for="portal-buscador" class="portal-buscador-label">Buscá destinatario, edad, aniversario, condolencias o país</label>
        <div class="portal-buscador-fila">
          <input
            id="portal-buscador"
            type="search"
            placeholder="Ej.: esposa, papá, 5 años de novios, condolencias, banderines…"
            autocomplete="off"
          />
          <a class="btn btn-copiar" href="/categorias/">Ver {hubs.length} categorías</a>
        </div>
        <ul id="portal-resultados" class="portal-resultados" hidden></ul>
      </div>

      <div class="portal-accesos-rapidos" aria-label="Accesos directos frecuentes">
        <span class="accesos-titulo">Más buscados:</span>
        {ACCESOS_RAPIDOS_PORTADA.map(function (acc, idx) {
          return (
            <>
              {idx > 0 ? <span aria-hidden="true">·</span> : null}
              <a href={acc.href}>{acc.label}</a>
            </>
          );
        })}
      </div>
    </div>

    <div class="portal-hero-studio" aria-label="Vista previa del personalizador de tarjetas">
      <p class="studio-etiqueta">Probá personalizar tu tarjeta acá mismo</p>
      <div
        class="tarjeta-visual studio-card"
        id="portal-preview-card"
        data-tema-inicio={temas[0].gradInicio}
        data-tema-medio={temas[0].gradMedio}
        data-tema-fin={temas[0].gradFin}
        data-tema-borde={temas[0].borde}
        data-tema-acento={temas[0].acento}
      >
        <div class="tarjeta-visual-emoji" aria-hidden="true">🎂</div>
        <p class="tarjeta-visual-titulo" id="studio-titulo">Para alguien que hace la diferencia</p>
        <p class="tarjeta-visual-extracto" id="studio-cuerpo">
          Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos.
        </p>
        <p class="tarjeta-visual-marca" id="studio-firma">paracumpleanos.com</p>
      </div>
      <div class="studio-controles">
        <div class="studio-inputs">
          <input id="studio-nombre" type="text" maxlength="32" placeholder="Nombre (ej.: Laura)" aria-label="Nombre de quien cumple años" />
          <input id="studio-mi-firma" type="text" maxlength="32" placeholder="Tu firma (ej.: Sofi)" aria-label="Tu firma" />
        </div>
        <div class="studio-temas" role="group" aria-label="Estilo de tarjeta">
          {temas.map(function (t, i) {
            return (
              <button
                type="button"
                class={'pers-tema-btn' + (i === 0 ? ' activo' : '')}
                data-studio-tema={t.id}
                data-fondo={t.fondoCss}
                data-inicio={t.gradInicio}
                data-medio={t.gradMedio}
                data-fin={t.gradFin}
                data-borde={t.borde}
                data-acento={t.acento}
              >
                <span class="pers-swatch" style={`background:${t.fondoCss};border-color:${t.borde}`}></span>
                <span>{t.nombre}</span>
              </button>
            );
          })}
        </div>
        <div class="studio-acciones">
          <button
            type="button"
            id="studio-btn-copiar"
            class="btn btn-copiar btn-sm"
            data-text="Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos."
          >
            Copiar texto
          </button>
          <button
            type="button"
            id="studio-btn-png"
            class="btn btn-descargar btn-sm"
            data-title="Para alguien que hace la diferencia"
            data-mostrar-titulo="1"
            data-body="Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos."
            data-emoji="🎂"
          >
            Descargar PNG
          </button>
        </div>
      </div>
    </div>
  </section>

  <nav class="portal-ribbon" aria-label="Utilidades y verticales principales">
    <span class="portal-ribbon-label">Accesos útiles</span>
    <div class="portal-ribbon-links">
      {utilidadesPortal.map(function (u) {
        return <a href={u.href}>{u.label}</a>;
      })}
    </div>
  </nav>

  <section class="portal-tldr" aria-labelledby="titulo-tldr-portal">
    <div class="portal-tldr-head">
      <div>
        <p class="banda-kicker">Resumen verificable · Definición canónica del archivo</p>
        <h2 id="titulo-tldr-portal">Qué es {MARCA} en 30 segundos</h2>
      </div>
      <p class="portal-tldr-meta">
        <span>Equipo editorial de {MARCA}</span>
        <span aria-hidden="true">·</span>
        <span>Actualizado el <time datetime={FECHA_ACTUALIZACION_PORTADA}>{FECHA_ACTUALIZACION_TEXTO}</time></span>
      </p>
    </div>

    <p class="portal-tldr-def">
      <strong>{MARCA}</strong> (<code>paracumpleanos.com</code>) es un archivo editorial independiente en español y estudio interactivo gratuito para encontrar, adaptar y descargar saludos reales de cumpleaños, cartas largas emotivas, aniversarios de pareja, condolencias serenas, banderines A4 imprimibles y efemérides sin crear cuenta ni dejar datos personales en servidores externos.
    </p>

    <ul class="portal-tldr-puntos">
      <li>
        <strong>Catálogo auditado sin duplicados:</strong> reúne <span class="num-inline">{radiografia.totalColecciones}</span> colecciones en {GRUPOS.length} secciones temáticas, <span class="num-inline">{radiografia.totalMensajes.toLocaleString('es-AR')}</span> textos únicos (media de <span class="num-inline">{radiografia.promedioPalabras}</span> palabras), <span class="num-inline">{radiografia.totalGuias}</span> guías de redacción y <span class="num-inline">{radiografia.totalPaisesHitos}</span> fichas de hitos históricos mundiales.
      </li>
      <li>
        <strong>Separación estricta de contexto:</strong> las <span class="num-inline">{radiografia.coleccionesDuelo}</span> colecciones de condolencias, duelo y recuerdos están auditadas con cero palabras festivas, y las <span class="num-inline">{radiografia.coleccionesAniversarios}</span> colecciones de aniversarios nunca mezclan vocabulario de cumpleaños.
      </li>
      <li>
        <strong>Personalización y descarga 100 % locales:</strong> adaptás nombre, firma y posdata en vivo para copiar limpio a WhatsApp, exportar postales PNG cuadradas (1080×1080) o verticales Story (1080×1920) e imprimir banderines A4 gratis desde el navegador.
      </li>
      <li>
        <strong>Calendario perpetuo y utilidades abiertas:</strong> incluye un <a href="/calendario/">calendario sin año de 366 días</a>, <a href="/herramientas/">calculadora de edad exacta, acrósticos y recordatorios .ics</a> y <a href="/sobre-nosotros/">criterio editorial público</a>.
      </li>
    </ul>
  </section>

  <section id="secciones-portal" class="portal-banda portal-top-gsc" aria-labelledby="titulo-top-gsc">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Colecciones con mayor demanda · Acceso directo en un clic</p>
        <h2 id="titulo-top-gsc">Lo más buscado ahora en cumpleaños y familia</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Directorio completo ({hubs.length}) →</a>
    </div>

    <div class="portal-top-gsc-grid">
      {BLOQUES_PORTADA_GSC.map(function (bloque) {
        return (
          <article class="portal-gsc-col">
            <h3>{bloque.titulo}</h3>
            <p class="portal-gsc-sub">{bloque.subtitulo}</p>
            <ul class="portal-gsc-links">
              {bloque.slugs.map(function (sl) {
                const h = catalogo.hubsPorSlug.get(sl);
                if (!h) return null;
                const cant = mensajesDe(sl).length;
                return (
                  <li>
                    <a href={'/' + sl + '/'}>
                      <span>{etiquetaCortaGsc(sl, h)}</span>
                      <span class="portal-gsc-count">{cant}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </article>
        );
      })}
    </div>

    <div class="portal-temas-indice" aria-label="Índice rápido de las 14 secciones temáticas">
      <div class="portal-temas-cabecera">
        <p class="portal-temas-titulo">Explorar las {GRUPOS.length} secciones del archivo</p>
        <a href="/categorias/">Ver todas las {hubs.length} colecciones →</a>
      </div>
      <ul class="portal-temas-lista">
        {GRUPOS.map(function (g) {
          const lista = hubsPorGrupo.get(g.id) || [];
          if (!lista.length) return null;
          return (
            <li>
              <a href={`/categorias/#${g.id}`}>
                <span class="portal-tema-nombre">{g.nombre}</span>
                <span class="portal-tema-count">{lista.length}</span>
              </a>
            </li>
          );
        })}
        <li>
          <a href="/hitos-historicos/">
            <span class="portal-tema-nombre">Hitos históricos mundiales</span>
            <span class="portal-tema-count">{PAISES_HITOS.length}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="portal-banda" aria-labelledby="titulo-muestra-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Selección curada · Copiar limpio o abrir en tarjeta PNG</p>
        <h2 id="titulo-muestra-portal">Dedicatorias listas para enviar hoy</h2>
      </div>
      <a class="enlace-directorio" href="/categorias/">Ver las {todosMensajes.length.toLocaleString('es-AR')} publicaciones →</a>
    </div>

    <div class="filtros-tono" role="toolbar" aria-label="Filtrar textos populares por estilo">
      {filtrosHome.map(function (f, idx) {
        return (
          <button
            type="button"
            class={'filtro-btn' + (idx === 0 ? ' activo' : '')}
            data-home-filtro={f.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {f.label} ({f.count})
          </button>
        );
      })}
    </div>

    <div class="grilla" id="home-muestra-grilla">
      {poolPopular.map(function (it, idx) {
        return (
          <div
            class="home-pub-slot"
            data-home-idx={idx}
            data-home-slug={it.mensaje.slug}
            data-home-score={it.scoreBase}
            data-home-segmentos={it.segmentos.join(',')}
            style={idx >= LIMITE_INICIAL_HOME ? 'display:none' : undefined}
          >
            <TarjetaMensaje m={it.mensaje} hub={it.hub} mostrarCategoria={true} scoreBase={it.scoreBase} />
          </div>
        );
      })}
    </div>

    <div class="home-mas-wrap">
      <button type="button" class="btn btn-copiar home-mas-btn" id="home-ver-mas-populares">
        Mostrar más dedicatorias ({poolPopular.length - LIMITE_INICIAL_HOME} más)
      </button>
    </div>
  </section>

  <section class="portal-banda portal-banda-guias" aria-labelledby="titulo-guias-portal">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Criterio editorial y redacción práctica</p>
        <h2 id="titulo-guias-portal">Guías para escribir mejor y regalar con criterio</h2>
      </div>
      <a class="enlace-directorio" href="/guias/">Leer las {GUIAS_EDITORIALES.length} guías →</a>
    </div>

    <div class="portal-guias-salience" id="portal-guias-populares">
      <article class="card guia-destacada" id="guia-popular-lead">
        <p class="card-meta">
          <span id="guia-lead-etiqueta">Guía destacada</span>
          <span aria-hidden="true">·</span>
          <span id="guia-lead-tiempo">{guiasLead.tiempoLectura}</span>
          <span aria-hidden="true">·</span>
          <time id="guia-lead-fecha" datetime={guiasLead.fechaPublicacion}>{guiasLead.fechaPublicacion}</time>
        </p>
        <h3><a id="guia-lead-link" href={`/guias/${guiasLead.slug}/`}>{guiasLead.h1}</a></h3>
        <p id="guia-lead-desc">{guiasLead.descripcion}</p>
        <blockquote class="cita-editorial" id="guia-lead-cita">
          {guiasLead.citaDestacada}
        </blockquote>
        <p class="guia-leer"><a id="guia-lead-cta" href={`/guias/${guiasLead.slug}/`}>Abrir guía completa paso a paso →</a></p>
      </article>

      <div class="guias-secundarias-lista" id="guias-populares-lista">
        {guiasSecundarias.map(function (g) {
          return (
            <article class="guia-fila">
              <p class="card-meta">
                <span>{g.tiempoLectura}</span>
                <span aria-hidden="true">·</span>
                <time datetime={g.fechaPublicacion}>{g.fechaPublicacion}</time>
              </p>
              <h3><a href={`/guias/${g.slug}/`}>{g.titulo}</a></h3>
              <p>{g.resumen}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="portal-banda portal-guia-cosmica" aria-labelledby="titulo-guia-cosmica">
    <div class="banda-cabecera">
      <div>
        <p class="banda-kicker">Manual editorial de redacción afectiva · Estructura práctica y datos verificables</p>
        <h2 id="titulo-guia-cosmica">Cómo escribir mensajes de cumpleaños, aniversario y recuerdo que se sientan verdaderos</h2>
      </div>
      <a class="enlace-directorio" href="/guias/">Explorar {GUIAS_EDITORIALES.length} guías prácticas →</a>
    </div>

    <div class="guia-cosmica-cuerpo">
      <div class="guia-cosmica-resumen">
        <p class="guia-cosmica-etiqueta">Respuesta directa · Fórmula de cuatro piezas</p>
        <p>
          Un mensaje que emociona de verdad nunca depende de adjetivos rebuscados ni cadenas reenviadas: se arma en menos de un minuto con <strong>cuatro piezas concretas</strong>. Abrí con el apodo real de la persona, nombrá una escena verificable del último año (una charla, un gesto de apoyo o una costumbre cotidiana), sumá un deseo puntual para la etapa que empieza hoy y cerrá con tu firma habitual.
        </p>
      </div>

      <h3>¿Por qué la mayoría de los saludos pasan desapercibidos y cómo salir del molde?</h3>
      <p class="geo-respuesta-directa">
        La mayoría de los saludos de cumpleaños y aniversario se olvidan el mismo día porque repiten fórmulas genéricas que podrían servir para cualquier desconocido. Reemplazar un elogio abstracto por un hecho compartido verificable convierte incluso cuatro líneas en una dedicatoria irrepetible.
      </p>
      <p>
        Cuando alguien cumple años, celebra un aniversario o atraviesa una fecha sensible, su teléfono se llena en pocas horas de frases idénticas: <em>«que la pases lindo»</em>, <em>«que se cumplan todos tus sueños»</em> o imágenes reenviadas sin nombre. Aplicá el principio de <strong>concreción afectiva</strong>: en lugar de escribir solo «gracias por estar siempre», nombrá un gesto real («gracias por el café de aquel jueves difícil y por escuchar sin apuro»).
      </p>

      <div class="comparacion-concreta" aria-label="Comparación entre saludos genéricos y mensajes concretos">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá el molde automático (pareja y familia)</span>
          <p>«¡Feliz cumpleaños! Que Dios te bendiga mucho y que todos tus deseos se hagan realidad en este nuevo año de vida.»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Mejor con concreción real</span>
          <p>«Feliz cumple, amor. Gracias por las risas en la cocina, por sostenernos en los días largos y por hacer que casa siempre se sienta refugio. Que este año te regale salud firme y tiempo propio.»</p>
        </div>
      </div>

      <div class="comparacion-concreta" aria-label="Comparación en saludos a la distancia">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá cargar el día de melancolía (distancia)</span>
          <p>«Qué tristeza no poder abrazarte hoy, te extraño demasiado y este día no es igual sin vos acá.»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Mejor luminoso y presente</span>
          <p>«Aunque haya kilómetros de por medio, celebro a lo grande cada paso que estás dando allá. Te mando este abrazo temprano según tu horario y ya guardo el brindis para nuestro próximo reencuentro.»</p>
        </div>
      </div>

      <div class="comparacion-concreta" aria-label="Comparación en condolencias y fechas de duelo">
        <div class="comp-item comp-evitar">
          <span class="comp-etiqueta">Evitá frases hechas en duelo</span>
          <p>«Sé fuerte, todo pasa por algo y el tiempo cura todas las heridas. Ánimo en este día.»</p>
        </div>
        <div class="comp-item comp-mejor">
          <span class="comp-etiqueta">Mejor sereno y honesto</span>
          <p>«No existen palabras que alcancen, pero te abrazo fuerte hoy y recuerdo con enorme cariño su calma y sus charlas. No hace falta que respondas este mensaje; contá conmigo para lo que necesites esta semana.»</p>
        </div>
      </div>

      <h3>¿Qué extensión, canal y horario convienen según el tipo de saludo?</h3>
      <p class="geo-respuesta-directa">
        El mismo vínculo exige un formato distinto según dónde y a qué hora se va a leer: entre 35 y 65 palabras en WhatsApp matutino, de 20 a 45 en una Story vertical y entre 140 y 260 palabras en una carta larga impresa o de noche.
      </p>

      <div class="tabla-responsive">
