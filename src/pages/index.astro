  <section class="portal-estandares" aria-labelledby="titulo-criterio-portal">
    <h2 id="titulo-criterio-portal">Por qué miles de lectores eligen ParaCumpleanos</h2>
    <div class="estandares-grid">
      <div class="estandar-item">
        <h3>01. {totalPublicacionesPortal.toLocaleString('es-AR')} publicaciones únicas sin copias</h3>
        <p>Cada dedicatoria, guía y reseña histórica tiene redacción original en español cercano o formal según el vínculo, sin párrafos reciclados.</p>
      </div>
      <div class="estandar-item">
        <h3>02. Contexto respetado al detalle</h3>
        <p>Separamos fechas sensibles de duelo y nostalgia, aniversarios de 1 mes a +10 años personalizables, entornos laborales, motivaciones y efemérides mundiales.</p>
      </div>
      <div class="estandar-item">
        <h3>03. Personalización, Banderines A4 y Story IG</h3>
        <p>Sumá nombre, firma, años exactos, posdata y tipografía en {temas.length} paletas, descargá tarjetas 1080×1920 o banderines A4. Conocé más en <a href="/sobre-nosotros/">Sobre nosotros</a>.</p>
      </div>
    </div>
  </section>

  <script id="portal-indice-json" type="application/json" set:html={JSON.stringify(indiceBuscador)} />
  <script id="portal-guias-json" type="application/json" set:html={JSON.stringify(guiasIndiceJson)} />
  <script is:inline>
    (function () {
      var inputBusq = document.getElementById('portal-buscador');
      var listaRes = document.getElementById('portal-resultados');
      var dataEl = document.getElementById('portal-indice-json');
      var indice = [];
      try {
        indice = JSON.parse((dataEl && dataEl.textContent) || '[]');
      } catch (e) {}

      function norm(s) {
        return String(s || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
      }

      var indiceNorm = indice.map(function (item) {
        return {
          titulo: item.titulo,
          slug: item.slug,
          tipo: item.tipo,
          emoji: item.emoji,
          q: norm(item.q)
        };
      });

      if (inputBusq && listaRes) {
        inputBusq.addEventListener('input', function () {
          var q = norm(inputBusq.value.trim());
          listaRes.innerHTML = '';
          if (q.length < 2) {
            listaRes.hidden = true;
            return;
          }
          var hits = [];
          for (var i = 0; i < indiceNorm.length && hits.length < 8; i++) {
            if (indiceNorm[i].q.indexOf(q) !== -1) hits.push(indiceNorm[i]);
          }
          listaRes.hidden = false;
          if (!hits.length) {
            var liVacio = document.createElement('li');
            liVacio.className = 'portal-res-vacio';
            liVacio.innerHTML = 'No encontramos coincidencias directas. <a href="/categorias/">Explorá todas las categorías →</a>';
            listaRes.appendChild(liVacio);
            return;
          }
          hits.forEach(function (h) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = h.slug;
            a.innerHTML = '<span>' + h.emoji + ' ' + h.titulo + '</span><span class="portal-res-tipo">' + h.tipo + '</span>';
            li.appendChild(a);
            listaRes.appendChild(li);
          });
        });
      }

      // Estudio rapido en el Hero
      var studioNom = document.getElementById('studio-nombre');
      var studioFir = document.getElementById('studio-mi-firma');
      var studioTit = document.getElementById('studio-titulo');
      var studioCue = document.getElementById('studio-cuerpo');
      var studioMar = document.getElementById('studio-firma');
      var previewCard = document.getElementById('portal-preview-card');
      var studioBtnCopiar = document.getElementById('studio-btn-copiar');
      var studioBtnPng = document.getElementById('studio-btn-png');
      var baseCuerpo = 'Que este nuevo año te traiga sobremesas tranquilas, salud firme y motivos reales para festejar cerca de los tuyos.';

      function actualizarStudio() {
        var nom = (studioNom && studioNom.value || '').trim();
        var fir = (studioFir && studioFir.value || '').trim();
        var titTxt = nom ? '¡Feliz cumpleaños, ' + nom + '!' : 'Para alguien que hace la diferencia';
        var cueTxt = nom ? nom + ', ' + baseCuerpo.charAt(0).toLowerCase() + baseCuerpo.slice(1) : baseCuerpo;
        var cuerpoCompleto = fir ? cueTxt + '\n\n— ' + fir : cueTxt;
        if (studioTit) studioTit.textContent = titTxt;
        if (studioCue) studioCue.textContent = cueTxt;
        if (studioMar) studioMar.textContent = fir ? '— ' + fir + ' · paracumpleanos.com' : 'paracumpleanos.com';
        if (studioBtnCopiar) studioBtnCopiar.setAttribute('data-text', cuerpoCompleto);
        if (studioBtnPng) {
          studioBtnPng.setAttribute('data-title', titTxt);
          studioBtnPng.setAttribute('data-body', cuerpoCompleto);
        }
      }
      if (studioNom) studioNom.addEventListener('input', actualizarStudio);
      if (studioFir) studioFir.addEventListener('input', actualizarStudio);

      document.querySelectorAll('[data-studio-tema]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('[data-studio-tema]').forEach(function (b) { b.classList.remove('activo'); });
          btn.classList.add('activo');
          if (previewCard) {
            previewCard.style.background = btn.getAttribute('data-fondo');
            previewCard.style.borderColor = btn.getAttribute('data-borde');
            previewCard.setAttribute('data-tema-inicio', btn.getAttribute('data-inicio') || '#fdf2f8');
            previewCard.setAttribute('data-tema-medio', btn.getAttribute('data-medio') || '#fff7ed');
            previewCard.setAttribute('data-tema-fin', btn.getAttribute('data-fin') || '#e0f2fe');
            previewCard.setAttribute('data-tema-borde', btn.getAttribute('data-borde') || '#e91e8c');
            previewCard.setAttribute('data-tema-acento', btn.getAttribute('data-acento') || '#be185d');
          }
          if (studioTit) studioTit.style.color = btn.getAttribute('data-acento');
        });
      });

      // Re-ranking dinamico de "Guias practicas..." segun visitas acumuladas
      try {
        var visitasGuias = JSON.parse(localStorage.getItem('pc_visitas_guias_v1') || '{}');
        var guiasDataEl = document.getElementById('portal-guias-json');
        if (visitasGuias && Object.keys(visitasGuias).length > 0 && guiasDataEl) {
          var todasGuias = JSON.parse(guiasDataEl.textContent || '[]');
          todasGuias.sort(function (a, b) {
            var sa = Number(a.scoreBase || 0) + Number(visitasGuias[a.slug] || 0) * 25;
            var sb = Number(b.scoreBase || 0) + Number(visitasGuias[b.slug] || 0) * 25;
            return sb - sa;
          });
          var topLead = todasGuias[0];
          var topSec = todasGuias.slice(1, 5);
          if (topLead) {
            var elEt = document.getElementById('guia-lead-etiqueta');
            var elTi = document.getElementById('guia-lead-tiempo');
            var elFe = document.getElementById('guia-lead-fecha');
            var elLk = document.getElementById('guia-lead-link');
            var elDe = document.getElementById('guia-lead-desc');
            var elCi = document.getElementById('guia-lead-cita');
            var elCt = document.getElementById('guia-lead-cta');
            if (elEt) elEt.textContent = topLead.emoji + ' Guía más visitada';
            if (elTi) elTi.textContent = topLead.tiempoLectura;
            if (elFe) { elFe.textContent = topLead.fechaPublicacion; elFe.setAttribute('datetime', topLead.fechaPublicacion); }
            if (elLk) { elLk.href = '/guias/' + topLead.slug + '/'; elLk.textContent = topLead.h1; }
            if (elDe) elDe.textContent = topLead.descripcion;
            if (elCi) elCi.textContent = topLead.citaDestacada;
            if (elCt) elCt.href = '/guias/' + topLead.slug + '/';
          }
          var secCont = document.getElementById('guias-populares-lista');
          if (secCont && topSec.length) {
            secCont.innerHTML = '';
            topSec.forEach(function (g) {
              var art = document.createElement('article');
              art.className = 'guia-fila';
              var meta = document.createElement('p');
              meta.className = 'card-meta';
              meta.innerHTML = '<span>' + g.emoji + ' ' + g.tiempoLectura + '</span><span aria-hidden="true">·</span><time datetime="' + g.fechaPublicacion + '">' + g.fechaPublicacion + '</time>';
              var h3 = document.createElement('h3');
              var a = document.createElement('a');
              a.href = '/guias/' + g.slug + '/';
              a.textContent = g.titulo;
              h3.appendChild(a);
              var p = document.createElement('p');
              p.textContent = g.resumen;
              art.appendChild(meta);
              art.appendChild(h3);
              art.appendChild(p);
              secCont.appendChild(art);
            });
          }
        }
      } catch (_) {}

      // Ranking dinamico + filtros multi-segmento + "Ver mas" en Textos populares mixtos
      var homeBtns = document.querySelectorAll('[data-home-filtro]');
      var homeGrilla = document.getElementById('home-muestra-grilla');
      var btnVerMas = document.getElementById('home-ver-mas-populares');
      var filtroActivo = 'todos';
      var expandido = false;

      if (homeGrilla) {
        // Reordenar slots segun popularidad local acumulada (vistas + copias + compartidos)
        try {
          var popMap = JSON.parse(localStorage.getItem('pc_popularidad_pubs_v1') || '{}');
          if (popMap && Object.keys(popMap).length > 0) {
            var slots = Array.prototype.slice.call(homeGrilla.querySelectorAll('.home-pub-slot'));
            slots.sort(function (a, b) {
              var sa = Number(a.getAttribute('data-home-score') || 0) + Number(popMap[a.getAttribute('data-home-slug') || ''] || 0) * 12;
              var sb = Number(b.getAttribute('data-home-score') || 0) + Number(popMap[b.getAttribute('data-home-slug') || ''] || 0) * 12;
              return sb - sa;
            });
            slots.forEach(function (s) { homeGrilla.appendChild(s); });
          }
        } catch (_) {}

        function refrescarPopularesHome() {
          var slots = homeGrilla.querySelectorAll('.home-pub-slot');
          var visibles = 0;
          var totalCoinc = 0;
          slots.forEach(function (slot) {
            var segs = (slot.getAttribute('data-home-segmentos') || '').split(',');
            var match = filtroActivo === 'todos' || segs.indexOf(filtroActivo) !== -1;
            if (!match) {
              slot.style.display = 'none';
              return;
            }
            totalCoinc++;
            var limite = filtroActivo === 'todos' && !expandido ? 12 : 99;
            if (visibles < limite) {
              slot.style.display = '';
              visibles++;
            } else {
              slot.style.display = 'none';
            }
          });
          if (btnVerMas) {
            if (filtroActivo === 'todos' && !expandido && totalCoinc > 12) {
              btnVerMas.hidden = false;
              btnVerMas.textContent = 'Mostrar más publicaciones populares (' + (totalCoinc - 12) + ' más)';
            } else if (filtroActivo === 'todos' && expandido && totalCoinc > 12) {
              btnVerMas.hidden = false;
              btnVerMas.textContent = 'Mostrar solo las 12 principales';
            } else {
              btnVerMas.hidden = true;
            }
          }
        }

        homeBtns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            filtroActivo = btn.getAttribute('data-home-filtro') || 'todos';
            homeBtns.forEach(function (b) {
              var ac = b === btn;
              b.classList.toggle('activo', ac);
              b.setAttribute('aria-pressed', ac ? 'true' : 'false');
            });
            refrescarPopularesHome();
          });
        });

        if (btnVerMas) {
          btnVerMas.addEventListener('click', function () {
            expandido = !expandido;
            refrescarPopularesHome();
          });
        }

        refrescarPopularesHome();
      }
    })();
  </script>
</Base>
