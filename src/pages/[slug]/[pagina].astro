---
import Base from '../../layouts/Base.astro';
import TarjetaMensaje from '../../components/TarjetaMensaje.astro';
import Hermanas from '../../components/Hermanas.astro';
import FiltrosSegmentacion from '../../components/FiltrosSegmentacion.astro';
import PersonalizadorAniosAniversario from '../../components/PersonalizadorAniosAniversario.astro';
import EstudioBanderines from '../../components/EstudioBanderines.astro';
import PersonalizadorRapidoHub from '../../components/PersonalizadorRapidoHub.astro';
import { hubs, POR_PAGINA, SITIO, MARCA, mensajesDe, nombreHub, migasLd } from '../../lib/contenido.ts';
import { guiaRelacionadaParaHub } from '../../lib/editorial.ts';
export function getStaticPaths() {
  const paths: any[] = [];
  hubs.forEach(function (h) {
    const total = Math.ceil(mensajesDe(h.slug).length / POR_PAGINA);
    for (let p = 2; p <= total; p++) {
      paths.push({ params: { slug: h.slug, pagina: String(p) }, props: { hub: h, pagina: p, total: total } });
    }
  });
  return paths;
}
const { hub, pagina, total } = Astro.props;
const msj = mensajesDe(hub.slug);
const lote = msj.slice((pagina - 1) * POR_PAGINA, pagina * POR_PAGINA);
const prev = pagina - 1;
const next = pagina + 1;
const urlPrev = prev === 1 ? '/' + hub.slug + '/' : '/' + hub.slug + '/' + prev + '/';
const titulo = nombreHub(hub) + ' (página ' + pagina + ') - ' + MARCA;
const descripcion = nombreHub(hub) + ': página ' + pagina + ' de ' + total + '. Más mensajes originales listos para copiar y enviar por WhatsApp o escribir en su tarjeta.';
const guia = guiaRelacionadaParaHub(hub);
const esAnivPersonalizable = hub.slug === 'mas-de-10-anos-de-novios';
const esBanderines = hub.slug === 'banderines-de-cumpleanos-para-imprimir';
const jsonld = [migasLd([
  { name: 'Inicio', url: SITIO + '/' },
  { name: nombreHub(hub), url: SITIO + '/' + hub.slug + '/' },
  { name: 'Página ' + pagina, url: SITIO + '/' + hub.slug + '/' + pagina + '/' }
])];
---
<Base
  titulo={titulo}
  descripcion={descripcion}
  jsonld={jsonld}
  grupoActual={hub.grupo || 'destinatarios'}
  slugActual={hub.slug}
  relPrev={urlPrev}
  relNext={next <= total ? '/' + hub.slug + '/' + next + '/' : undefined}
>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <a href={'/' + hub.slug + '/'}>{nombreHub(hub)}</a> › <span>Página {pagina}</span>
  </nav>
  <h1>{hub.h1} (página {pagina})</h1>
  <p class="meta-linea-editorial">
    <span>Página {pagina} de {total}</span>
    <span aria-hidden="true">·</span>
    <span>{esBanderines ? `${msj.length} guías prácticas e ideas` : `${msj.length} dedicatorias inéditas`}</span>
    <span aria-hidden="true">·</span>
    <span>{esBanderines ? 'Herramienta online A4 independiente' : 'Abrí cada texto para personalizar su tarjeta'}</span>
  </p>
  <p class="lead">{hub.meta}</p>
  {esAnivPersonalizable ? <PersonalizadorAniosAniversario modo="hub" /> : null}
  {esBanderines ? <EstudioBanderines modo="hub" /> : <PersonalizadorRapidoHub totalMensajes={msj.length} esDuelo={hub.grupo === 'condolencias'} />}
  <FiltrosSegmentacion mensajesTodos={msj} hub={hub} cantPaginaActual={lote.length} />
  <div class="grilla" id="grilla-mensajes">
    {lote.map(function (m) { return <TarjetaMensaje m={m} hub={hub} />; })}
  </div>
  <nav class="paginacion" aria-label="Paginación">
    {prev >= 1 ? <a href={urlPrev}>‹ Anterior</a> : null}
    {Array.from({ length: total }, (_, i) => i + 1).map(function (p) {
      if (p === pagina) {
        return <span class="pag-actual" aria-current="page">{p}</span>;
      }
      const hrefP = p === 1 ? '/' + hub.slug + '/' : '/' + hub.slug + '/' + p + '/';
      return <a class="pag-num" href={hrefP}>{p}</a>;
    })}
    {next <= total ? <a href={'/' + hub.slug + '/' + next + '/'}>Siguiente ›</a> : null}
  </nav>
  {hub.seoTitulo && hub.seoTexto ? (
    <section class="guia-categoria" aria-labelledby="guia-pag-titulo">
      <h2 id="guia-pag-titulo">{hub.seoTitulo}</h2>
      <p>{String(hub.seoTexto).split('\n\n')[0]}</p>
      <p class="ver-tambien">
        <a href={'/' + hub.slug + '/'}>Ver tabla comparativa, preguntas frecuentes y guía completa de {nombreHub(hub)} →</a>
      </p>
      <p class="ver-tambien">
        Lectura complementaria: <a href={`/guias/${guia.slug}/`}>{guia.titulo} →</a>
      </p>
    </section>
  ) : null}
  <Hermanas hub={hub} />
</Base>
