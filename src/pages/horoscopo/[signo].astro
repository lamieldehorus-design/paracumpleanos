---
import Base from '../../layouts/Base.astro';
import Compartir from '../../components/Compartir.astro';
import PersonalizadorTarjeta from '../../components/PersonalizadorTarjeta.astro';
import { SITIO, MARCA, migasLd, mensajesDe } from '../../lib/contenido.ts';
import { ZODIACOS, MESES_CON_SIGNOS, type SignoZodiaco } from '../../lib/horoscopo.ts';
import { arcanosPorSigno } from '../../lib/tarot-egipcio.ts';

export function getStaticPaths() {
  return ZODIACOS.map((signo) => ({
    params: { signo: signo.slug },
    props: { signo }
  }));
}

interface Props {
  signo: SignoZodiaco;
}

const { signo } = Astro.props;
const titulo = `Cumpleaños de ${signo.nombre} (${signo.rangoTexto}): ${signo.frasesCumpleanos.length} frases y meses - ${MARCA}`;
const descripcion =
  `${signo.frasesCumpleanos.length} frases de cumpleaños para ${signo.nombre} (${signo.rangoTexto}), ideas de regalos según su elemento ${signo.elemento} y colecciones completas de ${signo.mesesNombres[0]} y ${signo.mesesNombres[1]}.`;

const mesesVinculados = signo.mesesSlugs.map((slugMes, idx) => {
  const mesInfo = MESES_CON_SIGNOS.find((m) => m.slug === slugMes);
  const subSigno = mesInfo?.signos.find((x) => x.slug === signo.slug);
  const cantidadMes = mensajesDe(slugMes).length;
  return {
    slug: slugMes,
    nombre: signo.mesesNombres[idx],
    rangoEnMes: subSigno ? subSigno.rangoEnMes : signo.rangoTexto,
    estacion: mesInfo ? mesInfo.estacionSurNorte : '',
    cantidadMes
  };
});

const otrosSignos = ZODIACOS.filter((z) => z.slug !== signo.slug);
const arcanosDelSigno = arcanosPorSigno(signo.slug);

const etiquetasTono: Record<string, string> = {
  emotivo: 'Emotivo y cercano',
  breve: 'Breve para WhatsApp',
  humor: 'Con humor sano',
  fe: 'Con fe y gratitud'
};

const jsonld = [
  migasLd([
    { name: 'Inicio', url: SITIO + '/' },
    { name: 'Horóscopo de cumpleaños', url: SITIO + '/horoscopo/' },
    { name: `${signo.nombre} ${signo.simbolo}`, url: `${SITIO}/horoscopo/${signo.slug}/` }
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Cumpleaños de ${signo.nombre}`,
    description: descripcion,
    url: `${SITIO}/horoscopo/${signo.slug}/`,
    inLanguage: 'es',
    author: { '@type': 'Organization', name: MARCA, url: SITIO + '/sobre-nosotros/' },
    publisher: { '@type': 'Organization', name: MARCA, url: SITIO + '/' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: signo.faqs.map((f) => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: f.respuesta }
    }))
  }
];
---
<Base
  titulo={titulo}
  descripcion={descripcion}
  jsonld={jsonld}
  grupoActual="meses"
>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <a href="/horoscopo/">Horóscopo</a> › <span>{signo.nombre}</span>
  </nav>

  <h1>Cumpleaños de {signo.nombre} {signo.simbolo}: {signo.frasesCumpleanos.length} frases, regalos y meses</h1>
  <p class="meta-linea-editorial">
    <span>{signo.rangoTexto}</span>
    <span aria-hidden="true">·</span>
    <span>Elemento {signo.elemento}</span>
    <span aria-hidden="true">·</span>
    <span>Regente: {signo.planeta}</span>
  </p>

  <p class="lead">
    Si la persona homenajeada nació bajo <strong>{signo.nombre}</strong>, su cumpleaños cae entre el {signo.rangoTexto}. Acá tenés {signo.frasesCumpleanos.length} dedicatorias por tono adaptadas a su personalidad, ideas de regalos concretas y las colecciones completas de los meses vinculados.
  </p>

  <!-- INTERLINK BIDIRECCIONAL DIRECTO CON CATEGORIAS POR MESES -->
  <aside class="enlace-horoscopo-mes" aria-labelledby="hor-meses-tit-signo">
    <h2 id="hor-meses-tit-signo">Meses vinculados a los cumpleaños de {signo.nombre}</h2>
    <p>
      Según el día exacto de nacimiento, {signo.nombre} comparte calendario con dos colecciones mensuales ampliadas:
    </p>
    <div class="enlace-horoscopo-grid">
      {mesesVinculados.map((m) => (
        <a class="signo-mes-card" href={`/${m.slug}/`}>
          <span class="signo-mes-nombre">🎂 Cumpleaños en {m.nombre}</span>
          <span class="signo-mes-rango">{signo.nombre}: {m.rangoEnMes} · {m.cantidadMes} dedicatorias</span>
        </a>
      ))}
    </div>
    <p class="enlace-horoscopo-pie">
      <a href="/tarot-egipcio/">Hacer tirada gratis de Tarot Egipcio →</a>
      <a href="/herramientas/#calculadora-edad">Calcular edad exacta y 10.000 días →</a>
      <a href="/horoscopo/">Ver los 12 signos →</a>
    </p>
  </aside>

  {arcanosDelSigno.length > 0 ? (
    <aside class="enlace-horoscopo-mes tarot-puente-signo" aria-labelledby="hor-tarot-signo-tit">
      <h2 id="hor-tarot-signo-tit">
        {arcanosDelSigno.length === 1
          ? `Arcano del Tarot Egipcio vinculado a ${signo.nombre}`
          : `Arcanos del Tarot Egipcio vinculados a ${signo.nombre}`}
      </h2>
      <p>
        En la correspondencia astrológica del <strong>Tarot Egipcio</strong>, {signo.nombre} vibra directamente con {arcanosDelSigno.length === 1 ? 'este Arcano Mayor' : 'estos Arcanos Mayores'} y sus dedicatorias simbólicas:
      </p>
      <div class="enlace-horoscopo-grid">
        {arcanosDelSigno.map((a) => (
          <a class="signo-mes-card" href={`/tarot-egipcio/${a.slug}/`}>
            <span class="signo-mes-nombre">{a.romano} · {a.nombre} ({a.deidad})</span>
            <span class="signo-mes-rango">{a.astrologiaTexto} · {a.esencia}</span>
          </a>
        ))}
      </div>
      <p class="enlace-horoscopo-pie">
        <a href="/tarot-egipcio/#estudio-tarot">Abrir tirada interactiva de Tarot Egipcio →</a>
        <a href="/tarot-egipcio/#calculadora-arcano">Calcular tu Arcano por fecha de nacimiento →</a>
      </p>
    </aside>
  ) : null}

  <dl class="horoscopo-ficha-dl">
    <div>
      <dt>Fechas exactas</dt>
      <dd>{signo.rangoTexto}</dd>
    </div>
    <div>
      <dt>Elemento y planeta</dt>
      <dd>{signo.elemento} · {signo.planeta}</dd>
    </div>
    <div>
      <dt>Tono recomendado</dt>
      <dd>{signo.tonoIdeal}</dd>
    </div>
    <div>
      <dt>Rasgos clave</dt>
      <dd>{signo.rasgos.join(' · ')}</dd>
    </div>
    <div>
      <dt>Brindis afines</dt>
      <dd>{signo.compatibilidadBrindis.join(' y ')}</dd>
    </div>
  </dl>

  <PersonalizadorTarjeta modo="hub" />

  <div class="tarjeta-visual" role="img" aria-label={`Tarjeta destacada para cumpleaños de ${signo.nombre}`}>
    <div class="tarjeta-visual-emoji">{signo.simbolo}</div>
    <p class="tarjeta-visual-subtitulo" hidden></p>
    <p class="tarjeta-visual-titulo">Feliz cumpleaños, {signo.nombre}</p>
    <p class="tarjeta-visual-extracto">{signo.frasesCumpleanos[0].texto}</p>
    <p class="tarjeta-visual-marca">paracumpleanos.com</p>
  </div>

  <section aria-labelledby="hor-frases-tit">
    <h2 id="hor-frases-tit">{signo.frasesCumpleanos.length} dedicatorias exclusivas para celebrar a {signo.nombre}</h2>
    <div class="filtros-tono" role="group" aria-label={`Filtrar dedicatorias de ${signo.nombre} por tono`}>
      <button type="button" class="filtro-btn activo" data-hor-filtro="todos" aria-pressed="true">Todas ({signo.frasesCumpleanos.length})</button>
      <button type="button" class="filtro-btn" data-hor-filtro="emotivo" aria-pressed="false">Emotivo</button>
      <button type="button" class="filtro-btn" data-hor-filtro="breve" aria-pressed="false">Breve WhatsApp</button>
      <button type="button" class="filtro-btn" data-hor-filtro="humor" aria-pressed="false">Humor sano</button>
      <button type="button" class="filtro-btn" data-hor-filtro="fe" aria-pressed="false">Fe y gratitud</button>
    </div>
    <div class="grilla" id="hor-grilla-signo">
      {signo.frasesCumpleanos.map((f) => {
        const tono = f.tono || 'emotivo';
        return (
          <article
            class="card"
            data-card-personalizable="1"
            data-hor-tono={tono}
            data-orig-titulo={f.titulo}
            data-orig-texto={f.texto}
            data-orig-resumen={f.texto}
          >
            <p class="card-meta"><span>{etiquetasTono[tono] || 'Dedicatoria'}</span></p>
            <h3>{f.titulo}</h3>
            <p class="card-resumen">{f.texto}</p>
            <Compartir
              texto={f.texto}
              url={`${SITIO}/horoscopo/${signo.slug}/`}
              tituloCard={f.titulo}
              cuerpoCard={f.texto}
              emojiCard={signo.simbolo}
              mostrarDescarga={true}
            />
          </article>
        );
      })}
    </div>
  </section>

  <section class="guia-categoria" aria-labelledby="hor-consejo-tit">
    <h2 id="hor-consejo-tit">Cómo festeja {signo.nombre} y qué regalar sin errar</h2>
    <p><strong>Estilo de celebración:</strong> {signo.estiloCelebracion}</p>
    <p><strong>Clave al saludar:</strong> {signo.comoSaludar}</p>
    <h3>Tres ideas concretas de regalo para {signo.nombre}</h3>
    <ol class="lista-editorial lista-numerada">
      {signo.ideasRegalo.map((idea) => (
        <li>{idea}</li>
      ))}
    </ol>
    <p class="ver-tambien">
      Seguí explorando mensajes según su fecha exacta en <a href={`/${mesesVinculados[0].slug}/`}>cumpleaños en {mesesVinculados[0].nombre} ({mesesVinculados[0].cantidadMes}) →</a> o <a href={`/${mesesVinculados[1].slug}/`}>cumpleaños en {mesesVinculados[1].nombre} ({mesesVinculados[1].cantidadMes}) →</a>
    </p>
  </section>

  <section class="faqs-hub" aria-labelledby="hor-faq-signo-tit">
    <h2 id="hor-faq-signo-tit">Preguntas frecuentes sobre los cumpleaños de {signo.nombre}</h2>
    <div class="faq-lista">
      {signo.faqs.map((f, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary>{f.pregunta}</summary>
          <p>{f.respuesta}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="hermanas" aria-labelledby="hor-otros-tit">
    <h2 id="hor-otros-tit">Explorá los otros 11 signos del horóscopo</h2>
    <div class="chips">
      {otrosSignos.map((otro) => (
        <a class="chip" href={`/horoscopo/${otro.slug}/`}>
          {otro.simbolo} {otro.nombre} ({otro.mesesNombres.join(' / ')})
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('[data-hor-filtro]');
      var grilla = document.getElementById('hor-grilla-signo');
      if (!btns.length || !grilla) return;
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var f = btn.getAttribute('data-hor-filtro') || 'todos';
          btns.forEach(function (b) {
            var act = b === btn;
            b.classList.toggle('activo', act);
            b.setAttribute('aria-pressed', act ? 'true' : 'false');
          });
          grilla.querySelectorAll('[data-hor-tono]').forEach(function (card) {
            card.style.display = f === 'todos' || card.getAttribute('data-hor-tono') === f ? '' : 'none';
          });
        });
      });
    })();
  </script>
</Base>
