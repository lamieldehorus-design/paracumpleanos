---
import Base from '../layouts/Base.astro';
import { GRUPOS, hubs, todosMensajes, hubsPorGrupo, mensajesDe, nombreHub, SITIO, migasLd } from '../lib/contenido.ts';
const jsonld = [migasLd([
  { name: 'Inicio', url: SITIO + '/' },
  { name: 'Categorías', url: SITIO + '/categorias/' }
])];
---
<Base titulo={`${hubs.length} Categorías de felicitaciones - ParaCumpleanos`} descripcion={`Todas las ${hubs.length} categorías y ${todosMensajes.length.toLocaleString('es-AR')} textos originales: mamá, fechas especiales, meses, horóscopo, cartas y más.`} jsonld={jsonld}>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <span>Categorías</span>
  </nav>
  <h1>Todas las categorías ({hubs.length})</h1>
  <p class="lead">Explorá las <strong>{hubs.length} categorías</strong> y sus <strong>{todosMensajes.length.toLocaleString('es-AR')} felicitaciones originales</strong> listas para copiar y enviar por WhatsApp.</p>
  <label for="filtro-cats" style="display:block;font-weight:600;margin-top:12px;">Buscar categoría o destinatario:</label>
  <input id="filtro-cats" class="buscador-cats" type="search" placeholder="Ej.: mamá, navidad, san valentín, pascuas, 15 años, carta…" autocomplete="off" />
  <div class="chips" style="margin-top:12px;">
    <a class="chip" href="/calendario/">📅 Calendario (sin año)</a>
    <a class="chip" href="/hitos-historicos/">🌍 Hitos históricos (195 países)</a>
    <a class="chip" href="/condolencias/">🕊️ Condolencias y fecha de duelo</a>
    <a class="chip" href="/herramientas/#banderines-imprimir">🎏 Banderines para imprimir</a>
  </div>
  <div class="chips">
    {GRUPOS.map(function (g) {
      const lista = hubsPorGrupo.get(g.id) || [];
      return <a class="chip" href={'#' + g.id}>{g.emoji} {g.nombre} ({lista.length})</a>;
    })}
  </div>
  <div id="lista-categorias">
    {GRUPOS.map(function (g) {
      const lista = hubsPorGrupo.get(g.id) || [];
      if (!lista.length) return null;
      return (
        <section class="cat-grupo-bloque" id={g.id}>
          <h2>{g.emoji} {g.nombre} ({lista.length})</h2>
          <ul class="cat-lista">
            {lista.map(function (h) {
              const cant = mensajesDe(h.slug).length;
              return (
                <li data-cat={nombreHub(h).toLowerCase() + ' ' + (h.destinatario || '').toLowerCase()}>
                  <a href={'/' + h.slug + '/'}>{h.emoji} {nombreHub(h)}</a> — {cant} felicitaciones
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
  <script is:inline>
    (function () {
      var input = document.getElementById('filtro-cats');
      if (!input) return;
      function norm(s) {
        return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      }
      function filtrar() {
        var q = norm(input.value);
        var items = document.querySelectorAll('#lista-categorias li');
        for (var i = 0; i < items.length; i++) {
          var txt = norm(items[i].getAttribute('data-cat') || '');
          items[i].style.display = !q || txt.indexOf(q) !== -1 ? '' : 'none';
        }
        var secs = document.querySelectorAll('.cat-grupo-bloque');
        for (var j = 0; j < secs.length; j++) {
          var visibles = secs[j].querySelectorAll('li:not([style*="display: none"])').length;
          secs[j].style.display = visibles > 0 ? '' : 'none';
        }
      }
      input.addEventListener('input', filtrar);
      try {
        var params = new URLSearchParams(window.location.search);
        var qParam = params.get('q');
        if (qParam) {
          input.value = qParam;
          filtrar();
        }
      } catch (_) {}
    })();
  </script>
</Base>
