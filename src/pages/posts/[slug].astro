---
import PuenteRedireccion from '../../components/PuenteRedireccion.astro';
import { REDIRECCIONES_POSTS } from '../../lib/redirecciones-legadas.ts';

export function getStaticPaths() {
  return REDIRECCIONES_POSTS.map((r) => ({
    params: { slug: r.slugOrigen },
    props: { redir: r }
  }));
}

const { redir } = Astro.props;
---
<PuenteRedireccion
  titulo={redir.titulo}
  destinoSlug={redir.destinoSlug}
  alternativoSlug={redir.alternativoSlug}
  alternativoTexto={redir.alternativoTexto}
/>
