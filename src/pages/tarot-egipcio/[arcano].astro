---
import Base from '../../layouts/Base.astro';
import PersonalizadorTarjeta from '../../components/PersonalizadorTarjeta.astro';
import Compartir from '../../components/Compartir.astro';
import { SITIO, MARCA, migasLd } from '../../lib/contenido.ts';
import {
  TAROT_MAYORES_22,
  clasificarTonoTarot,
  type ArcanoMayorCompleto
} from '../../data/tarot-egipcio.ts';

export function getStaticPaths() {
  return TAROT_MAYORES_22.map((arcano, idx) => ({
    params: { arcano: arcano.slug },
    props: { arcano, idx }
  }));
}

interface Props {
  arcano: ArcanoMayorCompleto;
  idx: number;
}

const { arcano, idx } = Astro.props;
const anterior = TAROT_MAYORES_22[(idx - 1 + TAROT_MAYORES_22.length) % TAROT_MAYORES_22.length];
const siguiente = TAROT_MAYORES_22[(idx + 1) % TAROT_MAYORES_22.length];
const otros21 = TAROT_MAYORES_22.filter((x) => x.slug !== arcano.slug);
const letraHebrea = arcano.fichaDl.find((d) => d.label.toLowerCase().includes('letra'))?.valor || '';
const urlArcano = `${SITIO}/tarot-egipcio/${arcano.slug}/`;

const jsonld = [
  migasLd([
    { name: 'Inicio', url: SITIO + '/' },
    { name: 'Tarot Egipcio', url: SITIO + '/tarot-egipcio/' },
    { name: `${arcano.romano} · ${arcano.nombre}`, url: urlArcano }
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: arcano.h1,
    description: arcano.metaDesc,
    url: urlArcano,
    inLanguage: 'es',
    author: { '@type': 'Organization', name: MARCA },
    publisher: { '@type': 'Organization', name: MARCA }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: arcano.faqs.map((f) => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: f.respuesta }
    }))
  }
];
---
<Base
  titulo={arcano.titleTag}
  descripcion={arcano.metaDesc}
  jsonld={jsonld}
  grupoActual="meses"
  slugActual={arcano.slug}
>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <a href="/tarot-egipcio/">Tarot Egipcio</a> › <span>{arcano.romano} · {arcano.nombre}</span>
  </nav>

  <header class="tarot-arcano-hero">
    <p class="banda-kicker">Arcano Mayor {arcano.romano} de 22 · Tradición del Tarot Egipcio</p>
    <h1>{arcano.h1}</h1>
    <p class="meta-linea-editorial">
      <span>Deidad: {arcano.deidad}</span>
      <span aria-hidden="true">·</span>
      <span>{arcano.astrologia}</span>
      {letraHebrea ? (
        <>
          <span aria-hidden="true">·</span>
          <span>Letra {letraHebrea}</span>
        </>
      ) : null}
      <span aria-hidden="true">·</span>
      <span>Numerología {arcano.numerologia}</span>
    </p>
    <p class="lead">{arcano.lead}</p>
  </header>

  <blockquote class="tarot-aforismo" aria-label={`Aforismo tradicional de ${arcano.nombre}`}>
    <p>«{arcano.aforismo}»</p>
    <cite>Aforismo tradicional del Arcano {arcano.romano} ({arcano.nombre})</cite>
  </blockquote>

  <dl class="horoscopo-ficha-dl tarot-ficha-dl">
    {arcano.fichaDl.map((item) => (
      <div>
        <dt>{item.label}</dt>
        <dd>{item.valor}</dd>
      </div>
    ))}
  </dl>

  <aside class="enlace-horoscopo-mes tarot-interlink-zodiaco" aria-labelledby="tarot-zodiaco-tit">
    <h2 id="tarot-zodiaco-tit">Vínculo de {arcano.nombre} con el Horóscopo y los meses de cumpleaños</h2>
    <p>{arcano.zodiacoIntro}</p>
    <div class="enlace-horoscopo-grid">
      {arcano.enlacesZodiaco.map((en) => (
        <a class="signo-mes-card" href={en.href}>
          <span class="signo-mes-nombre">{en.nombre}</span>
          <span class="signo-mes-rango">{en.rango}</span>
        </a>
      ))}
    </div>
    <p class="enlace-horoscopo-pie">
      <a href="/tarot-egipcio/#estudio-tarot">Hacer una tirada interactiva ahora →</a>
      <a href="/tarot-egipcio/#calculadora-arcano">Calcular tu Arcano de cumpleaños →</a>
    </p>
  </aside>

  <section class="tarot-polaridad-sec" aria-labelledby="tit-polaridad">
    <h2 id="tit-polaridad">Significado de {arcano.nombre} al derecho e invertido</h2>
    <div class="tarot-polaridad-grid">
      <article class="tarot-polaridad-card">
        <p class="tarot-pol-etiqueta">Posición al derecho · Energía en flujo</p>
        <h3>Qué anuncia cuando aparece derecho</h3>
        <p>{arcano.derechoDetalle}</p>
      </article>
      <article class="tarot-polaridad-card tarot-polaridad-card--inv">
        <p class="tarot-pol-etiqueta">Posición invertida · Invitación a revisar</p>
        <h3>Qué matiza cuando sale invertido</h3>
        <p>{arcano.invertidoDetalle}</p>
      </article>
    </div>
  </section>

  <section class="guia-categoria tarot-planos-sec" aria-labelledby="tit-planos-arcano">
    <h2 id="tit-planos-arcano">Los tres planos simbólicos y la filosofía de {arcano.nombre}</h2>
    <dl class="geo-glosario">
      {arcano.planos.map((pl) => (
        <div class="geo-glosario-item">
          <dt>{pl.nombre}</dt>
          <dd><span>{pl.texto}</span></dd>
        </div>
      ))}
    </dl>
    <h3>Filosofía simbólica del Arcano {arcano.romano}</h3>
    {arcano.filosofiaParrafos[0] ? <p>{arcano.filosofiaParrafos[0]}</p> : null}
    <h3>Cómo usar {arcano.nombre} en un cumpleaños o cambio de etapa</h3>
    {arcano.filosofiaParrafos[1] ? <p>{arcano.filosofiaParrafos[1]}</p> : null}
  </section>

  <PersonalizadorTarjeta modo="hub" />

  <div class="tarjeta-visual" role="img" aria-label={`Tarjeta destacada inspirada en ${arcano.nombre}`}>
    <div class="tarjeta-visual-emoji">{arcano.glyph}</div>
    <p class="tarjeta-visual-subtitulo" hidden></p>
    <p class="tarjeta-visual-titulo">{arcano.romano} · {arcano.nombre}</p>
    <p class="tarjeta-visual-extracto">{arcano.dedicatorias[0]?.texto || arcano.esencia}</p>
    <p class="tarjeta-visual-marca">paracumpleanos.com</p>
  </div>

  <section aria-labelledby="tit-dedicatorias-arcano">
    <h2 id="tit-dedicatorias-arcano">{arcano.dedicatorias.length} dedicatorias de cumpleaños inspiradas en {arcano.nombre}</h2>
    <div class="filtros-tono" role="group" aria-label={`Filtrar dedicatorias de ${arcano.nombre} por tono`}>
      <button type="button" class="filtro-btn activo" data-tarot-filtro="todos" aria-pressed="true">
        Todas ({arcano.dedicatorias.length})
      </button>
      <button type="button" class="filtro-btn" data-tarot-filtro="emotivo" aria-pressed="false">Emotivo</button>
      <button type="button" class="filtro-btn" data-tarot-filtro="breve" aria-pressed="false">Breve WhatsApp</button>
      <button type="button" class="filtro-btn" data-tarot-filtro="reflexivo" aria-pressed="false">Reflexivo</button>
      <button type="button" class="filtro-btn" data-tarot-filtro="fe" aria-pressed="false">Fe y gratitud</button>
    </div>

    <div class="grilla" id="tarot-grilla-dedicatorias">
      {arcano.dedicatorias.map((d) => (
        <article
          class="card"
          data-card-personalizable="1"
          data-tarot-tono={clasificarTonoTarot(d.tono)}
          data-orig-titulo={d.titulo}
          data-orig-texto={d.texto}
          data-orig-resumen={d.texto}
        >
          <p class="card-meta"><span>{d.tono}</span></p>
          <h3>{d.titulo}</h3>
          <p class="card-resumen">{d.texto}</p>
          <Compartir
            titulo={d.titulo}
            texto={d.texto}
            url={urlArcano}
            mostrarDescarga={true}
            emoji={arcano.glyph}
          />
        </article>
      ))}
    </div>
  </section>

  <section class="faqs-hub" aria-labelledby="tit-faq-arcano">
    <h2 id="tit-faq-arcano">Preguntas frecuentes sobre {arcano.nombre}</h2>
    <div class="faq-grid-visible">
      {arcano.faqs.map((f) => (
        <article class="faq-card-visible">
          <h3>{f.pregunta}</h3>
          <p>{f.respuesta}</p>
        </article>
      ))}
    </div>
  </section>

  <nav class="tarot-nav-seq" aria-label="Navegación entre Arcanos Mayores">
    <a class="tarot-nav-seq-card" href={`/tarot-egipcio/${anterior.slug}/`}>
      <span class="tarot-nav-dir">← Arcano anterior</span>
      <strong>{anterior.romano} · {anterior.nombre}</strong>
    </a>
    <a class="tarot-nav-seq-card tarot-nav-seq-card--centro" href="/tarot-egipcio/">
      <span class="tarot-nav-dir">Archivo y tirada</span>
      <strong>Ver los 78 arcanos</strong>
    </a>
    <a class="tarot-nav-seq-card tarot-nav-seq-card--der" href={`/tarot-egipcio/${siguiente.slug}/`}>
      <span class="tarot-nav-dir">Arcano siguiente →</span>
      <strong>{siguiente.romano} · {siguiente.nombre}</strong>
    </a>
  </nav>

  <section class="hermanas" aria-labelledby="tit-otros-arcanos">
    <h2 id="tit-otros-arcanos">Explorá los otros 21 Arcanos Mayores del Tarot Egipcio</h2>
    <div class="chips">
      {otros21.map((x) => (
        <a class="chip" href={`/tarot-egipcio/${x.slug}/`}>
          {x.romano} · {x.nombre}
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('[data-tarot-filtro]');
      var grilla = document.getElementById('tarot-grilla-dedicatorias');
      if (!btns.length || !grilla) return;
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var f = btn.getAttribute('data-tarot-filtro') || 'todos';
          btns.forEach(function (b) {
            var act = b === btn;
            b.classList.toggle('activo', act);
            b.setAttribute('aria-pressed', act ? 'true' : 'false');
          });
          grilla.querySelectorAll('[data-tarot-tono]').forEach(function (card) {
            card.style.display = f === 'todos' || card.getAttribute('data-tarot-tono') === f ? '' : 'none';
          });
        });
      });
    })();
  </script>
</Base>
