const parContextual = esHub ? PARES_CONTEXTUALES[registro.slug] : undefined;

if (esHub) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: registro.titulo,
    description: registro.meta,
    url: urlHub,
    inLanguage: 'es',
    datePublished: creado,
    dateModified: actualizado,
    author: { '@type': 'Organization', name: MARCA, url: SITIO + '/sobre-nosotros/' },
    publisher: { '@type': 'Organization', name: MARCA, url: SITIO + '/' }
  });
}
const textoEnviar = esHub ? '' : registro.texto;
---
<Base
  titulo={titulo}
  descripcion={descripcionFinal}
  jsonld={jsonld}
  grupoActual={hub.grupo || 'destinatarios'}
  slugActual={hub.slug}
  noindex={noindexPagina}
  relNext={esHub && totalPaginas > 1 ? '/' + registro.slug + '/2/' : undefined}
>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › {esHub ? <span>{nombreHub(hub)}</span> : <a href={'/' + hub.slug + '/'}>{nombreHub(hub)}</a>}
    {esHub ? null : <span> › {registro.titulo}</span>}
  </nav>
  {esHub && editorialHub ? (
    <div>
      <h1>{registro.h1}</h1>
      <p class="meta-linea-editorial">
        <span>{esBanderines ? `${mensajesCat.length} guías prácticas e ideas` : `${mensajesCat.length} dedicatorias inéditas`}</span>
        <span aria-hidden="true">·</span>
        <span>{esBanderines ? 'Herramienta online A4 independiente' : 'Abrí cada texto para personalizar su tarjeta'}</span>
        <span aria-hidden="true">·</span>
        <span>Actualizado el <time datetime={actualizado}>{actualizado}</time></span>
      </p>
      <div class="lead-bloque">
        {String(registro.lead || '').split('\n\n').map(function (p) {
          return <p class="lead">{p}</p>;
        })}
      </div>

      {parContextual ? (
        <aside class="enlace-par-contextual" aria-label="Colecciones complementarias">
          <span>{parContextual.texto}</span>
          {parContextual.enlaces.map(function (el) {
            return <a href={el.href}>{el.label} →</a>;
          })}
        </aside>
      ) : null}

      {mesZodiaco ? (
        <aside class="enlace-horoscopo-mes" aria-label={`Signos del horóscopo en ${mesZodiaco.nombreCap}`}>
          <h2>Signos zodiacales de quienes cumplen en {mesZodiaco.nombreCap}</h2>
          <p>
            Según la fecha exacta de nacimiento ({mesZodiaco.estacionSurNorte}), podés adaptar tu saludo al signo correspondiente:
          </p>
          <div class="enlace-horoscopo-grid">
            {mesZodiaco.signos.map(function (sig) {
              return (
                <a class="signo-mes-card" href={`/horoscopo/${sig.slug}/`}>
                  <span class="signo-mes-nombre">{sig.simbolo} Cumpleaños de {sig.nombre}</span>
                  <span class="signo-mes-rango">{sig.rangoEnMes} · Frases, regalos y perfil</span>
                </a>
              );
            })}
          </div>
          <p class="enlace-horoscopo-pie">
            <a href="/horoscopo/">Comparar los 12 signos del zodíaco →</a>
            <a href="/calendario/">Ver calendario e hitos históricos del mes →</a>
            <a href="/herramientas/#calculadora-edad">Calcular edad exacta y signo →</a>
          </p>
        </aside>
      ) : null}

      {hub.slug === 'motivaciones' ? <AlertaMotivacionDiaria compact={true} /> : null}

      {editorialHub.perfil === 'duelo' ? <SelectorFechaDuelo /> : null}

      {esAnivPersonalizable ? <PersonalizadorAniosAniversario modo="hub" /> : null}

      {esBanderines ? (
        <>
          <EstudioBanderines modo="hub" />
          <div class="banderines-guias-sep">
            <h2>{mensajesCat.length} guías prácticas, tutoriales e ideas de banderines de cumpleaños</h2>
            <p>
              Artículos paso a paso pensados aparte de la herramienta online: elección de papeles, medidas exactas, técnicas para colgar sin arruinar paredes, temáticas por edad y trucos de diseño casero.
            </p>
          </div>
        </>
      ) : null}

      <FiltrosSegmentacion
        mensajesTodos={mensajesCat}
        hub={hub}
        cantPaginaActual={mensajesPagina.length}
      />

      <div class="grilla" id="grilla-mensajes">
        {mensajesPagina.map(function (m) { return <TarjetaMensaje m={m} hub={hub} />; })}
      </div>

      {totalPaginas > 1 ? (
        <nav class="paginacion" aria-label="Paginación">
          <span class="pag-actual" aria-current="page">1</span>
          {Array.from({ length: totalPaginas - 1 }, (_, i) => i + 2).map(function (p) {
            return <a class="pag-num" href={'/' + registro.slug + '/' + p + '/'}>{p}</a>;
          })}
          <a href={'/' + registro.slug + '/2/'}>Siguiente ›</a>
        </nav>
      ) : null}

      <section class="bloque-tabla-hub" aria-labelledby="tabla-hub-titulo">
        <h2 id="tabla-hub-titulo">Qué extensión elegir en {nombreHub(registro)}</h2>
        <div class="tabla-responsive">
          <table class="tabla-comparativa">
            <thead>
              <tr>
                <th>Formato</th>
                <th>En esta sección</th>
                <th>Ideal para</th>
                <th>Ajuste recomendado</th>
              </tr>
            </thead>
            <tbody>
              {editorialHub.tabla.map(function (fila) {
                return (
                  <tr>
                    <td><strong>{fila.formato}</strong></td>
                    <td class="num-col">{fila.cantidad}</td>
                    <td>{fila.idealPara}</td>
                    <td>{fila.consejo}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section class="guia-categoria" aria-labelledby="guia-seo-titulo">
        <h2 id="guia-seo-titulo">{registro.seoTitulo}</h2>
        {String(registro.seoTexto || '').split('\n\n').map(function (p) {
          return <p>{p}</p>;
        })}

        <blockquote class="cita-editorial">{editorialHub.citaClave}</blockquote>

        <h3>{editorialHub.subtituloClaves}</h3>
        <ol class="lista-editorial lista-numerada">
          {editorialHub.claves.map(function (c) {
            return <li>{c}</li>;
          })}
        </ol>

        <p class="ver-tambien">
          Lectura complementaria: <a href={`/guias/${editorialHub.guia.slug}/`}>{editorialHub.guia.titulo} →</a>
        </p>
      </section>

      <section class="faqs-hub" aria-labelledby="faq-hub-titulo">
        <h2 id="faq-hub-titulo">Preguntas frecuentes sobre {nombreHub(registro)}</h2>
        <div class="faq-lista">
          {editorialHub.faqs.map(function (f, i) {
            return (
              <details class="faq-item" open={i === 0}>
                <summary>{f.pregunta}</summary>
                <p>{f.respuesta}</p>
              </details>
            );
          })}
        </div>
      </section>

      <p class="fechas-meta">Publicado: <time datetime={creado}>{creado}</time> · Última actualización: <time datetime={actualizado}>{actualizado}</time></p>
      <p class="firma">Escrito y revisado por el <a href="/sobre-nosotros/">Equipo Editorial de {MARCA}</a>. Textos inéditos listos para personalizar.</p>
      <Hermanas hub={hub} />
    </div>
  ) : guiaMsg ? (
    <div>
      <h1>{registro.titulo}</h1>
      <p class="meta-linea-editorial">
        <a href={'/' + hub.slug + '/'}>{guiaMsg.destinatarioNombre}</a>
        <span aria-hidden="true">·</span>
        <span>{guiaMsg.clasificacion.tonoLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{guiaMsg.clasificacion.canalLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{guiaMsg.clasificacion.palabras} palabras ({guiaMsg.clasificacion.tiempoLectura})</span>
      </p>

      {explMsg ? (
        <section class="contexto-frase-cosmico" aria-labelledby="contexto-frase-titulo">
          <p class="contexto-frase-kicker">{explMsg.enfoqueLabel}</p>
          <h2 id="contexto-frase-titulo">{explMsg.titulo}</h2>
          {explMsg.parrafos.map(function (p) {
            return <p>{p}</p>;
          })}
        </section>
      ) : null}

      {esBanderines ? (
        <article class="guia-banderin-articulo" id="mensaje-cuerpo" data-slug={registro.slug}>
          <div class="mensaje guia-banderin-cuerpo">
            {parrafosMsg.map(function (p) {
              const lineas = p.split('\n');
              return (
                <p>
                  {lineas.map(function (linea, idx) {
                    return idx === 0 ? linea : <><br />{linea}</>;
                  })}
                </p>
              );
            })}
          </div>

          <aside class="cta-herramienta-banderines" aria-label="Herramienta online de banderines">
            <div>
              <p class="eyebrow">Herramienta gratuita independiente</p>
              <h2>¿Querés diseñar e imprimir tu propio banderín en A4?</h2>
              <p>
                Cuando termines de leer estas recomendaciones, pasá por nuestro creador online para escribir la frase que elijas, combinar formas, colores o tu propia foto y descargar las hojas A4 listas para recortar.
              </p>
            </div>
            <a class="btn btn-primario" href="/banderines-de-cumpleanos-para-imprimir/#estudio-banderines">
              Abrir herramienta de banderines A4 →
            </a>
          </aside>
        </article>
      ) : (
        <>
          {esAnivPersonalizable ? <PersonalizadorAniosAniversario modo="mensaje" /> : null}
          <PersonalizadorTarjeta modo="mensaje" esDuelo={guiaMsg.perfil === 'duelo'} />

          <div id="mensaje-detalle-bloque">
            <div id="mensaje-cuerpo" class="mensaje" data-slug={registro.slug} data-orig-texto={registro.texto} data-orig-titulo={registro.titulo}>
              {parrafosMsg.map(function (p) {
                const lineas = p.split('\n');
                return (
                  <p>
                    {lineas.map(function (linea, idx) {
                      return idx === 0 ? linea : <><br />{linea}</>;
                    })}
                  </p>
                );
              })}
            </div>
            <div class="tarjeta-visual" role="img" aria-label={'Tarjeta lista para compartir: ' + registro.titulo}>
              <div class="tarjeta-visual-emoji">{hub.emoji}</div>
              <p class="tarjeta-visual-subtitulo" hidden></p>
              <div class="tarjeta-visual-foto-wrap" hidden>
                <img class="tarjeta-visual-foto" alt="Foto personalizada para la tarjeta" />
              </div>
              <div class="tarjeta-visual-extracto">
                {parrafosMsg.map(function (p) {
                  const lineas = p.split('\n');
                  return (
                    <p>
                      {lineas.map(function (linea, idx) {
                        return idx === 0 ? linea : <><br />{linea}</>;
                      })}
                    </p>
                  );
                })}
              </div>
              <p class="tarjeta-visual-marca">paracumpleanos.com</p>
            </div>
            <Compartir
              texto={textoEnviar}
              url={SITIO + '/' + registro.slug + '/'}
              tituloCard={registro.titulo}
              cuerpoCard={textoCompletoCard}
              emojiCard={hub.emoji}
              mostrarDescarga={true}
            />
          </div>

          <blockquote class="cita-editorial">{guiaMsg.citaDestacada}</blockquote>

          <section class="consejo-mensaje" aria-labelledby="consejo-adaptar-titulo">
            <h2 id="consejo-adaptar-titulo">
              {guiaMsg.perfil === 'motivaciones'
                ? 'Cómo aplicar esta motivación en acciones concretas hoy'
                : 'Cómo adaptar este texto en 30 segundos para que suene tuyo'}
            </h2>
            <div class="comparacion-concreta">
              <div class="comp-item comp-evitar">
                <span class="comp-etiqueta">
                  {guiaMsg.perfil === 'motivaciones' ? 'Frase vacía de internet' : 'Evitá enviar genérico'}
                </span>
                <p>«{guiaMsg.ejemploGenerico}»</p>
              </div>
              <div class="comp-item comp-mejor">
                <span class="comp-etiqueta">
                  {guiaMsg.perfil === 'motivaciones' ? 'Paso práctico para destrabar tu día' : 'Sumá un detalle real'}
                </span>
                <p>«{guiaMsg.ejemploConcreto}»</p>
              </div>
            </div>
            <p class="consejo-horario"><strong>Mejor momento sugerido:</strong> {guiaMsg.mejorHorario}</p>
            <p class="posdata-sugerida">{guiaMsg.posdataSugerida}</p>
            <ol class="lista-editorial lista-numerada">
              {guiaMsg.pasos.map(function (paso) {
                return <li>{paso}</li>;
              })}
            </ol>
            <p class="ver-tambien">
              Guía recomendada: <a href={`/guias/${guiaMsg.guia.slug}/`}>{guiaMsg.guia.titulo} →</a> · <a href="/sobre-nosotros/#criterio-editorial">Cómo revisamos estos textos</a>
            </p>
          </section>
        </>
      )}

      <section class="relacionadas">
        <h2>{esBanderines ? 'Otras guías prácticas sobre banderines de cumpleaños' : `Otras dedicatorias únicas de ${guiaMsg.destinatarioNombre}`}</h2>
        <ul>
          {relacionadas.map(function (m) { return <li><a href={'/' + m.slug + '/'}>{m.titulo}</a></li>; })}
        </ul>
      </section>
      <p class="ver-tambien">Ver las {totalMensajesHub} opciones completas en <a href={'/' + hub.slug + '/'}>{hub.titulo} →</a></p>
      <Hermanas hub={hub} />
    </div>
  ) : null}
</Base>

<script is:inline>
  (function () {
    var det = document.getElementById('mensaje-cuerpo');
    if (det) {
      var slug = det.getAttribute('data-slug') || '';
      if (slug && window.pcRegistrarPopularidadPub) {
        window.pcRegistrarPopularidadPub(slug, 1);
      }
    }
  })();
</script>
