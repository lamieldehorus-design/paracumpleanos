---
import Base from '../layouts/Base.astro';
import TarjetaMensaje from '../components/TarjetaMensaje.astro';
import Compartir from '../components/Compartir.astro';
import Hermanas from '../components/Hermanas.astro';
import PersonalizadorTarjeta from '../components/PersonalizadorTarjeta.astro';
import AlertaMotivacionDiaria from '../components/AlertaMotivacionDiaria.astro';
import {
  contenido,
  POR_PAGINA,
  SITIO,
  MARCA,
  mensajesDe,
  hubDe,
  relacionadasDe,
  metaDe,
  nombreHub,
  migasLd,
  esMensajeIndexable
} from '../lib/contenido.ts';
import {
  clasificarMensaje,
  editorialHubCompleto,
  guiaAdaptacionMensaje
} from '../lib/editorial.ts';
import { mesInfoPorSlug } from '../lib/horoscopo.ts';

export function getStaticPaths() {
  return contenido.map(function (r) {
    return { params: { slug: r.slug }, props: { registro: r } };
  });
}
const { registro } = Astro.props;
const esHub = registro.tipo === 'hub';
const hub = hubDe(registro);
const urlHub = SITIO + '/' + hub.slug + '/';
const mensajesHub = mensajesDe(hub.slug);
const mensajesCat = esHub ? mensajesHub : [];
const totalMensajesHub = mensajesHub.length;
const totalPaginas = Math.ceil(mensajesCat.length / POR_PAGINA);
const mensajesPagina = mensajesCat.slice(0, POR_PAGINA);
const relacionadas = esHub ? [] : relacionadasDe(registro);
const titulo = esHub ? registro.titulo : registro.titulo + ' - ' + MARCA;
const descripcion = esHub ? registro.meta : metaDe(registro.texto);
const noindexPagina = !esHub && !esMensajeIndexable(registro);

const editorialHub = esHub ? editorialHubCompleto(registro, mensajesCat) : null;
const mesZodiaco = esHub && hub.grupo === 'meses' ? mesInfoPorSlug(hub.slug) : undefined;
const guiaMsg = !esHub ? guiaAdaptacionMensaje(registro, hub) : null;

const filtrosHub: { id: string; label: string; count: number }[] = [];
if (esHub) {
  const counts = new Map<string, number>();
  mensajesPagina.forEach((m) => {
    const c = clasificarMensaje(m, hub);
    counts.set(c.claseTono, (counts.get(c.claseTono) || 0) + 1);
    if (c.palabras <= 65 && c.claseTono !== 'corto') {
      counts.set('corto', (counts.get('corto') || 0) + 1);
    }
  });
  filtrosHub.push({ id: 'todos', label: 'Todos en esta página', count: mensajesPagina.length });
  const etiquetas: Record<string, string> = {
    corto: 'Breves WhatsApp',
    emotivo: 'Emotivos',
    divertido: 'Con humor',
    formal: 'Formales',
    fe: 'Con fe',
    poema: 'En verso',
    carta: 'Cartas largas',
    duelo: 'Serenos'
  };
  for (const [k, v] of counts.entries()) {
    if (v > 0 && v < mensajesPagina.length && etiquetas[k]) {
      filtrosHub.push({ id: k, label: etiquetas[k], count: v });
    }
  }
}

const migas = [{ name: 'Inicio', url: SITIO + '/' }, { name: nombreHub(hub), url: urlHub }]
  .concat(esHub ? [] : [{ name: registro.titulo, url: SITIO + '/' + registro.slug + '/' }]);
const jsonld: any[] = [migasLd(migas)];
if (esHub && editorialHub) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: registro.titulo,
    numberOfItems: mensajesCat.length,
    itemListElement: mensajesPagina.map(function (m, i) {
      return { '@type': 'ListItem', position: i + 1, name: m.titulo, url: SITIO + '/' + m.slug + '/' };
    })
  });
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: editorialHub.faqs.map(function (f) {
      return {
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta }
      };
    })
  });
}

