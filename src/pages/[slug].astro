---
import Base from '../layouts/Base.astro';
import TarjetaMensaje from '../components/TarjetaMensaje.astro';
import Compartir from '../components/Compartir.astro';
import Hermanas from '../components/Hermanas.astro';
import { contenido, POR_PAGINA, SITIO, MARCA, mensajesDe, hubDe, relacionadasDe, metaDe, nombreHub, migasLd } from '../lib/contenido.ts';
export function getStaticPaths() {
  return contenido.map(function (r) {
    return { params: { slug: r.slug }, props: { registro: r } };
  });
}
const { registro } = Astro.props;
const esHub = registro.tipo === 'hub';
const hub = hubDe(registro);
const urlHub = SITIO + '/' + hub.slug + '/';
const mensajesCat = esHub ? mensajesDe(hub.slug) : [];
const totalPaginas = Math.ceil(mensajesCat.length / POR_PAGINA);
const mensajesPagina = mensajesCat.slice(0, POR_PAGINA);
const relacionadas = esHub ? [] : relacionadasDe(registro);
const titulo = esHub ? registro.titulo : registro.titulo + ' - ' + MARCA;
const descripcion = esHub ? registro.meta : metaDe(registro.texto);
const migas = [{ name: 'Inicio', url: SITIO + '/' }, { name: nombreHub(hub), url: urlHub }]
  .concat(esHub ? [] : [{ name: registro.titulo, url: SITIO + '/' + registro.slug + '/' }]);
const jsonld: any[] = [migasLd(migas)];
if (esHub) jsonld.push({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: registro.titulo,
  numberOfItems: mensajesCat.length,
  itemListElement: mensajesPagina.map(function (m, i) {
    return { '@type': 'ListItem', position: i + 1, name: m.titulo, url: SITIO + '/' + m.slug + '/' };
  })
});
const textoEnviar = esHub ? '' : registro.titulo + '. ' + registro.texto;
const creado = hub.creado || '2026-11-15';
const actualizado = hub.actualizado || '2026-11-15';
const parrafosMsg = esHub ? [] : registro.texto.split('\n\n');
const parrafoPrincipal = esHub ? '' : (
  parrafosMsg.find(function (p) {
    const t = p.trim();
    return t.length >= 50 && !/^(Mensaje en inglés|Traducción al español):/i.test(t);
  }) || parrafosMsg.find(function (p) { return p.trim().length >= 25; }) || parrafosMsg[0] || ''
);
const extractoCard = parrafoPrincipal.replace(/\s*\n\s*/g, ' ').replace(/\s+/g, ' ').trim();
---
<Base titulo={titulo} descripcion={descripcion} jsonld={jsonld} grupoActual={hub.grupo || 'destinatarios'} slugActual={hub.slug}>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › {esHub ? <span>{nombreHub(hub)}</span> : <a href={'/' + hub.slug + '/'}>{nombreHub(hub)}</a>}
    {esHub ? null : <span> › {registro.titulo}</span>}
  </nav>
  {esHub ? (
    <div>
      <h1>{registro.h1}</h1>
      <p class="lead">{registro.lead}</p>
      <p class="contador">Encontradas {mensajesCat.length} felicitaciones</p>
      <div class="tarjeta-visual" role="img" aria-label={'Tarjeta destacada de ' + (registro.keyword || registro.h1)}>
        <div class="tarjeta-visual-emoji">{registro.emoji}</div>
        <p class="tarjeta-visual-titulo">{nombreHub(registro)}</p>
        <p class="tarjeta-visual-extracto">{mensajesCat.length} mensajes originales listos para copiar y compartir</p>
        <p class="tarjeta-visual-marca">paracumpleanos.com</p>
      </div>
      <div class="grilla">
        {mensajesPagina.map(function (m) { return <TarjetaMensaje m={m} />; })}
      </div>
      {totalPaginas > 1 ? (
        <nav class="paginacion" aria-label="Paginación">
          <span>Página 1 de {totalPaginas}</span>
          <a href={'/' + registro.slug + '/2/'}>Siguiente ›</a>
        </nav>
      ) : null}
      <p class="fechas-meta">Publicado: <time datetime={creado}>{creado}</time> · Última actualización: <time datetime={actualizado}>{actualizado}</time></p>
      <p class="firma">Escrito y revisado por el Equipo Editorial de {MARCA}. Todos los mensajes son originales.</p>
      <Hermanas hub={hub} />
    </div>
  ) : (
    <div>
      <h1>{registro.titulo}</h1>
      {parrafosMsg.map(function (p) {
        const lineas = p.split('\n');
        return (
          <p class="mensaje">
            {lineas.map(function (linea, idx) {
              return idx === 0 ? linea : <><br />{linea}</>;
            })}
          </p>
        );
      })}
      <div class="tarjeta-visual" role="img" aria-label={'Tarjeta lista para compartir: ' + registro.titulo}>
        <div class="tarjeta-visual-emoji">{hub.emoji}</div>
        <p class="tarjeta-visual-titulo">{registro.titulo}</p>
        <p class="tarjeta-visual-extracto">{extractoCard}</p>
        <p class="tarjeta-visual-marca">paracumpleanos.com</p>
      </div>
      <Compartir
        texto={textoEnviar}
        url={SITIO + '/' + registro.slug + '/'}
        tituloCard={registro.titulo}
        cuerpoCard={extractoCard}
        emojiCard={hub.emoji}
        mostrarDescarga={true}
      />
      <section class="relacionadas">
        <h2>Felicitaciones relacionadas</h2>
        <ul>
          {relacionadas.map(function (m) { return <li><a href={'/' + m.slug + '/'}>{m.titulo}</a></li>; })}
        </ul>
      </section>
      <p class="ver-tambien">Ver también: <a href={'/' + hub.slug + '/'}>{hub.titulo}</a></p>
      <Hermanas hub={hub} />
    </div>
  )}
</Base>
