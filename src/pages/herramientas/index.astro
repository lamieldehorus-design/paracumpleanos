---
import Base from '../../layouts/Base.astro';
import SelectorFechaDuelo from '../../components/SelectorFechaDuelo.astro';
import EstudioBanderines from '../../components/EstudioBanderines.astro';
import {
  SITIO,
  MARCA,
  migasLd
} from '../../lib/contenido.ts';
import {
  ZODIACOS,
  MESES_CON_SIGNOS,
  VERSOS_ACROSTICO,
  generarAcrostico,
  calcularEstadisticasCumpleanos,
  construirDedicatoriaGuiada
} from '../../lib/horoscopo.ts';
import { TEMAS_TARJETA } from '../../lib/personalizador.ts';

const titulo = `Herramientas: banderines para imprimir, edad, acróstico y duelo - ${MARCA}`;
const descripcion =
  'Creá banderines de cumpleaños para imprimir en A4, calculá edad exacta y 10.000 días, armá acrósticos y dedicatorias, y agendá cumpleaños o fechas de duelo (.ics).';

const demoCalc = calcularEstadisticasCumpleanos('1995-06-05');
const demoAcrostico = generarAcrostico('SOFÍA', 'emotivo');
const demoAcrosticoTexto = demoAcrostico.map((l) => `${l.letra} — ${l.verso}`).join('\n');
const demoDedicatoria = construirDedicatoriaGuiada({
  vinculo: 'amistad',
  tono: 'emotivo',
  nombre: 'Sofía',
  detalle: 'esos mates de los domingos escuchando sin apuro',
  firma: 'Tu amiga Laura'
});
const parrafosDemoDedicatoria = demoDedicatoria.split('\n\n');
const temasLista = Object.values(TEMAS_TARJETA);
const temaArmDefault = temasLista[0];

const faqs = [
  {
    pregunta: '¿Qué calcula exactamente la herramienta de edad y 10.000 días?',
    respuesta:
      'Calcula años, meses y días calendario exactos (contemplando años bisiestos y el ajuste del 29 de febrero), suma el total real de días y horas vividas, muestra el día de la semana en que naciste, revela la fecha de tus 10.000 días y te enlaza directo con tu signo del horóscopo y el mes de tu cumpleaños.'
  },
  {
    pregunta: '¿Mis cumpleaños agendados o mis fotos se suben a algún servidor?',
    respuesta:
      'No. Tanto tu agenda personal de cumpleaños como las fotos que sumás en el Estudio de Tarjetas funcionan 100% de forma local en tu navegador (localStorage / FileReader), sin cuentas ni envío a servidores externos.'
  },
  {
    pregunta: '¿Cómo funcionan los recordatorios anuales .ics para cumpleaños y fechas de duelo?',
    respuesta:
      'Al guardar un cumpleaños o una fecha de duelo en tu agenda podés descargar un archivo estándar de calendario (.ics) con repetición anual automática (RRULE:FREQ=YEARLY) compatible con Google Calendar, Apple Calendar y Outlook. Las fechas de duelo generan avisos sobrios "En memoria de…" enlazados a nuestra sección de condolencias.'
  },
  {
    pregunta: '¿Qué medidas tienen los banderines de cumpleaños para imprimir en hoja A4?',
    respuesta:
      'Nuestro creador genera banderines con formato clásico de 14 × 19 cm (2 banderines por hoja A4 en impresión horizontal o vertical con borde punteado de recorte y marcas de perforación). Solo escribís tu frase o nombre, elegís paleta y forma, y tocás Imprimir / Guardar PDF.'
  }
];

const jsonld = [
  migasLd([
    { name: 'Inicio', url: SITIO + '/' },
    { name: 'Herramientas de cumpleaños', url: SITIO + '/herramientas/' }
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Herramientas de cumpleaños de ParaCumpleanos',
    url: SITIO + '/herramientas/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'All',
    inLanguage: 'es',
    description: descripcion
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: f.respuesta }
    }))
  }
];

const signosCliente = ZODIACOS.map((s) => ({
  slug: s.slug,
  nombre: s.nombre,
  simbolo: s.simbolo,
  elemento: s.elemento,
  rangoTexto: s.rangoTexto,
  inicioMes: s.inicioMes,
  inicioDia: s.inicioDia,
  finMes: s.finMes,
  finDia: s.finDia,
  mesesSlugs: s.mesesSlugs,
  mesesNombres: s.mesesNombres
}));
---
<Base
  titulo={titulo}
  descripcion={descripcion}
  jsonld={jsonld}
  grupoActual="meses"
>
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <span>Herramientas</span>
  </nav>

  <h1>Herramientas de cumpleaños, banderines para imprimir y fechas de duelo</h1>
  <p class="lead">
    Seis utilidades gratuitas pensadas para resolver en minutos lo que necesitás: calcular edad exacta y signo, crear acrósticos, redactar dedicatorias en 3 pasos, agendar cumpleaños o fechas de duelo con alertas .ics, diseñar banderines de cumpleaños listos para imprimir en A4 y honrar aniversarios luctuosos.
  </p>

  <nav class="herr-nav-saltos no-print" aria-label="Ir a herramienta">
    <a href="#calculadora-edad">🎂 Edad y signo</a>
    <a href="#generador-acrostico">✍️ Acrósticos</a>
    <a href="#armador-dedicatoria">💌 Dedicatoria en 3 pasos</a>
    <a href="#agenda-cumpleanos">📅 Agenda .ics</a>
    <a href="#banderines-imprimir">🎏 Banderines para imprimir</a>
    <a href="#fecha-duelo">🕊️ Fecha de duelo</a>
  </nav>

  <!-- 1. CALCULADORA DE EDAD EXACTA, 10.000 DIAS Y HOROSCOPO -->
  <section id="calculadora-edad" class="herr-modulo" aria-labelledby="tit-calc">
    <p class="herr-modulo-kicker">Utilidad 01 · Calendario y signo</p>
    <h2 id="tit-calc">Calculadora de edad exacta, hito de 10.000 días y signo</h2>
    <p class="herr-modulo-intro">
      Ingresá una fecha de nacimiento para conocer años, meses, días y horas vividas, qué día de la semana nació esa persona, cuánto falta para el próximo festejo y el acceso directo a su horóscopo y mes de cumpleaños.
    </p>

    <div class="herr-form-grid no-print">
      <div class="herr-campo">
        <label for="herr-calc-fecha">Fecha de nacimiento</label>
        <input id="herr-calc-fecha" type="date" value="1995-06-05" max="2035-12-31" />
      </div>
      <div>
        <button id="herr-calc-btn" type="button" class="btn btn-copiar">Calcular estadísticas</button>
      </div>
    </div>

    <p id="herr-calc-error" class="personalizador-estado" role="alert" hidden></p>

    <div id="herr-calc-res">
      <div class="herr-stats-grid">
        <div class="herr-stat-caja">
          <span class="herr-stat-label">Edad exacta hoy</span>
          <strong class="herr-stat-valor" id="stat-edad">{demoCalc.anios} años, {demoCalc.meses} m, {demoCalc.dias} d</strong>
        </div>
        <div class="herr-stat-caja">
          <span class="herr-stat-label">Total vivido</span>
          <strong class="herr-stat-valor" id="stat-dias">{demoCalc.totalDiasVividos.toLocaleString('es-AR')} días</strong>
        </div>
        <div class="herr-stat-caja">
          <span class="herr-stat-label">Nació un día</span>
          <strong class="herr-stat-valor" id="stat-dia-sem">{demoCalc.diaSemanaNacimiento.charAt(0).toUpperCase() + demoCalc.diaSemanaNacimiento.slice(1)}</strong>
        </div>
        <div class="herr-stat-caja">
          <span class="herr-stat-label">Próximo cumpleaños</span>
          <strong class="herr-stat-valor" id="stat-proximo">En {demoCalc.diasParaProximoCumple} días ({demoCalc.edadProximoCumple} años)</strong>
        </div>
        <div class="herr-stat-caja">
          <span class="herr-stat-label">Hito de 10.000 días</span>
          <strong class="herr-stat-valor" id="stat-10k">{demoCalc.hito10MilDiasIso}</strong>
        </div>
        <div class="herr-stat-caja">
          <span class="herr-stat-label">Signo y elemento</span>
          <strong class="herr-stat-valor" id="stat-signo">{demoCalc.signo.simbolo} {demoCalc.signo.nombre} ({demoCalc.signo.elemento})</strong>
        </div>
      </div>

      <div class="herr-links-resultado" id="herr-calc-links">
        <a id="herr-link-signo" class="chip" href={`/horoscopo/${demoCalc.signo.slug}/`}>
          Ver perfil de {demoCalc.signo.nombre} {demoCalc.signo.simbolo} →
        </a>
        <a id="herr-link-mes" class="chip" href={`/${demoCalc.mesSlug}/`}>
          Frases de cumpleaños en {demoCalc.mesNombre} →
        </a>
        <a class="chip" href="/horoscopo/">Comparar los 12 signos →</a>
      </div>
    </div>
  </section>

  <!-- 2. GENERADOR DE ACROSTICOS POR NOMBRE -->
  <section id="generador-acrostico" class="herr-modulo" aria-labelledby="tit-acro">
    <p class="herr-modulo-kicker">Utilidad 02 · Postal con iniciales</p>
    <h2 id="tit-acro">Generador de acrósticos personalizados con nombre</h2>
    <p class="herr-modulo-intro">
      Convertí cualquier nombre o apodo en un mensaje original letra por letra. Elegí el tono que mejor encaje con el vínculo, copialo al portapapeles, bajalo como imagen PNG o imprimilo como postal.
    </p>

    <div class="herr-form-grid no-print">
      <div class="herr-campo">
        <label for="herr-acro-nombre">Nombre para el acróstico</label>
        <input id="herr-acro-nombre" type="text" maxlength="24" value="SOFÍA" placeholder="Ej.: Sofía, Mamá, Valentín" autocomplete="off" />
      </div>
      <div class="herr-campo">
        <label for="herr-acro-tono">Tono del acróstico</label>
        <select id="herr-acro-tono">
          <option value="emotivo">Emotivo y cercano</option>
          <option value="humor">Con humor y chispa</option>
          <option value="fe">Con fe y bendición</option>
        </select>
      </div>
    </div>

    <div class="acciones no-print">
      <button id="herr-acro-btn" type="button" class="btn btn-copiar">Actualizar acróstico</button>
    </div>

    <div id="herr-acro-hoja" class="herr-acrostico-hoja">
      <p class="tarjeta-visual-subtitulo no-print">ACRÓSTICO PERSONALIZADO</p>
      <p class="tarjeta-visual-titulo no-print" id="herr-acro-titulo">Acróstico para SOFÍA</p>
      <ul class="herr-acrostico-lista" id="herr-acro-lista">
        {demoAcrostico.map((item) => (
          <li>
            <strong class="herr-acrostico-letra">{item.letra}</strong>
            <span>{item.verso}</span>
          </li>
        ))}
      </ul>
      <p class="tarjeta-visual-marca">paracumpleanos.com</p>
    </div>

    <div class="acciones no-print">
      <button id="herr-acro-copiar" type="button" class="btn btn-copiar" data-text={demoAcrosticoTexto}>
        Copiar acróstico
      </button>
      <a
        id="herr-acro-wa"
        class="btn btn-wa"
        href={'https://wa.me/?text=' + encodeURIComponent(demoAcrosticoTexto)}
        target="_blank"
        rel="noopener"
      >
        WhatsApp
      </a>
      <button
        id="herr-acro-dl"
        type="button"
        class="btn btn-descargar"
        data-title="Acróstico para SOFÍA"
        data-mostrar-titulo="1"
        data-body={demoAcrosticoTexto}
        data-emoji="✍️"
      >
        Descargar PNG
      </button>
      <button type="button" class="btn btn-imprimir">Imprimir postal</button>
    </div>
  </section>

  <!-- 3. ARMADOR GUIADO DE DEDICATORIA EN 3 PASOS -->
  <section id="armador-dedicatoria" class="herr-modulo" aria-labelledby="tit-arm">
    <p class="herr-modulo-kicker">Utilidad 03 · Redactor asistido</p>
    <h2 id="tit-arm">Armador guiado de dedicatoria en 3 pasos</h2>
    <p class="herr-modulo-intro">
      Combiná vínculo, tono y un recuerdo concreto real para obtener al instante una dedicatoria de tres párrafos que no suena copiada en serie.
    </p>

    <div class="herr-form-grid no-print">
      <div class="herr-campo">
        <label for="herr-arm-vinculo">Paso 1: Vínculo con quien cumple</label>
        <select id="herr-arm-vinculo">
          <option value="amistad" selected>Amistad cercana</option>
          <option value="familia">Familia (mamá, papá, hijos, hermanos)</option>
          <option value="pareja">Pareja / Novio / Esposa</option>
          <option value="trabajo">Trabajo / Colega / Jefe</option>
        </select>
      </div>
      <div class="herr-campo">
        <label for="herr-arm-tono">Paso 2: Tono principal</label>
        <select id="herr-arm-tono">
          <option value="emotivo" selected>Emotivo y profundo</option>
          <option value="breve">Breve y directo para WhatsApp</option>
          <option value="humor">Con humor cálido</option>
          <option value="fe">Con fe y gratitud</option>
        </select>
      </div>
      <div class="herr-campo">
        <label for="herr-arm-nombre">Nombre o apodo (opcional)</label>
        <input id="herr-arm-nombre" type="text" maxlength="36" value="Sofía" placeholder="Ej.: Sofía, Papá, Martín" autocomplete="off" />
      </div>
      <div class="herr-campo">
        <label for="herr-arm-firma">Tu firma (opcional)</label>
        <input id="herr-arm-firma" type="text" maxlength="36" value="Tu amiga Laura" placeholder="Ej.: Tu hija Sofi" autocomplete="off" />
      </div>
      <div class="herr-campo" style="grid-column: 1 / -1;">
        <label for="herr-arm-detalle">Paso 3: Anécdota, rasgo o recuerdo real (opcional)</label>
        <input
          id="herr-arm-detalle"
          type="text"
          maxlength="140"
          value="esos mates de los domingos escuchando sin apuro"
          placeholder="Ej.: tu apoyo en la mudanza, nuestras charlas del viernes…"
          autocomplete="off"
        />
      </div>
    </div>

    <div class="acciones no-print">
      <button id="herr-arm-btn" type="button" class="btn btn-copiar">Actualizar dedicatoria</button>
    </div>

    <div class="herr-arm-estilo no-print">
      <div class="herr-arm-paletas" role="group" aria-label="Color de postal del armador">
        <span class="herr-arm-estilo-label">Paleta de postal:</span>
        {temasLista.map((tema, idx) => (
          <button
            type="button"
            class={'pers-tema-btn' + (idx === 0 ? ' activo' : '')}
            data-arm-tema={tema.id}
            data-inicio={tema.inicio}
            data-medio={tema.medio}
            data-fin={tema.fin}
            data-borde={tema.borde}
            data-acento={tema.acento}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            <span class="pers-swatch" style={`background:${tema.fondoCss};border-color:${tema.borde}`}></span>
            <span>{tema.nombre}</span>
          </button>
        ))}
      </div>
      <div class="herr-arm-formatos" role="group" aria-label="Formato de descarga PNG del armador">
        <span class="herr-arm-estilo-label">Formato PNG:</span>
        <button type="button" class="pers-chip-btn pers-chip-texto activo" data-arm-formato="cuadrada" aria-pressed="true">Cuadrada (1:1)</button>
        <button type="button" class="pers-chip-btn pers-chip-texto" data-arm-formato="story" aria-pressed="false">Story IG (9:16)</button>
      </div>
    </div>

    <div
      id="herr-arm-visual"
      class="tarjeta-visual"
      role="img"
      aria-label="Vista previa postal de dedicatoria personalizada"
      data-formato="cuadrada"
      data-fuente="editorial"
      data-subtitulo="Para Sofía"
      data-tema-inicio={temaArmDefault.inicio}
      data-tema-medio={temaArmDefault.medio}
      data-tema-fin={temaArmDefault.fin}
      data-tema-borde={temaArmDefault.borde}
      data-tema-acento={temaArmDefault.acento}
    >
      <div class="tarjeta-visual-emoji">💌</div>
      <p class="tarjeta-visual-subtitulo" id="herr-arm-vis-sub">PARA SOFÍA</p>
      <p class="tarjeta-visual-titulo" id="herr-arm-vis-titulo">Feliz cumpleaños, Sofía</p>
      <div class="tarjeta-visual-extracto" id="herr-arm-vis-cuerpo">
        {parrafosDemoDedicatoria.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <p class="tarjeta-visual-marca">paracumpleanos.com</p>
    </div>

    <div id="herr-arm-salida" class="herr-dedicatoria-salida no-print">
      {parrafosDemoDedicatoria.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <div class="acciones no-print">
      <button id="herr-arm-copiar" type="button" class="btn btn-copiar" data-text={demoDedicatoria}>
        Copiar dedicatoria
      </button>
      <a
        id="herr-arm-wa"
        class="btn btn-wa"
        href={'https://wa.me/?text=' + encodeURIComponent(demoDedicatoria)}
        target="_blank"
        rel="noopener"
      >
        WhatsApp
      </a>
      <button
        id="herr-arm-ig"
        type="button"
        class="btn btn-ig"
        data-ig-title="Feliz cumpleaños, Sofía"
        data-ig-body={demoDedicatoria}
        data-ig-emoji="💌"
        data-ig-text={demoDedicatoria}
        data-ig-subtitulo="Para Sofía"
      >
        Instagram
      </button>
      <button
        id="herr-arm-dl"
        type="button"
        class="btn btn-descargar"
        data-title="Feliz cumpleaños, Sofía"
        data-body={demoDedicatoria}
        data-emoji="💌"
        data-subtitulo="Para Sofía"
      >
        Descargar postal PNG
      </button>
      <button type="button" class="btn btn-imprimir">Imprimir postal</button>
    </div>
  </section>

  <!-- 4. AGENDA PRIVADA CON RECORDATORIOS ANUALES .ICS -->
  <section id="agenda-cumpleanos" class="herr-modulo" aria-labelledby="tit-ag">
    <p class="herr-modulo-kicker">Utilidad 04 · Calendario local</p>
    <h2 id="tit-ag">Agenda privada de cumpleaños y fechas de duelo (.ics)</h2>
    <p class="herr-modulo-intro">
      Anotá cumpleaños y fechas de recuerdo importantes en este dispositivo. Calculamos cuántos días faltan, enlazamos el signo o las condolencias según corresponda, y podés bajar cada evento o toda tu agenda junta en formato universal <code>.ics</code>.
    </p>

    <details class="ics-explicacion no-print" open>
      <summary>¿Qué es un archivo <strong>.ics</strong> y para qué sirve en tus fechas importantes?</summary>
      <p>
        Un archivo <strong>.ics</strong> (estándar <em>iCalendar</em>) es un recordatorio universal que aceptan <strong>Google Calendar</strong>, <strong>Apple Calendario</strong> (iPhone/Mac) y <strong>Outlook</strong>. Al descargarlo y abrirlo una sola vez en tu celular o computadora, agenda la fecha automáticamente con <strong>repetición todos los años</strong> y avisos previos, funcionando incluso cuando cerrás este sitio. Si elegís <strong>Fecha de duelo</strong>, el recordatorio se crea con tono sobrio y enlace directo a <a href="/condolencias/">Condolencias</a>.
      </p>
    </details>

    <form id="herr-ag-form" class="herr-form-grid no-print" novalidate>
      <div class="herr-campo">
        <label for="herr-ag-tipo">Tipo de fecha</label>
        <select id="herr-ag-tipo">
          <option value="cumpleanos" selected>🎂 Cumpleaños</option>
          <option value="duelo">🕊️ Fecha de duelo / En memoria</option>
        </select>
      </div>
      <div class="herr-campo">
        <label for="herr-ag-nombre">Nombre de la persona</label>
        <input id="herr-ag-nombre" type="text" required maxlength="40" placeholder="Ej.: Mamá, Juan, Abuelo Carlos" />
      </div>
      <div class="herr-campo">
        <label for="herr-ag-relacion">Vínculo o nota</label>
        <select id="herr-ag-relacion">
          <option value="Familia">Familia</option>
          <option value="Amistad">Amistad</option>
          <option value="Pareja">Pareja</option>
          <option value="Trabajo">Trabajo</option>
        </select>
      </div>
      <div class="herr-campo">
        <label for="herr-ag-mes">Mes</label>
        <select id="herr-ag-mes">
          {MESES_CON_SIGNOS.map((m) => (
            <option value={m.mesNum}>{m.nombreCap}</option>
          ))}
        </select>
      </div>
      <div class="herr-campo">
        <label for="herr-ag-dia">Día (1 a 31)</label>
        <input id="herr-ag-dia" type="number" min="1" max="31" required value="15" />
      </div>
      <div style="grid-column: 1 / -1;">
        <button id="herr-ag-btn" type="submit" class="btn btn-copiar">Guardar en mi agenda local</button>
      </div>
      <p id="herr-ag-error" class="herr-ag-error" style="grid-column: 1 / -1;" hidden></p>
    </form>

    <div id="herr-ag-barra" class="acciones no-print" hidden>
      <button id="herr-ag-exportar-todo" type="button" class="btn btn-descargar">Exportar toda mi agenda (.ics)</button>
      <button id="herr-ag-vaciar" type="button" class="pers-limpiar">Vaciar agenda</button>
    </div>

    <ul id="herr-ag-lista" class="herr-agenda-lista" aria-live="polite"></ul>
    <p id="herr-ag-vacio" class="texto-ayuda">
      Todavía no cargaste fechas en este navegador. Probá sumar tu primer cumpleaños o fecha de duelo arriba para agendarlo en Google Calendar o descargar su alerta anual <code>.ics</code>.
    </p>
  </section>

  <!-- 5. CREADOR DE BANDERINES DE CUMPLEANOS PARA IMPRIMIR (A4) -->
  <section id="banderines-imprimir" class="herr-modulo" aria-labelledby="tit-banderines">
    <p class="herr-modulo-kicker">Utilidad 05 · Imprimible gratis en A4</p>
    <h2 id="tit-banderines">Estudio online de banderines de cumpleaños para imprimir y descargar</h2>
    <p class="herr-modulo-intro">
      Elegí entre 12 plantillas visuales o empezá desde cero, subí tu propia foto o logo local, personalizá la frase, forma y colores, y descargá la guirnalda completa en PNG HD o imprimí hojas A4 listas para recortar (2 banderines de 14 × 19 cm por hoja).
    </p>

    <EstudioBanderines modo="herramientas" />

    <p class="ver-tambien no-print">
      ¿Querés ver las 40 ideas prearmadas por estilo? Visitá <a href="/banderines-de-cumpleanos-para-imprimir/">Banderines de cumpleaños para imprimir (40 diseños) →</a> o leé la <a href="/guias/banderines-de-cumpleanos-para-imprimir-medidas-y-plantillas/">guía de medidas y papeles →</a>.
    </p>
  </section>

  <!-- 6. SELECTOR DE FECHA DE DUELO Y RECORDATORIO SERENO -->
  <section id="fecha-duelo" class="herr-modulo no-print" aria-labelledby="tit-duelo-herr">
