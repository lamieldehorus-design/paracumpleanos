  <script id="herr-signos-json" type="application/json" set:html={JSON.stringify(signosCliente)} />
  <script id="herr-meses-json" type="application/json" set:html={JSON.stringify(MESES_CON_SIGNOS)} />
  <script id="herr-versos-json" type="application/json" set:html={JSON.stringify(VERSOS_ACROSTICO)} />

  <script is:inline>
    (function () {
      var SIGNOS = [];
      var MESES = [];
      var VERSOS = {};
      try {
        SIGNOS = JSON.parse((document.getElementById('herr-signos-json') || {}).textContent || '[]');
        MESES = JSON.parse((document.getElementById('herr-meses-json') || {}).textContent || '[]');
        VERSOS = JSON.parse((document.getElementById('herr-versos-json') || {}).textContent || '{}');
      } catch (e) {}

      var DIAS_SEM = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];

      function esBisiesto(a) {
        return (a % 4 === 0 && a % 100 !== 0) || a % 400 === 0;
      }

      function diasEnMes(a, m) {
        return new Date(Date.UTC(a, m, 0)).getUTCDate();
      }

      function resolverSigno(mes, dia) {
        for (var i = 0; i < SIGNOS.length; i++) {
          var s = SIGNOS[i];
          if ((mes === s.inicioMes && dia >= s.inicioDia) || (mes === s.finMes && dia <= s.finDia)) {
            return s;
          }
        }
        return SIGNOS[0];
      }

      // 1. CALCULADORA DE EDAD Y SIGNO
      var inpFecha = document.getElementById('herr-calc-fecha');
      var btnCalc = document.getElementById('herr-calc-btn');
      var errCalc = document.getElementById('herr-calc-error');

      function ejecutarCalculo() {
        if (!inpFecha) return;
        var val = String(inpFecha.value || '').trim();
        var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(val);
        if (!m) {
          if (errCalc) { errCalc.textContent = 'Ingresá una fecha válida completa.'; errCalc.hidden = false; }
          return;
        }
        var aNac = Number(m[1]), mNac = Number(m[2]), dNac = Number(m[3]);
        var dtNac = new Date(Date.UTC(aNac, mNac - 1, dNac));
        if (dtNac.getUTCFullYear() !== aNac || dtNac.getUTCMonth() + 1 !== mNac || dtNac.getUTCDate() !== dNac) {
          if (errCalc) { errCalc.textContent = 'Esa fecha no existe en el calendario.'; errCalc.hidden = false; }
          return;
        }
        var hoyLocal = new Date();
        var dtRef = new Date(Date.UTC(hoyLocal.getFullYear(), hoyLocal.getMonth(), hoyLocal.getDate()));
        if (dtNac.getTime() > dtRef.getTime()) {
          if (errCalc) { errCalc.textContent = 'Elegí una fecha de nacimiento anterior o igual a hoy.'; errCalc.hidden = false; }
          return;
        }
        if (errCalc) errCalc.hidden = true;

        var aRef = dtRef.getUTCFullYear(), mRef = dtRef.getUTCMonth() + 1, dRef = dtRef.getUTCDate();
        var anios = aRef - aNac, meses = mRef - mNac, dias = dRef - dNac;
        if (dias < 0) {
          meses -= 1;
          var mp = mRef === 1 ? 12 : mRef - 1;
          var ap = mRef === 1 ? aRef - 1 : aRef;
          dias += diasEnMes(ap, mp);
        }
        if (meses < 0) {
          anios -= 1;
          meses += 12;
        }

        var msDia = 86400000;
        var totalDias = Math.round((dtRef.getTime() - dtNac.getTime()) / msDia);
        var diaSem = DIAS_SEM[dtNac.getUTCDay()];
        var diaCap = diaSem.charAt(0).toUpperCase() + diaSem.slice(1);

        function cumpleEn(y) {
          var adj = mNac === 2 && dNac === 29 && !esBisiesto(y) ? 28 : dNac;
          return new Date(Date.UTC(y, mNac - 1, adj));
        }
        var prox = cumpleEn(aRef);
        if (prox.getTime() < dtRef.getTime()) prox = cumpleEn(aRef + 1);
        var falta = Math.round((prox.getTime() - dtRef.getTime()) / msDia);
        var edadProx = prox.getUTCFullYear() - aNac;
        var d10k = new Date(dtNac.getTime() + 10000 * msDia).toISOString().slice(0, 10);

        var signo = resolverSigno(mNac, dNac);
        var mesObj = MESES[mNac - 1];

        var elEdad = document.getElementById('stat-edad');
        var elDias = document.getElementById('stat-dias');
        var elDiaSem = document.getElementById('stat-dia-sem');
        var elProx = document.getElementById('stat-proximo');
        var el10k = document.getElementById('stat-10k');
        var elSigno = document.getElementById('stat-signo');
        var lnkSigno = document.getElementById('herr-link-signo');
        var lnkMes = document.getElementById('herr-link-mes');

        if (elEdad) elEdad.textContent = anios + ' años, ' + meses + ' m, ' + dias + ' d';
        if (elDias) elDias.textContent = totalDias.toLocaleString('es-AR') + ' días';
        if (elDiaSem) elDiaSem.textContent = diaCap;
        if (elProx) {
          elProx.textContent = falta === 0
            ? '¡Hoy cumple ' + edadProx + ' años! 🎉'
            : 'En ' + falta + ' días (' + edadProx + ' años)';
        }
        if (el10k) el10k.textContent = d10k + (totalDias >= 10000 ? ' (ya vivido)' : ' (próximo)');
        if (elSigno && signo) elSigno.textContent = signo.simbolo + ' ' + signo.nombre + ' (' + signo.elemento + ')';
        if (lnkSigno && signo) {
          lnkSigno.href = '/horoscopo/' + signo.slug + '/';
          lnkSigno.textContent = 'Ver perfil de ' + signo.nombre + ' ' + signo.simbolo + ' →';
        }
        if (lnkMes && mesObj) {
          lnkMes.href = '/' + mesObj.slug + '/';
          lnkMes.textContent = 'Frases de cumpleaños en ' + mesObj.nombreCap + ' →';
        }
      }

      if (btnCalc) btnCalc.addEventListener('click', ejecutarCalculo);
      if (inpFecha) inpFecha.addEventListener('change', ejecutarCalculo);
      ejecutarCalculo();

      // 2. GENERADOR DE ACROSTICOS
      var inpAcroNom = document.getElementById('herr-acro-nombre');
      var selAcroTono = document.getElementById('herr-acro-tono');
      var btnAcro = document.getElementById('herr-acro-btn');
      var ulAcro = document.getElementById('herr-acro-lista');
      var titAcro = document.getElementById('herr-acro-titulo');
      var btnAcroCop = document.getElementById('herr-acro-copiar');
      var btnAcroWa = document.getElementById('herr-acro-wa');
      var btnAcroDl = document.getElementById('herr-acro-dl');

      function normLetra(ch) {
        var u = ch.toUpperCase();
        if (u === 'Ñ') return 'Ñ';
        return u.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      }

      function actualizarAcrostico() {
        var raw = String((inpAcroNom && inpAcroNom.value) || 'SOFÍA').trim();
        var tono = (selAcroTono && selAcroTono.value) || 'emotivo';
        var letras = Array.from(raw).filter(function (c) {
          return /[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]/.test(c);
        });
        if (!letras.length) letras = ['A', 'M', 'O', 'R'];

        var dic = VERSOS[tono] || VERSOS.emotivo || {};
        var usados = {};
        var lineas = letras.map(function (orig) {
          var base = normLetra(orig);
          var ops = dic[base] || ['Alegría sincera y paz duradera en este nuevo año para vos'];
          var idx = usados[base] || 0;
          usados[base] = idx + 1;
          return { letra: orig.toUpperCase(), verso: ops[idx % ops.length] };
        });

        var nombreShow = letras.join('').toUpperCase();
        var tituloCard = 'Acróstico para ' + nombreShow;
        if (titAcro) titAcro.textContent = tituloCard;
        if (ulAcro) {
          ulAcro.innerHTML = '';
          lineas.forEach(function (it) {
            var li = document.createElement('li');
            var st = document.createElement('strong');
            st.className = 'herr-acrostico-letra';
            st.textContent = it.letra;
            var sp = document.createElement('span');
            sp.textContent = it.verso;
            li.appendChild(st);
            li.appendChild(sp);
            ulAcro.appendChild(li);
          });
        }

        var cuerpo = lineas.map(function (it) { return it.letra + ' — ' + it.verso; }).join('\n');
        var cuerpoCopia = cuerpo;
        if (btnAcroCop) btnAcroCop.setAttribute('data-text', cuerpoCopia);
        if (btnAcroWa) btnAcroWa.setAttribute('href', 'https://wa.me/?text=' + encodeURIComponent(cuerpoCopia));
        if (btnAcroDl) {
          btnAcroDl.setAttribute('data-title', tituloCard);
          btnAcroDl.setAttribute('data-mostrar-titulo', '1');
          btnAcroDl.setAttribute('data-body', cuerpo);
        }
      }

      if (btnAcro) btnAcro.addEventListener('click', actualizarAcrostico);
      if (inpAcroNom) inpAcroNom.addEventListener('input', actualizarAcrostico);
      if (selAcroTono) selAcroTono.addEventListener('change', actualizarAcrostico);

      // 3. ARMADOR EN 3 PASOS + POSTAL VISUAL EN VIVO
      var selVinculo = document.getElementById('herr-arm-vinculo');
      var selTono = document.getElementById('herr-arm-tono');
      var inpArmNom = document.getElementById('herr-arm-nombre');
      var inpArmFir = document.getElementById('herr-arm-firma');
      var inpArmDet = document.getElementById('herr-arm-detalle');
      var btnArm = document.getElementById('herr-arm-btn');
      var outArm = document.getElementById('herr-arm-salida');
      var visArm = document.getElementById('herr-arm-visual');
      var visArmSub = document.getElementById('herr-arm-vis-sub');
      var visArmTit = document.getElementById('herr-arm-vis-titulo');
      var visArmCuerpo = document.getElementById('herr-arm-vis-cuerpo');
      var btnArmCop = document.getElementById('herr-arm-copiar');
      var btnArmWa = document.getElementById('herr-arm-wa');
      var btnArmIg = document.getElementById('herr-arm-ig');
      var btnArmDl = document.getElementById('herr-arm-dl');
      var formatoArm = 'cuadrada';

      var APERTURAS = {
        familia: {
          emotivo: ['Querido/a ', ', hoy celebramos tu vida agradeciendo todo lo que sumás en nuestra mesa.', 'Hoy celebramos tu vida agradeciendo todo lo que sumás en nuestra mesa familiar.'],
          breve: ['¡Muy feliz cumpleaños, ', '! Que nunca te falten salud, calma y abrazos cerca de casa.', '¡Muy feliz cumpleaños! Que nunca te falten salud, calma y abrazos cerca de casa.'],
          humor: ['¡Feliz vuelta al sol, ', '! Prometemos no contar las velas si guardás la mejor porción de torta.', '¡Feliz vuelta al sol! Prometemos no contar las velas si guardás la mejor porción de torta.'],
          fe: ['', ', damos gracias a Dios por tu vida y pedimos que Su paz abrace cada día de tu año nuevo.', 'Damos gracias a Dios por tu vida y pedimos que Su paz abrace cada día de tu año nuevo.']
        },
        pareja: {
          emotivo: ['', ', mi amor: gracias por transformar los días comunes en mi lugar favorito del mundo.', 'Mi amor, gracias por transformar los días comunes en mi lugar favorito del mundo.'],
          breve: ['¡Feliz cumple, ', '! Qué suerte celebrar otro año caminando codo a codo.', '¡Feliz cumple! Qué suerte celebrar otro año caminando codo a codo.'],
          humor: ['¡Feliz cumple, ', '! Hoy elegís vos la comida y prometo no discutir ni un minuto.', '¡Feliz cumple! Hoy elegís vos la comida y prometo no discutir ni un minuto.'],
          fe: ['', ', agradezco a Dios haber cruzado nuestros caminos; que nos siga regalando paz y alegría juntos.', 'Agradezco a Dios haber cruzado nuestros caminos; que nos siga regalando paz y alegría juntos.']
        },
        amistad: {
          emotivo: ['', ', gracias por esa amistad leal que salva hasta las semanas más pesadas con una charla sincera.', 'Gracias por esa amistad leal que salva hasta las semanas más pesadas con una charla sincera.'],
          breve: ['¡Feliz cumple, ', '! Por muchas risas, mates y planes buenos este año nuevo.', '¡Feliz cumple! Por muchas risas, mates y planes buenos este año nuevo.'],
          humor: ['', ', ¡feliz cumple! Otro año más fingiendo ser adultos responsables pero riéndonos igual que siempre.', '¡Feliz cumple! Otro año más fingiendo ser adultos responsables pero riéndonos igual que siempre.'],
          fe: ['', ', que Dios bendiga tu vida generosa y te regale un año sereno rodeado de afectos fieles.', 'Que Dios bendiga tu vida generosa y te regale un año sereno rodeado de afectos fieles.']
        },
        trabajo: {
          emotivo: ['Estimado/a ', ', le deseo un muy feliz cumpleaños y un excelente año personal lleno de proyectos serenos.', 'Le deseo un muy feliz cumpleaños y un excelente año personal lleno de proyectos serenos.'],
          breve: ['¡Muy feliz cumpleaños, ', '! Mis mejores deseos de salud y éxito en este nuevo ciclo.', '¡Muy feliz cumpleaños! Mis mejores deseos de salud y éxito en este nuevo ciclo.'],
          humor: ['¡Feliz cumpleaños, ', '! Hoy permiso oficial para cerrar planillas temprano y brindar tranquilo.', '¡Feliz cumpleaños! Hoy permiso oficial para cerrar planillas temprano y brindar tranquilo.'],
          fe: ['', ', que este nuevo año esté lleno de bendiciones, salud firme y satisfacciones en su tarea diaria.', 'Que este nuevo año esté lleno de bendiciones, salud firme y satisfacciones en su tarea diaria.']
        }
      };

      var CIERRES = {
        emotivo: 'Que los próximos doce meses traigan descanso verdadero, salud firme y motivos para brindar sin apuro.',
        breve: '¡Disfrutá muchísimo tu día rodeado de gente buena!',
        humor: 'Guardá porción de torta para el próximo brindis que nos debemos.',
        fe: 'Que nunca falte abrigo espiritual ni alegría en tu hogar.'
      };

      function renderParrafosEnContenedor(el, texto) {
        if (!el) return;
        el.innerHTML = '';
        String(texto || '').split(/\n{2,}/).forEach(function (bloque) {
          var limpio = bloque.trim();
          if (!limpio) return;
          var p = document.createElement('p');
          p.textContent = limpio;
          el.appendChild(p);
        });
      }

      function armarDedicatoria() {
        var v = (selVinculo && selVinculo.value) || 'amistad';
        var t = (selTono && selTono.value) || 'emotivo';
        var nom = String((inpArmNom && inpArmNom.value) || '').trim();
        var fir = String((inpArmFir && inpArmFir.value) || '').trim().replace(/^[—–-]\s*/, '');
        var det = String((inpArmDet && inpArmDet.value) || '').trim();

        var apDef = (APERTURAS[v] && APERTURAS[v][t]) || APERTURAS.amistad.emotivo;
        var b1 = nom ? (apDef[0] + nom + apDef[1]) : apDef[2];
        var b2 = '';
        if (det) {
          var detMin = det.charAt(0).toLowerCase() + det.slice(1).replace(/\.$/, '');
          b2 = v === 'trabajo'
            ? 'Siempre se valora muchísimo ' + detMin + '.'
            : 'Todavía atesoro ' + detMin + '; en esos gestos reales se nota lo grande que sos.';
        }
        var b3 = CIERRES[t] || CIERRES.emotivo;
        var texto = [b1, b2, b3].filter(Boolean).join('\n\n') + (fir ? '\n\n— ' + fir : '');
        var tituloPostal = nom ? 'Feliz cumpleaños, ' + nom : 'Dedicatoria personalizada';
        var subPostal = nom ? 'Para ' + nom : 'Postal personalizada';

        renderParrafosEnContenedor(outArm, texto);
        renderParrafosEnContenedor(visArmCuerpo, texto);
        if (visArmTit) visArmTit.textContent = tituloPostal;
        if (visArmSub) visArmSub.textContent = subPostal.toUpperCase();
        if (visArm) {
          visArm.setAttribute('data-subtitulo', subPostal);
          visArm.setAttribute('data-formato', formatoArm);
        }

        if (btnArmCop) btnArmCop.setAttribute('data-text', texto);
        if (btnArmWa) btnArmWa.setAttribute('href', 'https://wa.me/?text=' + encodeURIComponent(texto));
        if (btnArmIg) {
          btnArmIg.setAttribute('data-ig-title', tituloPostal);
          btnArmIg.setAttribute('data-ig-body', texto);
          btnArmIg.setAttribute('data-ig-text', texto);
          btnArmIg.setAttribute('data-ig-subtitulo', subPostal);
          btnArmIg.setAttribute('data-formato', formatoArm);
        }
        if (btnArmDl) {
          btnArmDl.setAttribute('data-title', tituloPostal);
          btnArmDl.setAttribute('data-body', texto);
          btnArmDl.setAttribute('data-subtitulo', subPostal);
          btnArmDl.setAttribute('data-formato', formatoArm);
        }
      }

      document.querySelectorAll('[data-arm-tema]').forEach(function (btnTema) {
        btnTema.addEventListener('click', function () {
          document.querySelectorAll('[data-arm-tema]').forEach(function (b) {
            var act = b === btnTema;
            b.classList.toggle('activo', act);
            b.setAttribute('aria-pressed', act ? 'true' : 'false');
          });
          if (!visArm) return;
          var ini = btnTema.getAttribute('data-inicio') || '#fdf2f8';
          var med = btnTema.getAttribute('data-medio') || '#fff7ed';
          var fin = btnTema.getAttribute('data-fin') || '#e0f2fe';
          var bor = btnTema.getAttribute('data-borde') || '#e11d74';
          var ace = btnTema.getAttribute('data-acento') || '#9f1239';
          visArm.setAttribute('data-tema-inicio', ini);
          visArm.setAttribute('data-tema-medio', med);
          visArm.setAttribute('data-tema-fin', fin);
          visArm.setAttribute('data-tema-borde', bor);
          visArm.setAttribute('data-tema-acento', ace);
          visArm.style.background = 'linear-gradient(135deg, ' + ini + ', ' + med + ' 55%, ' + fin + ')';
          visArm.style.borderColor = bor;
          if (visArmTit) visArmTit.style.color = ace;
        });
      });

      document.querySelectorAll('[data-arm-formato]').forEach(function (btnFmt) {
        btnFmt.addEventListener('click', function () {
          formatoArm = btnFmt.getAttribute('data-arm-formato') || 'cuadrada';
          document.querySelectorAll('[data-arm-formato]').forEach(function (b) {
            var act = b === btnFmt;
            b.classList.toggle('activo', act);
            b.setAttribute('aria-pressed', act ? 'true' : 'false');
          });
          if (visArm) {
            visArm.setAttribute('data-formato', formatoArm);
            visArm.classList.toggle('formato-story', formatoArm === 'story');
          }
          armarDedicatoria();
        });
      });

      if (btnArm) btnArm.addEventListener('click', armarDedicatoria);
      [selVinculo, selTono, inpArmNom, inpArmFir, inpArmDet].forEach(function (el) {
        if (!el) return;
        el.addEventListener('input', armarDedicatoria);
        el.addEventListener('change', armarDedicatoria);
      });
      armarDedicatoria();

      // 4. AGENDA PRIVADA DE CUMPLEANOS CON DESCARGA .ICS + GOOGLE CALENDAR
      var STORAGE_AG = 'pc_agenda_cumples_v1';
      var formAg = document.getElementById('herr-ag-form');
      var ulAg = document.getElementById('herr-ag-lista');
      var vacioAg = document.getElementById('herr-ag-vacio');
      var barraAg = document.getElementById('herr-ag-barra');
      var errAg = document.getElementById('herr-ag-error');
      var btnExpTodo = document.getElementById('herr-ag-exportar-todo');
      var btnVaciarAg = document.getElementById('herr-ag-vaciar');

      function cargarAgenda() {
        try {
          var datos = JSON.parse(localStorage.getItem(STORAGE_AG) || '[]');
          return Array.isArray(datos) ? datos : [];
        } catch (e) {
          return [];
        }
      }

      function guardarAgenda(lista) {
        try {
          localStorage.setItem(STORAGE_AG, JSON.stringify(lista));
        } catch (e) {}
      }

      function diasHasta(mes, dia) {
        var hoy = new Date();
        var ref = new Date(Date.UTC(hoy.getFullYear(), hoy.getMonth(), hoy.getDate()));
        function fechaAnio(y) {
          var adj = mes === 2 && dia === 29 && !esBisiesto(y) ? 28 : dia;
          return new Date(Date.UTC(y, mes - 1, adj));
        }
        var prox = fechaAnio(ref.getUTCFullYear());
        if (prox.getTime() < ref.getTime()) prox = fechaAnio(ref.getUTCFullYear() + 1);
        return Math.round((prox.getTime() - ref.getTime()) / 86400000);
      }

      function escaparIcsCli(texto) {
        return String(texto || '')
          .replace(/\\/g, '\\\\')
          .replace(/\r?\n/g, '\\n')
          .replace(/;/g, '\\;')
          .replace(/,/g, '\\,');
      }

      function construirBloqueVeventCli(item, stamp) {
        var anio = new Date().getFullYear();
        if (item.mes === 2 && item.dia === 29 && !esBisiesto(anio)) {
          while (!esBisiesto(anio)) anio += 1;
        }
        var mm = String(item.mes).padStart(2, '0');
        var dd = String(item.dia).padStart(2, '0');
        var dt = anio + mm + dd;
        var dtEnd = new Date(Date.UTC(anio, item.mes - 1, item.dia + 1)).toISOString().slice(0, 10).replace(/-/g, '');
        var mesObj = MESES[item.mes - 1] || MESES[0];
        var signo = resolverSigno(item.mes, item.dia);
        var rel = item.relacion ? ' (' + item.relacion + ')' : '';
        var esDuelo = item.tipo === 'duelo';
        var uidBase = item.nombre.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'fecha';
        var uid = (esDuelo ? 'duelo-' : 'cumple-') + uidBase + '-' + mm + dd + '@paracumpleanos.com';
        var resumen = esDuelo ? 'En memoria de ' + item.nombre + rel : 'Cumpleaños de ' + item.nombre + rel;
        var desc = esDuelo
          ? 'Fecha de recuerdo y homenaje en ParaCumpleanos.com. Palabras serenas en https://paracumpleanos.com/condolencias/'
          : 'Recordatorio anual ParaCumpleanos.com (' + signo.nombre + '). Ideas en https://paracumpleanos.com/' + mesObj.slug + '/ y https://paracumpleanos.com/horoscopo/' + signo.slug + '/';
        var avisoPrevio = esDuelo ? 'En 2 días se cumple una fecha de recuerdo por ' + item.nombre : 'Faltan 2 días para el cumpleaños de ' + item.nombre;
        var avisoDia = esDuelo ? 'En memoria de ' + item.nombre : 'Hoy cumple años ' + item.nombre;
        return [
          'BEGIN:VEVENT',
          'UID:' + uid,
          'DTSTAMP:' + stamp,
          'DTSTART;VALUE=DATE:' + dt,
          'DTEND;VALUE=DATE:' + dtEnd,
          'RRULE:FREQ=YEARLY',
          'SUMMARY:' + escaparIcsCli(resumen),
          'DESCRIPTION:' + escaparIcsCli(desc),
          'BEGIN:VALARM',
          'TRIGGER:-P2D',
          'ACTION:DISPLAY',
          'DESCRIPTION:' + escaparIcsCli(avisoPrevio),
          'END:VALARM',
          'BEGIN:VALARM',
          'TRIGGER;RELATED=START:PT9H',
          'ACTION:DISPLAY',
          'DESCRIPTION:' + escaparIcsCli(avisoDia),
          'END:VALARM',
          'END:VEVENT'
        ].join('\r\n');
      }

      function generarContenidoIcs(item) {
        var stamp = new Date().toISOString().replace(/[-:]/g, '').slice(0, 15) + 'Z';
        return [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//ParaCumpleanos//Agenda Cumpleanos//ES',
          'CALSCALE:GREGORIAN',
          construirBloqueVeventCli(item, stamp),
          'END:VCALENDAR'
        ].join('\r\n');
      }

      function generarIcsAgendaCompleta(lista) {
        var stamp = new Date().toISOString().replace(/[-:]/g, '').slice(0, 15) + 'Z';
        var bloques = lista.map(function (item) {
          return construirBloqueVeventCli(item, stamp);
        });
        return [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//ParaCumpleanos//Agenda Cumpleanos//ES',
          'CALSCALE:GREGORIAN',
          'X-WR-CALNAME:Agenda Personal - ParaCumpleanos'
        ].concat(bloques, ['END:VCALENDAR']).join('\r\n');
      }

      function urlGoogleCalendarCli(item) {
        var anio = new Date().getFullYear();
        if (item.mes === 2 && item.dia === 29 && !esBisiesto(anio)) {
          while (!esBisiesto(anio)) anio += 1;
        }
        var mm = String(item.mes).padStart(2, '0');
        var dd = String(item.dia).padStart(2, '0');
        var dt = anio + mm + dd;
        var dtEnd = new Date(Date.UTC(anio, item.mes - 1, item.dia + 1)).toISOString().slice(0, 10).replace(/-/g, '');
        var mesObj = MESES[item.mes - 1] || MESES[0];
        var signo = resolverSigno(item.mes, item.dia);
        var rel = item.relacion ? ' (' + item.relacion + ')' : '';
        var esDuelo = item.tipo === 'duelo';
        var titulo = esDuelo ? 'En memoria de ' + item.nombre + rel : 'Cumpleaños de ' + item.nombre + rel;
        var detalles = esDuelo
          ? 'Fecha de recuerdo y homenaje en ParaCumpleanos.com. Palabras serenas en https://paracumpleanos.com/condolencias/'
          : 'Recordatorio anual de ParaCumpleanos.com (' + signo.nombre + ' ' + signo.simbolo + '). Ideas listas en https://paracumpleanos.com/' + mesObj.slug + '/ y https://paracumpleanos.com/horoscopo/' + signo.slug + '/';
        return (
          'https://calendar.google.com/calendar/render?action=TEMPLATE' +
          '&text=' + encodeURIComponent(titulo) +
          '&dates=' + dt + '/' + dtEnd +
          '&recur=' + encodeURIComponent('RRULE:FREQ=YEARLY') +
          '&details=' + encodeURIComponent(detalles)
        );
      }

      function descargarArchivoIcs(contenido, nombreArchivo, avisoToast) {
        var blob = new Blob([contenido], { type: 'text/calendar;charset=utf-8' });
        var urlBlob = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = urlBlob;
        a.download = nombreArchivo;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(urlBlob); }, 1000);
        if (window.pcMostrarToast && avisoToast) {
          window.pcMostrarToast(avisoToast);
        }
      }

      function renderAgenda() {
        if (!ulAg) return;
        var lista = cargarAgenda();
        lista.sort(function (a, b) {
          return diasHasta(a.mes, a.dia) - diasHasta(b.mes, b.dia);
        });
        ulAg.innerHTML = '';
        if (vacioAg) vacioAg.hidden = lista.length > 0;
        if (barraAg) barraAg.hidden = lista.length === 0;

        lista.forEach(function (item) {
          var mesObj = MESES[item.mes - 1] || MESES[0];
          var signo = resolverSigno(item.mes, item.dia);
          var falta = diasHasta(item.mes, item.dia);
          var esDuelo = item.tipo === 'duelo';
          var li = document.createElement('li');
          li.className = 'herr-agenda-item' + (esDuelo ? ' herr-agenda-item--duelo' : '');

          var info = document.createElement('div');
          info.className = 'herr-agenda-info';

          var nom = document.createElement('span');
          nom.className = 'herr-agenda-nombre';
          nom.textContent = (esDuelo ? '🕊️ En memoria de ' : '🎂 ') + item.nombre + (item.relacion ? ' (' + item.relacion + ')' : '');

          var meta = document.createElement('span');
          meta.className = 'herr-agenda-meta';
          if (esDuelo) {
            meta.innerHTML =
              item.dia + ' de ' + mesObj.nombreCap + ' · ' +
              (falta === 0 ? 'Hoy es esta fecha de recuerdo' : 'En ' + falta + ' días') +
              ' · <a href="/condolencias/">Condolencias y palabras de recuerdo</a>' +
              ' · <a href="/calendario/?mes=' + item.mes + '&dia=' + item.dia + '">Ver en calendario</a>';
          } else {
            meta.innerHTML =
              item.dia + ' de ' + mesObj.nombreCap + ' · ' +
              (falta === 0 ? '¡Hoy cumple años! 🎉' : 'Faltan ' + falta + ' días') +
              ' · <a href="/horoscopo/' + signo.slug + '/">' + signo.simbolo + ' ' + signo.nombre + '</a>' +
              ' · <a href="/' + mesObj.slug + '/">Frases de ' + mesObj.nombreCap + '</a>';
          }

          info.appendChild(nom);
          info.appendChild(meta);

          var acc = document.createElement('div');
          acc.className = 'herr-agenda-acciones';

          var btnGcal = document.createElement('a');
          btnGcal.className = 'btn btn-wa btn-sm';
          btnGcal.href = urlGoogleCalendarCli(item);
          btnGcal.target = '_blank';
          btnGcal.rel = 'noopener noreferrer';
          btnGcal.textContent = 'Google Calendar +';

          var btnIcs = document.createElement('button');
          btnIcs.type = 'button';
          btnIcs.className = 'btn btn-descargar btn-sm';
          btnIcs.textContent = 'Descargar .ics';
          btnIcs.addEventListener('click', function () {
            var icsText = generarContenidoIcs(item);
            var slugNombre = item.nombre.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'persona';
            descargarArchivoIcs(
              icsText,
              (esDuelo ? 'memoria-' : 'cumple-') + slugNombre + '.ics',
              '✓ Archivo .ics descargado: abrilo para agendar el aviso anual.'
            );
          });

          var btnDel = document.createElement('button');
          btnDel.type = 'button';
          btnDel.className = 'pers-limpiar btn-sm';
          btnDel.textContent = 'Quitar';
          btnDel.addEventListener('click', function () {
            var nueva = cargarAgenda().filter(function (x) { return x.id !== item.id; });
            guardarAgenda(nueva);
            renderAgenda();
          });

          acc.appendChild(btnGcal);
          acc.appendChild(btnIcs);
          acc.appendChild(btnDel);

          li.appendChild(info);
          li.appendChild(acc);
          ulAg.appendChild(li);
        });
      }

      if (btnExpTodo) {
        btnExpTodo.addEventListener('click', function () {
          var lista = cargarAgenda();
          if (!lista.length) return;
          descargarArchivoIcs(
            generarIcsAgendaCompleta(lista),
            'agenda-paracumpleanos.ics',
            '✓ Agenda completa (' + lista.length + ' fechas) descargada en un solo archivo .ics.'
          );
        });
      }

      if (btnVaciarAg) {
        btnVaciarAg.addEventListener('click', function () {
          guardarAgenda([]);
          renderAgenda();
          if (window.pcMostrarToast) {
            window.pcMostrarToast('Agenda local vaciada.');
          }
        });
      }

      if (formAg) {
        formAg.addEventListener('submit', function (ev) {
          ev.preventDefault();
          var tipoEl = document.getElementById('herr-ag-tipo');
          var tipo = (tipoEl && tipoEl.value) === 'duelo' ? 'duelo' : 'cumpleanos';
          var nomEl = document.getElementById('herr-ag-nombre');
          var nom = String((nomEl || {}).value || '').trim();
          var rel = String((document.getElementById('herr-ag-relacion') || {}).value || 'Familia');
          var mes = Number((document.getElementById('herr-ag-mes') || {}).value || '1');
          var dia = Number((document.getElementById('herr-ag-dia') || {}).value || '1');

          if (!nom) {
            if (errAg) {
              errAg.textContent = 'Ingresá un nombre (ej.: Mamá o Abuelo Carlos) antes de guardar.';
              errAg.hidden = false;
            }
            if (nomEl) nomEl.focus();
            return;
          }
          if (!Number.isInteger(mes) || mes < 1 || mes > 12 || !Number.isInteger(dia) || dia < 1 || dia > 31) {
            if (errAg) {
              errAg.textContent = 'Revisá el día (1 a 31) y el mes seleccionados.';
              errAg.hidden = false;
            }
            return;
          }
          if (errAg) {
            errAg.hidden = true;
            errAg.textContent = '';
          }

          var maxDiaMes = diasEnMes(2024, mes);
          if (dia > maxDiaMes) dia = maxDiaMes;

          var lista = cargarAgenda();
          lista.push({
            id: String(Date.now()) + '-' + Math.random().toString(36).slice(2, 6),
            tipo: tipo,
            nombre: nom,
            relacion: rel,
            mes: mes,
            dia: dia
          });
          guardarAgenda(lista);
          formAg.reset();
          var diaEl = document.getElementById('herr-ag-dia');
          if (diaEl) diaEl.value = '15';
          renderAgenda();
          if (window.pcMostrarToast) {
            window.pcMostrarToast(
              tipo === 'duelo'
                ? '✓ Fecha de recuerdo de ' + nom + ' guardada en tu agenda privada.'
                : '✓ Cumpleaños de ' + nom + ' guardado en tu agenda privada.'
            );
          }
        });
      }

      renderAgenda();
    })();
  </script>
