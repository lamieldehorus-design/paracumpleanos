---
// Botones de compartir: WhatsApp, Instagram, Facebook, copiar, descarga PNG e impresión postal opcional
interface Props {
  texto: string;
  url: string;
  tituloCard?: string;
  cuerpoCard?: string;
  emojiCard?: string;
  mostrarDescarga?: boolean;
}
const { texto, url, tituloCard = '', cuerpoCard = '', emojiCard = '🎂', mostrarDescarga = false } = Astro.props;
---
<div class="acciones">
  <a class="btn btn-wa" data-red="whatsapp" href={'https://wa.me/?text=' + encodeURIComponent(texto)} target="_blank" rel="noopener">WhatsApp</a>
  <button
    class="btn btn-ig"
    type="button"
    data-red="instagram"
    data-ig-title={tituloCard}
    data-ig-body={cuerpoCard}
    data-ig-emoji={emojiCard}
    data-ig-text={texto}
    data-ig-url={url}
  >
    Instagram
  </button>
  <a class="btn btn-fb" data-red="facebook" href={'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url)} target="_blank" rel="noopener">Facebook</a>
  <button class="btn btn-copiar" type="button" data-red="copiar" data-text={texto}>Copiar</button>
  {mostrarDescarga ? (
    <>
      <button
        class="btn btn-descargar"
        type="button"
        data-title={tituloCard}
        data-body={cuerpoCard}
        data-emoji={emojiCard}
      >
        Descargar tarjeta
      </button>
      <button class="btn btn-imprimir" type="button">
        Imprimir postal
      </button>
    </>
  ) : null}
</div>
<p class="acciones-stats" data-share-resumen hidden aria-live="polite"></p>
