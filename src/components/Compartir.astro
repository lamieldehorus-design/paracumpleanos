---
// Botones de compartir: WhatsApp, Facebook, copiar y descarga opcional de tarjeta PNG
interface Props {
  texto: string;
  url: string;
  tituloCard?: string;
  cuerpoCard?: string;
  emojiCard?: string;
  mostrarDescarga?: boolean;
}
const { texto, url, tituloCard = '', cuerpoCard = '', emojiCard = '🎂', mostrarDescarga = false } = Astro.props;
---
<div class="acciones">
  <a class="btn btn-wa" href={'https://wa.me/?text=' + encodeURIComponent(texto)} target="_blank" rel="noopener">WhatsApp</a>
  <a class="btn btn-fb" href={'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url)} target="_blank" rel="noopener">Facebook</a>
  <button class="btn btn-copiar" type="button" data-text={texto}>Copiar</button>
  {mostrarDescarga ? (
    <button
      class="btn btn-descargar"
      type="button"
      data-title={tituloCard}
      data-body={cuerpoCard}
      data-emoji={emojiCard}
    >
      Descargar tarjeta
    </button>
  ) : null}
</div>
