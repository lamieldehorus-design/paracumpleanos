---
import { mensajesDe, SITIO } from '../lib/contenido.ts';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const motivaciones = mensajesDe('motivaciones') || [];
const listaFrases = motivaciones.map(function (m) {
  const primerParrafo = String(m.texto || '').split(/\n{2,}/)[0] || m.texto || '';
  return {
    slug: m.slug,
    titulo: m.titulo,
    texto: primerParrafo
  };
});
const inicial = listaFrases[0] || {
  slug: 'motivaciones',
  titulo: 'Empezá hoy con una sola tarea importante',
  texto: 'Elegí una sola tarea que mueva tus proyectos hacia adelante y terminala con calma.'
};
---
<section
  class={'alerta-motivacion' + (compact ? ' alerta-motivacion-compact' : '')}
  aria-labelledby="titulo-motivacion-diaria"
  data-motivacion-widget="1"
>
  <div class="motiv-layout">
    <div class="motiv-frase-col">
      <p class="banda-kicker">✨ Motivación del día · Renovación diaria</p>
      <h2 id="titulo-motivacion-diaria">Tu dosis diaria de enfoque y calma</h2>
      <article class="motiv-frase-card" aria-live="polite">
        <p class="motiv-fecha-hoy" id="motiv-fecha-hoy">Frase destacada de hoy</p>
        <h3 id="motiv-frase-titulo">
          <a id="motiv-frase-link" href={`/${inicial.slug}/`}>{inicial.titulo}</a>
        </h3>
        <p id="motiv-frase-cuerpo">{inicial.texto}</p>
        <div class="motiv-frase-acciones">
          <button
            type="button"
            class="btn btn-copiar btn-sm"
            id="motiv-btn-copiar"
            data-text={inicial.texto}
          >
            Copiar frase
          </button>
          <button
            type="button"
            class="btn btn-ig btn-sm"
            id="motiv-btn-ig"
            data-ig-title={inicial.titulo}
            data-ig-body={inicial.texto}
            data-ig-emoji="✨"
            data-ig-text={inicial.texto}
            data-ig-url={`${SITIO}/${inicial.slug}/`}
          >
            Instagram
          </button>
          <a class="enlace-directorio" href="/motivaciones/">Ver las {motivaciones.length} motivaciones →</a>
        </div>
      </article>
    </div>

    <div class="motiv-suscripcion-col">
      <h3>Activá tu recordatorio motivacional cada mañana</h3>
      <p class="motiv-sub">
        La frase del portal cambia sola todos los días. Como este sitio es 100% estático (sin servidor de correos), <strong>no enviamos emails automáticos</strong>: la alarma real se configura en 1 clic en tu calendario (.ics) o en tu navegador al visitarnos.
      </p>

      <form class="motiv-form" id="motiv-form" novalidate>
        <div class="motiv-form-fila">
          <div class="motiv-campo motiv-campo-hora">
            <label for="motiv-hora">Horario preferido de alarma</label>
            <select id="motiv-hora">
              <option value="07:30">07:30 hs</option>
              <option value="08:30" selected>08:30 hs</option>
              <option value="12:00">12:00 hs</option>
              <option value="19:00">19:00 hs</option>
            </select>
          </div>
          <div class="motiv-campo">
            <label for="motiv-nota">Intención o recordatorio personal (opcional)</label>
            <input
              id="motiv-nota"
              type="text"
              maxlength="80"
              placeholder="Ej.: Arrancar el día con foco y calma"
              autocomplete="off"
            />
          </div>
        </div>

        <label class="motiv-check-push">
          <input type="checkbox" id="motiv-check-push" checked />
          <span>Mostrar aviso visual en este navegador cuando abras el sitio cada día</span>
        </label>

        <div class="motiv-botones">
          <button type="button" class="btn btn-copiar" id="motiv-ics">Descargar alarma diaria (.ics)</button>
          <button type="submit" class="btn btn-descargar" id="motiv-submit">Guardar aviso en navegador</button>
          <button type="button" class="pers-limpiar" id="motiv-probar">Probar alerta hoy</button>
          <button type="button" class="pers-limpiar" id="motiv-pausar" hidden>Desactivar</button>
        </div>
      </form>

      <p class="motiv-nota-aclaracion">
        ¿Qué hace el archivo <strong>.ics</strong>? Lo abrís una sola vez en Google Calendar, Apple o Outlook y agenda un aviso diario recurrente sin pedir contraseñas ni depender de emails.
      </p>

      <div class="motiv-estado" id="motiv-estado" role="status" aria-live="polite"></div>
    </div>
  </div>

  <script id="motiv-frases-json" type="application/json" set:html={JSON.stringify(listaFrases)} />
</section>

<script is:inline>
  (function () {
    var dataEl = document.getElementById('motiv-frases-json');
    var frases = [];
    try {
      frases = JSON.parse((dataEl && dataEl.textContent) || '[]');
    } catch (_) {}
    if (!frases.length) return;

    var ahora = new Date();
    var inicioAnio = new Date(ahora.getFullYear(), 0, 0);
    var diaAnio = Math.floor((ahora - inicioAnio) / 86400000);
    var fraseHoy = frases[diaAnio % frases.length];
    var fechaStr = ahora.toLocaleDateString('es-AR', { day: 'numeric', month: 'long' });

    var elFecha = document.getElementById('motiv-fecha-hoy');
    var elTit = document.getElementById('motiv-frase-link');
    var elCue = document.getElementById('motiv-frase-cuerpo');
    var btnCop = document.getElementById('motiv-btn-copiar');
    var btnIg = document.getElementById('motiv-btn-ig');

    if (elFecha) elFecha.textContent = 'Frase del día · ' + fechaStr;
    if (elTit) {
      elTit.textContent = fraseHoy.titulo;
      elTit.setAttribute('href', '/' + fraseHoy.slug + '/');
    }
    if (elCue) elCue.textContent = fraseHoy.texto;
    if (btnCop) btnCop.setAttribute('data-text', fraseHoy.texto);
    if (btnIg) {
      btnIg.setAttribute('data-ig-title', fraseHoy.titulo);
      btnIg.setAttribute('data-ig-body', fraseHoy.texto);
      btnIg.setAttribute('data-ig-text', fraseHoy.texto);
      btnIg.setAttribute('data-ig-url', 'https://paracumpleanos.com/' + fraseHoy.slug + '/');
    }

    var STORAGE_KEY = 'pc_motivacion_diaria';
    var form = document.getElementById('motiv-form');
    var inputNota = document.getElementById('motiv-nota');
    var selectHora = document.getElementById('motiv-hora');
    var checkPush = document.getElementById('motiv-check-push');
    var btnSubmit = document.getElementById('motiv-submit');
    var btnIcs = document.getElementById('motiv-ics');
    var btnProbar = document.getElementById('motiv-probar');
    var btnPausar = document.getElementById('motiv-pausar');
    var estado = document.getElementById('motiv-estado');
    if (!form || !selectHora) return;

    function leerEstado() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch (_) { return null; }
    }
    function guardarEstado(obj) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(obj)); } catch (_) {}
    }

    function mostrarMensajeEstado(msg, tipo) {
      if (!estado) return;
      estado.className = 'motiv-estado' + (tipo ? ' ' + tipo : '');
      estado.textContent = msg;
    }

    function descargarIcs(horaStr, notaPersonal) {
      var parts = String(horaStr || '08:30').split(':');
      var hh = String(parts[0] || '08').padStart(2, '0');
      var mm = String(parts[1] || '30').padStart(2, '0');
      var d = new Date();
      var stamp =
        d.getFullYear().toString() +
        String(d.getMonth() + 1).padStart(2, '0') +
        String(d.getDate()).padStart(2, '0');
      var notaExtra = notaPersonal ? (' — ' + notaPersonal) : '';
      var ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//ParaCumpleanos//MotivacionDiaria//ES',
        'CALSCALE:GREGORIAN',
        'BEGIN:VEVENT',
        'UID:motivacion-diaria-' + stamp + '@paracumpleanos.com',
        'DTSTAMP:' + stamp + 'T' + hh + mm + '00Z',
        'DTSTART:' + stamp + 'T' + hh + mm + '00',
        'DURATION:PT5M',
        'RRULE:FREQ=DAILY',
        'SUMMARY:✨ Motivación diaria ParaCumpleanos' + notaExtra,
        'DESCRIPTION:Abrí tu frase motivacional nueva de hoy en https://paracumpleanos.com/motivaciones/',
        'URL:https://paracumpleanos.com/motivaciones/',
        'BEGIN:VALARM',
        'TRIGGER:PT0M',
        'ACTION:DISPLAY',
        'DESCRIPTION:Leé tu motivación diaria en paracumpleanos.com',
        'END:VALARM',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'motivacion-diaria-paracumpleanos.ics';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }

    function dispararNotificacion(subtitulo) {
      if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
        try {
          new Notification('✨ ' + fraseHoy.titulo, {
            body: fraseHoy.texto,
            icon: '/logopc.png'
          });
          return true;
        } catch (_) {}
      }
      if (window.pcMostrarToast) {
        window.pcMostrarToast((subtitulo || 'Motivación del día') + ': ' + fraseHoy.texto.slice(0, 95) + '…');
      }
      return false;
    }

    function pintarUI(conf) {
      var activa = Boolean(conf && conf.activo);
      if (conf && conf.nota && inputNota) inputNota.value = conf.nota;
      if (conf && conf.hora) selectHora.value = conf.hora;
      if (checkPush && conf && typeof conf.push === 'boolean') checkPush.checked = conf.push;

      if (btnSubmit) btnSubmit.textContent = activa ? 'Actualizar en navegador' : 'Guardar aviso en navegador';
      if (btnPausar) btnPausar.hidden = !activa;

      if (activa) {
        mostrarMensajeEstado(
          '✓ Aviso local guardado en este navegador (' + conf.hora + ' hs). Para alarma puntual en el celular aunque cierres la pestaña, usá "Descargar alarma diaria (.ics)".',
          'ok'
        );
      }
    }

    var actual = leerEstado();
    if (actual) pintarUI(actual);

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var nota = String(inputNota ? inputNota.value : '').trim();
      var hora = selectHora.value || '08:30';
      var quierePush = Boolean(checkPush && checkPush.checked);

      function finalizar(perm) {
        var nuevo = {
          nota: nota,
          hora: hora,
          push: quierePush && perm === 'granted',
          activo: true,
          actualizado: new Date().toISOString().slice(0, 10)
        };
        guardarEstado(nuevo);
        pintarUI(nuevo);
        dispararNotificacion('Recordatorio activado');
      }

      if (quierePush && typeof Notification !== 'undefined' && Notification.permission === 'default') {
        Notification.requestPermission().then(finalizar, function () { finalizar('denied'); });
      } else {
        finalizar(typeof Notification !== 'undefined' ? Notification.permission : 'denied');
      }
    });

    if (btnIcs) {
      btnIcs.addEventListener('click', function () {
        var nota = String(inputNota ? inputNota.value : '').trim();
        descargarIcs(selectHora.value || '08:30', nota);
        mostrarMensajeEstado('✓ Archivo motivacion-diaria-paracumpleanos.ics descargado. Abrilo para agendar el aviso diario en Google Calendar, Apple o Outlook.', 'ok');
      });
    }

    if (btnProbar) {
      btnProbar.addEventListener('click', function () {
        if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
          Notification.requestPermission().then(function () {
            dispararNotificacion('Frase de hoy');
          });
        } else {
          dispararNotificacion('Frase de hoy');
        }
      });
    }

    if (btnPausar) {
      btnPausar.addEventListener('click', function () {
        try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
        if (inputNota) inputNota.value = '';
        pintarUI(null);
        mostrarMensajeEstado('Aviso local desactivado en este navegador.', '');
      });
    }
  })();
</script>
