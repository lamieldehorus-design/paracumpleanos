---
import { catalogo, nombreHub } from '../lib/contenido.ts';
import { enlacesHermanasInteligentes } from '../lib/gsc-estrategia.ts';
interface Props { hub: any; }
const lista = enlacesHermanasInteligentes(Astro.props.hub, catalogo, 8);
---
<section class="hermanas" aria-labelledby="hermanas-titulo">
  <h2 id="hermanas-titulo">Otras categorías relacionadas que te pueden interesar</h2>
  <div class="chips">
    {lista.map(function (h) { return <a class="chip" href={'/' + h.slug + '/'}>{h.emoji} {nombreHub(h)}</a>; })}
  </div>
</section>
