---
import Compartir from './Compartir.astro';
import { SITIO, hubDe, nombreHub } from '../lib/contenido.ts';
import { clasificarMensaje } from '../lib/editorial.ts';
interface Props {
  m: any;
  hub?: any;
  mostrarCategoria?: boolean;
  scoreBase?: number;
}
const { m, hub, mostrarCategoria = false, scoreBase } = Astro.props;
const hubRef = hub || hubDe(m);
const clasif = clasificarMensaje(m, hubRef);
const bloques = (m.texto || '').split('\n\n').map((b: string) => b.trim()).filter(Boolean);
const bloquePrincipal = bloques.find((b: string) => !(b.length < 55 && /[:,]$/.test(b))) || bloques[0] || '';
const plano = bloquePrincipal.replace(/\s*\n\s*/g, ' ').replace(/\s+/g, ' ').trim();
const resumen = plano.length <= 130 ? plano : plano.slice(0, 130).replace(/\s+\S*$/, '') + '…';
const esBanderinGuia = hubRef?.slug === 'banderines-de-cumpleanos-para-imprimir';
---
<article
  class="card"
  data-card-personalizable={esBanderinGuia ? undefined : '1'}
  data-slug={m.slug}
  data-tono={clasif.claseTono}
  data-segmentos={clasif.segmentos.join(',')}
  data-palabras={clasif.palabras}
  data-score-base={typeof scoreBase === 'number' ? String(scoreBase) : undefined}
  data-orig-titulo={m.titulo}
  data-orig-texto={m.texto}
  data-orig-resumen={resumen}
>
  {mostrarCategoria && hubRef ? (
    <p class="card-cat-row">
      <a class="card-cat-link" href={'/' + hubRef.slug + '/'}>
        {hubRef.emoji || '🎂'} {nombreHub(hubRef)}
      </a>
    </p>
  ) : null}
  <p class="card-meta">
    <span>{esBanderinGuia ? 'Guía práctica' : clasif.tonoLabel}</span>
    <span aria-hidden="true">·</span>
    <span>{esBanderinGuia ? 'Banderines A4' : clasif.canalLabel}</span>
    <span aria-hidden="true">·</span>
    <span>{clasif.palabras} palabras</span>
  </p>
  <h3><a href={'/' + m.slug + '/'}>{m.titulo}</a></h3>
  <p class="card-resumen">{resumen}</p>
  {!esBanderinGuia ? (
    <>
      <div class="card-texto-completo" hidden>
        {bloques.map(function (b: string) {
          const lineas = b.split('\n');
          return (
            <p>
              {lineas.map(function (linea: string, idx: number) {
                return idx === 0 ? linea : <><br />{linea}</>;
              })}
            </p>
          );
        })}
      </div>
      <div class="card-expand-row">
        <div class="card-expand-izq">
          <button
            type="button"
            class="btn-leer-mas"
            aria-expanded="false"
            aria-label={'Leer completo: ' + m.titulo}
          >
            Leer completo ▾
          </button>
          <button
            type="button"
            class="btn-favorita"
            aria-pressed="false"
            data-fav-slug={m.slug}
            data-fav-titulo={m.titulo}
            data-fav-emoji={hubRef?.emoji || '🎂'}
            aria-label={'Guardar en favoritas: ' + m.titulo}
          >
            ♡ Guardar
          </button>
        </div>
        <a class="card-cta-tarjeta" href={'/' + m.slug + '/'}>Tarjeta PNG / Story →</a>
      </div>
    </>
  ) : null}
  {esBanderinGuia ? (
    <p class="card-guia-leer">
      <a class="btn btn-copiar" href={'/' + m.slug + '/'}>Leer guía completa →</a>
    </p>
  ) : (
    <Compartir
      texto={m.texto}
      url={SITIO + '/' + m.slug + '/'}
      tituloCard={m.titulo}
      cuerpoCard={m.texto}
      emojiCard={hubRef.emoji || '🎂'}
    />
  )}
</article>
